per_frame_init_1=q1 = 0;
per_frame_init_2=b = 0;
per_frame_init_3=a = 0;
per_frame_init_4=madbass = 0;
per_frame_init_5=bass_effect = 0;
per_frame_1=wave_mystery=(-0.4+(0.1*sin(treb)));
per_frame_2=wave_x=(0.3+(0.2*mid));
per_frame_3=wave_y=(0.3+(0.2*bass));
per_frame_4=wave_r=bass;
per_frame_5=wave_g=mid;
per_frame_6=wave_b=treb;
per_frame_7=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_8=zoom=((zoom-(1.4*madbass))+0.02);
per_frame_9=ib_a=(if(abs(above(bass, 1.2))>0.00001,0.7,0));
per_frame_10=ob_r=(if(abs(above(treb, 1.2))>0.00001,0.3,0.1));
per_frame_11=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_12=q1=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_pixel_1=rot=(if(abs(below(rad, q1))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_2=zoom=(if(abs(below(rad, q1))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
per_pixel_3=dy=(time+rot);
per_pixel_4=cx=(ang-b);
per_pixel_5=cy=(q1-rad);
per_pixel_6=rot=(zoom*rot);
per_pixel_7=dy=(dy*time);
per_pixel_8=warp=(sy*bass_att);
per_pixel_9=cy=(cy+sx);
per_pixel_10=dx=(a+x);
per_pixel_11=zoom=(warp*ang);
per_pixel_12=zoomexp=(bass_att*bass_att);
per_pixel_13=sx=(b*sx);
per_pixel_14=cx=(cx*time);
per_pixel_15=zoom=(if(abs(below(zoom, 0.01))>0.00001,0.01,zoom));
per_pixel_16=zoom=(if(abs(above(zoom, 100))>0.00001,100,zoom));
per_pixel_17=zoomexp=(if(abs(below(zoomexp, 0.01))>0.00001,0.01,zoomexp));
per_pixel_18=zoomexp=(if(abs(above(zoomexp, 100.0))>0.00001,100.0,zoomexp));
per_pixel_19=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_20=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_21=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_pixel_22=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_pixel_23=cx=(if(abs(below(cx, -1.0))>0.00001,-1.0,cx));
per_pixel_24=cx=(if(abs(above(cx, 2.0))>0.00001,2.0,cx));
per_pixel_25=cy=(if(abs(below(cy, -1.0))>0.00001,-1.0,cy));
per_pixel_26=cy=(if(abs(above(cy, 2.0))>0.00001,2.0,cy));
per_pixel_27=dx=(if(abs(below(dx, -1))>0.00001,-1,dx));
per_pixel_28=dx=(if(abs(above(dx, 1.0))>0.00001,1.0,dx));
per_pixel_29=dy=(if(abs(below(dy, -1))>0.00001,-1,dy));
per_pixel_30=dy=(if(abs(above(dy, 1.0))>0.00001,1.0,dy));
per_pixel_31=sx=(if(abs(below(sx, 0.01))>0.00001,0.01,sx));
per_pixel_32=sx=(if(abs(above(sx, 100.0))>0.00001,100.0,sx));
