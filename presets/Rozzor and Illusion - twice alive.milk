per_frame_init_1=long_beat = 0;
per_frame_init_2=vol_now = 0;
per_frame_init_3=mysign = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=beat_max = 0;
per_frame_init_6=long_beatx = 0;
per_frame_init_7=mid_residual = 0;
per_frame_init_8=beat_min = 0;
per_frame_init_9=beat_rate = 0;
per_frame_init_10=myframe = 0;
per_frame_init_11=myendframe = 0;
per_frame_init_12=beat = 0;
per_frame_init_13=last_beat_rate = 0;
per_frame_init_14=q3 = 0;
per_frame_1=dx=(dx-0.001);
per_frame_2=dy=(dy-0.001);
per_frame_3=warp=0;
per_frame_4=vol_now=(0.22*((bass+mid)+treb));
per_frame_5=beat_max=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,max(beat_max, vol_now)));
per_frame_6=beat_min=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,min(beat_min, vol_now)));
per_frame_7=beat_rate=(if(abs(equal(((frame)%(50)), 0))>0.00001,0,(beat_rate+beat)));
per_frame_8=last_beat_rate=(if(abs(equal(((frame)%(50)), 49))>0.00001,(if(abs(above(beat_rate, 10))>0.00001,(if(abs(below(beat_rate, 30))>0.00001,beat_rate,last_beat_rate)),last_beat_rate)),last_beat_rate));
per_frame_9=last_beat_rate=max(last_beat_rate, (10*beat_min));
per_frame_10=beat=(if(abs(above(vol_now, ((0.035*last_beat_rate)*(beat_max-beat_min))))>0.00001,1,0));
per_frame_11=q3=sin((beat_max-vol_now));
per_frame_12=mysign=(if(abs(above(q3, 0.1))>0.00001,1,-1));
per_frame_13=myframe=(if(abs(above(0.2, q3))>0.00001,frame,0));
per_frame_14=myframe=(if(abs(above(myendframe, frame))>0.00001,0,myframe));
per_frame_15=myendframe=(if(abs(above(0.2, q3))>0.00001,(myframe+100),myendframe));
per_frame_16=long_beatx=(if(abs(above(frame, myframe))>0.00001,(if(abs(below(frame, myendframe))>0.00001,1,0)),0));
per_frame_17=long_beat=((mysign*10)*sin((myendframe-myframe)));
per_frame_18=q1=(if(abs(equal(long_beat, 0))>0.00001,(long_beat+1.57),long_beat));
per_frame_19=wave_r=(wave_r+(0.5*sin((1.047*q1))));
per_frame_20=wave_g=(wave_g-(0.5*cos((0.835*q1))));
per_frame_21=wave_b=(wave_b+(0.5*cos((1.011*q1))));
per_frame_22=ib_r=wave_g;
per_frame_23=ib_g=wave_b;
per_frame_24=ib_b=wave_r;
per_frame_25=rot=(rot+(0.030*((0.60*sin((0.381*q1)))+(0.40*sin((0.479*q1))))));
per_frame_26=cx=(cx+(0.110*((0.60*sin((0.374*q1)))+(0.40*sin((0.294*q1))))));
per_frame_27=cy=(cy+(0.110*((0.60*sin((0.393*q1)))+(0.40*sin((0.223*q1))))));
per_frame_28=mv_a=mid_residual;
per_frame_29=mv_x=int(rand(30));
per_frame_30=mv_y=int(rand(30));
per_frame_31=mv_r=wave_b;
per_frame_32=mv_b=wave_g;
per_frame_33=mv_g=wave_r;
per_pixel_1=dx=(0.01*atan((floor((rad)/(0.1))*sin((((x*y)*20)+(time*5))))));
per_pixel_2=zoom=(zoom+(rad*0.05));
