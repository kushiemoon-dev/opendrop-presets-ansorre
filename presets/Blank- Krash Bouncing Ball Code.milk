per_frame_4=x_speed=(((x_speed*(if(abs(equal(bounce, 0))>0.00001,1,x_speed_loss)))*(if(abs(above(wave_x_mod, (right_extreme-0.5)))>0.00001,x_speed_loss,(if(abs(below(wave_x_mod, (left_extreme-0.5)))>0.00001,x_speed_loss,1)))))*(if(abs(equal(y_speed, 0))>0.00001,x_speed_loss,1)));
