[preset00]
bDarkenCenter=1.0
fWaveScale=8.926907
ib_a=0.09
ib_g=0.0
ib_r=0.2
mv_a=0.0
nWaveMode=2.0
ob_a=1.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
fWaveParam=-0.28
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=crad = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=q2 = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=((wave_r+(0.29*sin((time*0.555))))+bass_att);
per_frame_3=wave_g=((wave_g+(0.29*sin((time*0.555))))+treb_att);
per_frame_4=wave_b=((wave_b+(0.29*sin((time*0.555))))+mid_att);
per_frame_5=q1=0.5;
per_frame_6=q2=0.5;
per_frame_7=q1=(q1+(0.3*sin((time*0.666))));
per_frame_8=q2=(q2+(0.3*sin((time*0.444))));
per_pixel_1=crad=((abs(((x*q1)*(y*q2)))*10)+(bass_att*0.1));
per_pixel_2=dx=(if(abs(above(x, q1))>0.00001,(floor((dx)/((crad-q1)))*0.1),((dx+(crad*q1))*0.07)));
per_pixel_3=dy=(if(abs(above(y, q2))>0.00001,(floor((dy)/((crad-q2)))*0.1),((dy+(crad*q2))*0.07)));
