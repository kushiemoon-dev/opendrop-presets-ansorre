per_frame_init_10=beat = 0;
per_frame_1=warp=0;
per_frame_2=volume=(0.3*((bass+mid)+att));
per_frame_3=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_4=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_5=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_6=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_7=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_8=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_9=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_10=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_11=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_12=monitor=beateven;
per_frame_13=ib_a=beat;
per_frame_14=beatcounter=(if(abs(above(progress, 0.01))>0.00001,(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter)),0));
per_frame_15=beatcounter=(if(abs(above(beatcounter, 101))>0.00001,0,beatcounter));
per_frame_16=wave_x=(0.01*beatcounter);
per_frame_17=wave_r=(0.5+(0.5*sin(beatcounter)));
per_frame_18=beateven=((beatcounter)%(2));
per_frame_19=zoom=(if(abs(above(beateven, 0))>0.00001,1.01,0.99));
per_pixel_1=rot=tan(x);
