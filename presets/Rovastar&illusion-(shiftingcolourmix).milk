per_pixel_2=rot=(0.3*(if(abs(above(rad, 0.4))>0.00001,(floor((cos(((rad*2)*rad)))/(25))+floor((sin(pow(rad, 5)))/(25))),(floor((cos((1-rad)))/(25))+floor((sin(rad))/(25))))));
