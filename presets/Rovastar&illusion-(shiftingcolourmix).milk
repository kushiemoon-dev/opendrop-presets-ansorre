per_frame_1=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_2=wave_r=(wave_r+(if(abs(above(bass_effect, 0))>0.00001,(0.50*sin((0.147*time))),(-0.50*sin((0.147*time))))));
