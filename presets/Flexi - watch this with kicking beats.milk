per_pixel_1=r=floor((bass)/(4));
per_pixel_2=cx1=(0.5+(sin((time*0.618))*0.2));
per_pixel_3=cy1=(0.5+(cos((time*1.618))*0.2));
per_pixel_4=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_5=dir=((bass*((r*r)-(d*d)))*0.3);
per_pixel_6=x1=(if(abs(above(d, r))>0.00001,0,(sin((y-cy1))*dir)));
per_pixel_7=y1=(if(abs(above(d, r))>0.00001,0,(-sin((x-cx1))*dir)));
per_pixel_8=cx1=(0.5+(sin((time*2.618))*0.3));
per_pixel_9=cy1=(0.5+(cos((time*3.14))*0.3));
per_pixel_10=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_11=dir=((-mid*((r*r)-(d*d)))*0.3);
per_pixel_12=x2=(if(abs(above(d, r))>0.00001,0,(sin((y-cy1))*dir)));
per_pixel_13=y2=(if(abs(above(d, r))>0.00001,0,(-sin((x-cx1))*dir)));
per_pixel_14=cx1=(0.5+(sin((-time*2.618))*0.4));
per_pixel_15=cy1=(0.5+(cos((-time*1.14))*0.4));
per_pixel_16=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_17=dir=((-treb*((r*r)-(d*d)))*0.3);
per_pixel_18=x3=(if(abs(above(d, r))>0.00001,0,(sin((y-cy1))*dir)));
per_pixel_19=y3=(if(abs(above(d, r))>0.00001,0,(-sin((x-cx1))*dir)));
per_pixel_20=dx=((x1+x2)+x3);
per_pixel_21=dy=((y1+y2)+y3);
