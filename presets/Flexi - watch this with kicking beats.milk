per_frame_1=ib_r=((sin(((time*1.25)*4))*0.3)+0.7);
per_frame_2=ib_g=((sin((time*4))*0.3)+0.3);
per_frame_3=ib_b=((sin((floor((time)/(3))*4))*0.5)+0.5);
per_frame_4=wave_r=(1-ib_r);
per_frame_5=wave_g=(1-ib_g);
per_frame_6=wave_b=(1-ib_b);
