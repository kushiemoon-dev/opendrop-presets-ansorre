per_frame_5=beatb=((rawbeatb*above((time-lbbtime), (0.75*avgbeatrate)))*above(bass_att, 0.3));
per_frame_6=bbtime=(time*beatb);
per_frame_7=beatrate=((beatb*(bbtime-lbbtime))+((1-beatb)*beatrate));
per_frame_8=avgbeatrate=((beatb*((avgbeatrate*0.999)+(beatrate*0.001)))+((1-beatb)*avgbeatrate));
per_frame_9=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_10=bc=(bc+beatb);
per_frame_11=vol=((rawbeatb*(db-avgdb))*0.01);
per_frame_12=avgvol=((avgvol*0.99)+(vol*0.05));
per_frame_13=mtime=(mtime+min((avgvol*0.5), 0.25));
