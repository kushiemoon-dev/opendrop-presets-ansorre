per_frame_init_2=vcheck = 0;
per_frame_1=wave_r=(max(0, min(0.5, (floor((bass_att)/(2))-0.3)))+floor(((sin((time*2.4))+1))/(4)));
per_frame_2=wave_g=(max(0, min(0.5, (floor((treb_att)/(2))-0.3)))+floor(((sin((time*1.9))+1))/(4)));
