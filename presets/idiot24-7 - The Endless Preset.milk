MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.925
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.26
mv_a=0.0
nWaveMode=7.0
ob_r=0.01
ob_size=0.5
rot=0.024
warp=0.01
zoom=1.050499
bAdditiveWaves=1.0
fVideoEchoZoom=1.006596
nVideoEchoOrientation=3.0
fWaveAlpha=4.099998
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=treb_effect = 0;
per_frame_init_3=mid_effect = 0;
per_frame_1=bass_effect=max(bass, bass_att);
per_frame_2=treb_effect=max(treb, treb_att);
per_frame_3=mid_effect=max(mid, mid_att);
per_frame_4=rot=(if(abs(above(bass_effect, mid_effect))>0.00001,rot,-rot));
per_frame_5=cx=((cx+(0.500*sin((time*0.42))))-(0.500*sin((time*0.12))));
per_frame_6=cy=((cy+(0.300*cos(time)))-(0.400*cos((time*0.45))));
per_frame_7=dx=(dx+(0.020*sin(time)));
per_frame_8=dy=(dy+(0.020*cos((time*0.42))));
per_frame_9=wave_x=(wave_x+(0.20*sin(time)));
per_frame_10=wave_y=(wave_y-(0.20*sin((time*0.24))));
per_frame_11=wave_mystery=(if(abs(above(bass_effect, treb_effect))>0.00001,1,(wave_mystery*sin(time))));
