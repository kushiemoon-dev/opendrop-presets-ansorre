per_frame_1=wave_r=(wave_r+(0.250*((0.60*sin((10.937*time)))+(0.40*sin((1.470*time))))));
per_frame_2=wave_g=(wave_g+(0.300*((0.60*sin((11.344*time)))+(0.40*sin((1.041*time))))));
