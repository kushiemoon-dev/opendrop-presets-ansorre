per_frame_1=db=((bass-lbass)*fps);
per_frame_2=lbass=bass;
per_frame_3=avgdb=((avgdb*0.99)+(abs(db)*0.01));
per_frame_4=rawbeatb=above(db, avgdb);
per_frame_5=beatb=(rawbeatb*above((time-lbbtime), (0.5*avgbeatrate)));
per_frame_6=bbtime=(time*beatb);
per_frame_7=beatrate=((beatb*(bbtime-lbbtime))+((1-beatb)*beatrate));
per_frame_8=avgbeatrate=((beatb*((avgbeatrate*0.999)+(beatrate*0.001)))+((1-beatb)*avgbeatrate));
per_frame_9=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_10=bc=(bc+beatb);
per_frame_11=rs=(bor(above(abs(db), (avgdb*100)), below(abs(db), (avgdb*0.01)))*rawbeatb);
per_frame_12=drs=(1-rs);
per_frame_13=avgbeatrate=((beatrate*rs)+(avgbeatrate*drs));
per_frame_14=beatrate=((4*rs)+(beatrate*drs));
per_frame_15=bbtime=((1*rs)+(bbtime*drs));
per_frame_16=lbbtime=((1*rs)+(lbbtime*drs));
per_frame_17=avgdb=((db*rs)+(avgdb*drs));
per_frame_18=bc=((bc*drs)+((bc-1)*rs));
per_frame_19=vol=((rawbeatb*(db-avgdb))*0.01);
per_frame_20=avgvol=((avgvol*0.99)+(vol*0.05));
per_frame_21=mtime=(mtime+min((avgvol*0.5), 0.25));
per_frame_22=q2=((sin(mtime)*0.5)+0.5);
per_frame_23=q1=beatb;
per_frame_24=q3=db;
per_frame_25=q4=avgbeatrate;
per_frame_26=q5=(equal(((bc)%(4)), 0)*beatb);
per_frame_27=q7=rs;
