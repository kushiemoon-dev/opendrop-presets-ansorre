per_pixel_3=api=((1-rad)*pi);
per_pixel_4=zoom=(if(abs(above(rad, 0.4))>0.00001,(1.01+floor((sin(rpi))/(10))),((0.95+floor((sin(rpi))/(10)))-floor((sin(api))/(10)))));
per_pixel_5=rot=(if(abs(above(rad, 0.4))>0.00001,(floor((cos(((rad*2)*rpi)))/(25))+floor((sin((pi*pow(rad, 5))))/(25))),(floor((cos(api))/(25))+floor((sin(rpi))/(25)))));
