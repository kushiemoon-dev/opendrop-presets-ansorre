MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.91
mv_a=0.0
ob_a=1.0
rot=-0.28
warp=0.011
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.99
fVideoEchoAlpha=1.0
fVideoEchoZoom=0.999837
fWaveAlpha=0.001
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=1.0
wavecode_0_smoothing=0.0
wave_0_init1=speed = 0;
wave_0_init2=v = 0;
wave_0_init3=xs = 0;
wave_0_init4=ys = 0;
wave_0_init5=q2 = 0;
wavecode_1_enabled=1.0
wavecode_1_smoothing=0.0
wave_1_init1=q1 = 0;
wave_1_init2=speed = 0;
wave_1_init3=v = 0;
wave_1_init4=xs = 0;
wave_1_init5=ys = 0;
wave_1_init6=q2 = 0;
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=stickybit = 0;
per_frame_init_2=zoom_init = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sample1 = 0;
per_frame_init_6=difftime = 0;
per_frame_init_7=diff = 0;
per_frame_init_8=edge = 0;
per_frame_init_9=volavg = 0;
per_frame_init_10=bit2 = 0;
per_frame_init_11=vol = 0;
per_frame_init_12=q2 = 0;
per_frame_init_13=basssum = 0;
per_frame_init_14=sample2 = 0;
per_frame_init_15=state=0;
per_frame_init_16=zoom_init=0.3;
per_frame_1=vol=pow(((bass+mid)+treb), 2);
per_frame_2=basssum=vol;
per_frame_3=stickybit=((time)%(2));
per_frame_4=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_5=sample1=(sample1+equal(stickybit, 1));
per_frame_6=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_7=sample2=(sample2+equal(stickybit, 0));
per_frame_8=edge=bnot(equal(bit2, stickybit));
per_frame_9=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_10=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_11=sample1=(sample1-((sample1*edge)*stickybit));
per_frame_12=sample2=(sample2-((sample2*edge)*equal(stickybit, 0)));
per_frame_13=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(floor((volavg2)/(sample2)))),0));
per_frame_14=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(floor((volavg)/(sample1)))),diff));
per_frame_15=diff=diff;
per_frame_16=bit2=((time)%(2));
per_frame_17=q1=diff;
per_frame_18=difftime=((difftime+(diff*0.03))+0.01);
per_frame_19=q2=difftime;
per_frame_20=difftime=(if(abs(above(difftime, 2000))>0.00001,0,difftime));
per_frame_21=monitor=q1;
per_frame_22=q2=difftime;
per_frame_23=monitor=diff;
per_frame_24=zoom_init=(if(abs(above(diff, 5))>0.00001,0.6,zoom_init));
per_frame_25=zoom_init=(zoom_init+(if(abs(below(zoom_init, 1))>0.00001,0.02,0)));
per_frame_26=echo_zoom=zoom_init;
per_pixel_1=zoom=0.8;
per_pixel_2=rot=(1+((0.5-rad)*0.1));
per_pixel_3=cx=(0.5+(0.1*sin((q2*1.1))));
per_pixel_4=cy=(0.5+(0.1*sin(q2)));
