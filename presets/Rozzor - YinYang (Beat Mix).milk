fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.26
mv_a=0.51
nWaveMode=1.0
ob_a=0.1
ob_size=0.1
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.999514
