per_frame_init_1=vol_now = 0;
per_frame_init_2=vol_mean = 0;
per_frame_init_3=beat = 0;
per_frame_init_4=mytime = 0;
per_frame_1=warp=0;
per_frame_2=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_3=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_4=beat=(if(abs(above(vol_now, vol_mean))>0.00001,1,0));
per_frame_5=mytime=(beat*time);
per_frame_6=ob_g=((mytime)%(2));
per_frame_7=ob_r=((mytime)%(3));
per_frame_8=ob_b=((mytime)%(4));
per_frame_9=mv_b=(sin(mytime)+abs(sin(mytime)));
per_frame_10=mv_r=cos(mytime);
per_frame_11=mv_g=((-0.8*sign(sin(mytime)))*abs(sin(mytime)));
per_frame_12=dx=(0.3*sin(time));
per_frame_13=dy=(0.3*cos((3*time)));
per_pixel_1=rot=(rot+(8*sin(rad)));
per_pixel_2=zoom=(zoom+(0.001*rad));
