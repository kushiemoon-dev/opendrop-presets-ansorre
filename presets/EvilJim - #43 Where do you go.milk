MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
fDecay=0.9
fGammaAdj=1.7
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWaveScale=0.500381
fWaveSmoothing=0.0
mv_a=0.0
nWaveMode=3.0
sy=0.990097
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
fVideoEchoZoom=0.999608
fWaveAlpha=0.999744
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_q1 = 0;
per_frame_init_2=abs_bass_q1 = 0;
per_frame_init_3=mid_q1 = 0;
per_frame_init_4=abs_mid_q1 = 0;
per_frame_1=wave_r=sin(bass);
per_frame_2=wave_g=cos(mid);
per_frame_3=wave_b=tan(treb);
per_frame_4=bass_q1=floor((bass_att)/(bass));
per_frame_5=abs_bass_q1=abs((1-bass_q1));
per_frame_6=dx=(if(abs(below(bass_q1, 1))>0.00001,(abs_bass_q1*-1),(abs_bass_q1*0.1)));
per_frame_7=mid_q1=floor((mid_att)/(mid));
per_frame_8=abs_mid_q1=abs((1-mid_q1));
per_frame_9=dy=(if(abs(above(mid_q1, 1))>0.00001,(abs_mid_q1*0.1),(abs_mid_q1*-1)));
