per_frame_1=ib_r=(0.5+(sin((time*4))*0.5));
per_frame_2=ib_g=(0.5+(sin((time*2))*0.5));
per_frame_3=ib_b=(0.5+(sin(time)*0.5));
per_frame_4=wave_r=(1-ib_r);
per_frame_5=wave_g=(1-ib_g);
per_frame_6=wave_b=(1-ib_b);
per_frame_7=anstieg=(bass-q1);
per_frame_8=q1=bass;
per_frame_9=darken=(if(abs(above(anstieg, 2))>0.00001,1,0));
per_pixel_1=n=17.3;
per_pixel_2=t=(time+bass);
per_pixel_3=dx=((0.02*(cos((((-x+y)*n)+t))+sin((((x+y)*n)+t))))*bass);
per_pixel_4=dy=((0.02*(cos((((x-y)*n)-t))+sin((((-x-y)*n)-t))))*bass);
