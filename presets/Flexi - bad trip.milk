per_pixel_1=n=(((30-(abs((y-0.5))*20))-(abs((x-0.5))*20))-(bass*2));
per_pixel_2=t=(time*2);
per_pixel_3=x=(x-0.04);
per_pixel_4=dx=(0.01*(cos((((-x+y)*n)+t))+sin(((((x+y)-1)*n)+t))));
per_pixel_5=dy=(0.01*(cos((((x-y)*n)-t))+sin(((((-x-y)+1)*n)-t))));
