per_frame_init_1=vol_now = 0;
per_frame_init_2=rotendframe = 0;
per_frame_init_3=rotframe = 0;
per_frame_init_4=beat_max = 0;
per_frame_init_5=new_beat = 0;
per_frame_init_6=beat_min = 0;
per_frame_init_7=beat_rate = 0;
per_frame_init_8=rot_count = 0;
per_frame_init_9=beat = 0;
per_frame_init_10=last_beat_rate = 0;
per_frame_init_11=q3 = 0;
per_frame_1=vol_now=(0.22*((bass+mid)+treb));
per_frame_2=beat_max=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,max(beat_max, vol_now)));
per_frame_3=beat_min=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,min(beat_min, vol_now)));
per_frame_4=beat_rate=(if(abs(equal(((frame)%(50)), 0))>0.00001,0,(beat_rate+beat)));
per_frame_5=last_beat_rate=(if(abs(equal(((frame)%(50)), 49))>0.00001,(if(abs(above(beat_rate, 10))>0.00001,(if(abs(below(beat_rate, 30))>0.00001,beat_rate,last_beat_rate)),last_beat_rate)),last_beat_rate));
per_frame_6=last_beat_rate=max(last_beat_rate, (10*beat_min));
per_frame_7=beat=(if(abs(above(vol_now, ((0.035*last_beat_rate)*(beat_max-beat_min))))>0.00001,1,0));
per_frame_8=q3=sin((beat_max-vol_now));
per_frame_9=new_beat=(if(abs(above(q3, 0.1))>0.00001,1,0));
per_frame_10=ob_a=(0.09+(0.07*beat));
per_frame_11=ob_size=(0.01+(0.009*beat));
per_frame_12=wave_r=(wave_r+(1.5*sin((beat_rate*1.13))));
per_frame_13=wave_b=(wave_b+(0.5*sin((beat_rate*1.23))));
per_frame_14=wave_g=(wave_g+(0.5*sin((beat_rate*1.33))));
per_frame_15=ob_b=(0.7*beat);
per_frame_16=rotframe=(if(abs(equal(1, new_beat))>0.00001,frame,0));
per_frame_17=rotframe=(if(abs(above(rotendframe, frame))>0.00001,0,rotframe));
per_frame_18=rotendframe=(if(abs(equal(1, new_beat))>0.00001,(rotframe+100),rotendframe));
per_frame_19=rot=(if(abs(above(frame, rotframe))>0.00001,(if(abs(below(frame, rotendframe))>0.00001,1,0)),0));
per_frame_20=rot_count=(rot_count+rot);
per_frame_21=warp=(if(abs(equal(((rot_count)%(7)), 0))>0.00001,(50*rot),0));
per_frame_22=mv_r=(mv_r+(0.3*sin(wave_r)));
per_frame_23=mv_b=(mv_r+(0.3*sin(wave_b)));
per_frame_24=mv_g=(mv_r+(0.3*sin(wave_g)));
per_pixel_1=zoom=(zoom+(sin(time)*0.1));
per_pixel_2=rot=(rot+((sin(x)*sin(y))*0.1));
