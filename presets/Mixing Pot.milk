per_frame_6=wave_g=(wave_g+(treb*0.3));
per_frame_7=wave_b=(wave_b+(mid*0.3));
per_frame_8=zoom=((zoom+0.01)+(0.1*sin(time)));
per_frame_9=zoom=(zoom-(bass*0.1));
per_frame_10=cx=(cx+(0.1*sin((time*0.111))));
per_frame_11=cy=(cy+(0.1*sin((time*0.222))));
per_pixel_1=zoom=(zoom+abs((x-0.5)));
per_pixel_2=zoom=(zoom+abs((x-0.5)));
per_pixel_3=rot=(0.2*sin(((rad*(2-(10*sin(time))))-(time*4))));
