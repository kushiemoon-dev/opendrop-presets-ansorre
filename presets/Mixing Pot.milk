bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=wave_r=(wave_r+(0.255*sin((time*0.366))));
per_frame_3=wave_g=(wave_g+(0.255*sin((time*0.222))));
per_frame_4=wave_b=(wave_b+(0.255*sin((time*0.288))));
