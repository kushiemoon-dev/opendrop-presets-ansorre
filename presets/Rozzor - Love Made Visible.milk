per_frame_5=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_6=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_7=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
