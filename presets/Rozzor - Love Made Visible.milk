per_frame_16=blueneg=(if(abs(below(mv_b, 0))>0.00001,1,0));
per_frame_17=wave_r=(if(abs(redneg)>0.00001,(if(abs(bor(greenneg, blueneg))>0.00001,1,(1+mv_r))),mv_r));
per_frame_18=wave_g=(if(abs(greenneg)>0.00001,(if(abs(equal((greenneg+blueneg), 2))>0.00001,1,(1+mv_g))),mv_g));
per_frame_19=wave_b=(if(abs(blueneg)>0.00001,(1+mv_b),mv_b));
per_frame_20=dx=((0.3*sin(time))+(0.1*q3));
per_frame_21=dy=(0.3*cos((time+(0.3*cos(slowtime)))));
