per_frame_init_1=vol_now = 0;
per_frame_init_2=vol_mean = 0;
per_frame_init_3=beat = 0;
per_frame_init_4=sinbeat = 0;
per_frame_init_5=basseffect = 0;
per_frame_init_6=beatcount = 0;
per_frame_init_7=initframe = 0;
per_frame_init_8=rozzorrate = 0;
per_frame_1=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_2=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_3=beat=(if(abs(above(vol_now, (1.15*vol_mean)))>0.00001,1,0));
per_frame_4=sinbeat=sin((beat*(vol_now-vol_mean)));
per_frame_5=warp=0;
per_frame_6=basseffect=max((max(bass, bass_att)-1), 0);
per_frame_7=mv_y=(4-min((((bass_att+bass)-2)*0.25), 0.9));
per_frame_8=mv_r=(basseffect*4);
per_frame_9=mv_b=(basseffect*3);
per_frame_10=mv_g=(basseffect*3.5);
per_frame_11=wave_y=(if(abs(beat)>0.00001,0.5,0.4));
per_frame_12=ib_a=sinbeat;
per_frame_13=beatcount=(beatcount+beat);
per_frame_14=initframe=(if(abs(below(beatcount, 1))>0.00001,frame,initframe));
per_frame_15=rozzorrate=floor(((frame-initframe))/(beatcount));
