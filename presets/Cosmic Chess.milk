MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarkenCenter=1.0
fWaveScale=0.224799
nWaveMode=4.0
ob_a=1.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
bMotionVectorsOn=0.0
fWaveParam=-0.28
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=centerx = 0;
per_frame_init_2=centery = 0;
per_frame_init_3=crad = 0;
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.001);
per_frame_3=dy=(dy-0.001);
per_frame_4=wave_r=(wave_r+(0.49*sin((time*2))));
per_frame_5=wave_g=(wave_g+(0.49*sin((time*3))));
per_frame_6=wave_b=(wave_b+(0.49*sin(time)));
per_pixel_1=centerx=0.5;
per_pixel_2=centery=0.5;
per_pixel_3=crad=-pow((y-0.5), 1);
per_pixel_4=dx=(if(abs(above(x, centerx))>0.00001,((dx-(crad-centerx))*0.1),((dx+(crad-centerx))*0.1)));
per_pixel_5=dy=(if(abs(above(y, centery))>0.00001,((dy-(crad-centery))*0.1),((dy+(crad-centery))*0.1)));
