per_frame_11=q5=(0.5+((0.05*sin((time*0.44)))*cos((time*0.71))));
per_pixel_1=zoom=((zoom+(0.015*rad))+((0.015*treb_att)*rad));
per_pixel_2=sy=(sy+(0.1*cos((sin(((y*0.05)+time))-((sin(((20*x)+time))*0.5)*treb_att)))));
per_pixel_3=sx=(sx+(0.1*sin((cos(((x*70)+time))+((cos(((y*20)+time))*0.5)*treb_att)))));
