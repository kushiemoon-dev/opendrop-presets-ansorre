per_frame_13=wave_y=(wave_y+min((ypos-0.4), 1));
per_frame_14=decay=min((decay+(0.02*floor((((treb+mid)+bass))/(3)))), 1);
per_frame_15=exzoom=(zoom+floor((((0.01*sin((time*3)))*treble))/(2)));
