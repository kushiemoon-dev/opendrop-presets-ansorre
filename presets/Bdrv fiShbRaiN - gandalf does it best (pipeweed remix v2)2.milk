per_pixel_12=seg=(seg-equal(seg, num));
per_pixel_13=anga=((ang+pi)-(floor(((pi*2))/(num))*seg));
per_pixel_14=anga=(if(abs(equal(((seg)%(2)), 0))>0.00001,(floor(((pi*2))/(num))-anga),anga));
per_pixel_15=anga=(anga+floor((pi)/(4)));
per_pixel_16=ox=(0.5-(radi*sin(anga)));
per_pixel_17=oy=(0.5+(radi*cos(anga)));
per_pixel_18=dx=(equal(seg, 3)*(x-ox));
per_pixel_19=dy=(equal(seg, 3)*(y-oy));
per_pixel_20=dx=(above(seg, 0)*(x-ox));
per_pixel_21=dy=(above(seg, 0)*(y-oy));
