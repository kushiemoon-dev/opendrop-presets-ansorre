per_pixel_1=zoom=(if(abs(above(rad, 0.6))>0.00001,(0.96+floor((sin(rad))/(10))),(if(abs(below(rad, 0.25))>0.00001,0.72,(if(abs(above(rad, 0.4))>0.00001,(1.06+floor((sin((1-(rad*rad))))/(10))),(0.95+floor((sin(rad))/(10)))))))));
per_pixel_2=rot=(if(abs(above(rad, 0.6))>0.00001,floor((sin((floor((time)/(5))+rad)))/(50)),(if(abs(below(rad, 0.25))>0.00001,floor((sin((rad-time)))/(10)),0))));
