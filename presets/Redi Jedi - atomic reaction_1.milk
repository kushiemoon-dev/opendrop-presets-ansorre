per_frame_1=const=(vol_att*0.5);
per_frame_2=beatb=above(bass, (bass_att*const));
per_frame_3=beatbhard=(if(abs(beatb)>0.00001,(bass-(bass_att*const)),beatbhard));
per_frame_4=beatm=above(mid, (mid_att*const));
per_frame_5=beatmhard=(if(abs(beatm)>0.00001,(mid-(mid_att*const)),beatmhard));
per_frame_6=beatt=above(treb, (treb_att*const));
per_frame_7=beatthard=(if(abs(beatt)>0.00001,(treb-(treb_at*const)),beatthard));
per_frame_8=vol=((bass+mid)+treb);
per_frame_9=vol_att=((bass_att+mid_att)+treb_att);
per_frame_10=q1=beatb;
per_frame_11=q2=beatbhard;
per_frame_12=q3=beatm;
per_frame_13=q4=beatmhard;
per_frame_14=q5=beatt;
per_frame_15=q6=beatthard;
per_frame_16=wrap=1;
per_frame_17=decay=(0.98+(q2*0.05));
per_pixel_1=dx1=((sin(time)*0.03)*q1);
per_pixel_2=dy1=((cos(time)*0.03)*q1);
per_pixel_3=bb=max((bass-treb), 0);
per_pixel_4=tt=max((treb-bass), 0);
per_pixel_5=dx2=((cos((time*bb))*0.03)*q3);
per_pixel_6=dy2=((sin((time*tt))*0.03)*q3);
per_pixel_7=dx=((dx1*q4)+(dx2*q2));
per_pixel_8=dy=((dy1*q4)+(dy2*q2));
