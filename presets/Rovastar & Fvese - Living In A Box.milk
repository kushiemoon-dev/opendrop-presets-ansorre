per_frame_init_8=red=(0.01*floor(int(rand(50))));
per_frame_init_9=blue=(0.01*floor(int(rand(50))));
per_frame_init_10=size=(0.002+(0.001*floor(int(rand(25)))));
per_frame_1=wave_r=(wave_r*sin((bass+mid)));
per_frame_2=wave_b=(wave_b-(0.4*sin((time*bass))));
per_frame_3=wave_g=(wave_g+(0.6*cos(((time*mid)-bass))));
per_frame_4=wave_mystery=(0.2*sin(time));
per_frame_5=wave_mode=(2-(1*sin((bass-1.5))));
per_frame_6=bass_eff=max((max(bass, bass_att)-1), 0);
per_frame_7=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_8=decay=(decay-(0.05*equal(((frame)%(16)), 0)));
per_frame_9=rot=((rot+floor((bass_eff)/(bass_thresh)))-0.05);
per_frame_10=monitor=rot;
per_frame_11=ob_size=(0.75+(0.25*bass_thresh));
per_frame_12=ib_g=(0.5+(green*sin(time)));
per_frame_13=ib_b=(0.5+(blue*sin(time)));
per_frame_14=ib_r=(0.5+(red*sin(time)));
per_frame_15=ib_size=size;
per_frame_16=monitor=size;
per_pixel_1=zoom=pow((((0.8+x))&((0.8+y))), pow(y, 5));
