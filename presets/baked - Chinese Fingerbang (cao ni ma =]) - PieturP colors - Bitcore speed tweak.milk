per_frame_1=wave_a=0;
per_frame_2=bos=bass;
per_frame_3=tos=treb;
per_frame_4=cy=(cx+(0.0045*floor((floor((cx)/(cx)))/(floor((bos)/(tos))))));
per_frame_5=cx=(cy+(0.005*floor((floor((cy)/(cy)))/(floor((bos)/(tos))))));
per_frame_6=rot=(time*0.18);
per_frame_7=dx=sin((time*0.2));
per_frame_8=dy=((bass*0.0009)+(sin((time*0.18))*2));
per_frame_9=decay=1;
per_frame_10=s=1;
per_frame_11=mt=(mt+pow((bass+mid), 2));
per_frame_12=h=((sin((mt*0.008))*0.5)+0.5);
per_frame_13=l=1;
per_frame_14=s=1;
per_frame_15=cc=(6*h);
per_frame_16=cc=(if(abs(below(cc, 1))>0.00001,0,(if(abs(below(cc, 2))>0.00001,1,(if(abs(below(cc, 3))>0.00001,2,(if(abs(below(cc, 4))>0.00001,3,(if(abs(below(cc, 5))>0.00001,4,5))))))))));
per_frame_17=zf=((6*h)-cc);
per_frame_18=zm=l;
per_frame_19=zp=(l*(1-s));
per_frame_20=zq=(l*(1-(s*zf)));
per_frame_21=zt=(l*(1-(s*(1-zf))));
per_frame_22=rr=(if(abs(equal(cc, 0))>0.00001,zm,(if(abs(equal(cc, 1))>0.00001,zq,(if(abs(equal(cc, 2))>0.00001,zp,(if(abs(equal(cc, 3))>0.00001,zp,(if(abs(equal(cc, 4))>0.00001,zt,zm))))))))));
per_frame_23=gg=(if(abs(equal(cc, 0))>0.00001,zt,(if(abs(equal(cc, 1))>0.00001,zm,(if(abs(equal(cc, 2))>0.00001,zm,(if(abs(equal(cc, 3))>0.00001,zq,(if(abs(equal(cc, 4))>0.00001,zp,zp))))))))));
per_frame_24=bb=(if(abs(equal(cc, 0))>0.00001,zp,(if(abs(equal(cc, 1))>0.00001,zp,(if(abs(equal(cc, 2))>0.00001,zt,(if(abs(equal(cc, 3))>0.00001,zm,(if(abs(equal(cc, 4))>0.00001,zm,zq))))))))));
per_frame_25=rr=(if(abs(equal(s, 0))>0.00001,l,rr));
per_frame_26=gg=(if(abs(equal(s, 0))>0.00001,l,gg));
per_frame_27=bb=(if(abs(equal(s, 0))>0.00001,l,bb));
per_frame_28=ob_r=rr;
per_frame_29=ob_g=gg;
per_frame_30=ob_b=bb;
per_frame_31=ib_r=abs((rr-0.25));
per_frame_32=ib_g=abs((gg-0.25));
per_frame_33=ib_b=abs((bb-0.25));
per_frame_34=zoom=0.905;
per_frame_35=warp=(0.905*(1-(bass*0.01)));
