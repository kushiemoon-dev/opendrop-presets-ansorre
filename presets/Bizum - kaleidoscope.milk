MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWarpScale=2.853
fWaveScale=0.0
fWaveSmoothing=1.0
warp=0.0
wave_b=0.6
wave_g=0.6
wave_r=0.6
zoom=0.6
fWaveAlpha=3.5
bMotionVectorsOn=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=obr = 0;
per_frame_init_2=bass1 = 0;
per_frame_init_3=zoming = 0;
per_frame_1=wave_r=((wave_r+cos((time*2)))+bass1);
per_frame_2=wave_g=((wave_g+sin((time*2)))+mid);
per_frame_3=wave_b=((wave_b+tan((time*2)))+treb);
per_frame_4=zoom=0.999;
per_frame_5=cx=0.5;
per_frame_6=cy=0.5;
per_frame_7=wave_mystery=-0.6;
per_frame_8=zoming=sin((time*5));
per_frame_9=rot=1;
per_pixel_1=zoom=(zoom+(0.1*(((bass*rad)*obr)*2)));
per_pixel_2=obr=(if(abs(below(rad, 0.5))>0.00001,1,-1));
per_pixel_3=rot=(0.6*obr);
