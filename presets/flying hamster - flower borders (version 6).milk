per_frame_14=downbeat=(if(abs(above(bass_att, (last_bass*1.3)))>0.00001,1,0));
per_frame_15=last_bass=bass_att;
per_frame_16=last_treb=treb_att;
per_frame_17=upbeats=(if(abs(above(upbeatcount, floor((22)/(volume))))>0.00001,1,0));
per_frame_18=upbeatcount=(if(abs(above(upbeatcount, floor((22)/(volume))))>0.00001,0,(upbeatcount+upbeat)));
per_frame_19=dx=(beat+floor((sin(floor((time)/(4.4))))/(5)));
per_frame_20=dy=(beat+floor((cos(floor((time)/(3.6))))/(5)));
per_frame_21=downbeats=(if(abs(above(downbeatcount, floor((22)/(xvolume))))>0.00001,1,0));
per_frame_22=downbeatcount=(if(abs(above(downbeatcount, floor((22)/(xvolume))))>0.00001,0,(downbeatcount+downbeat)));
per_frame_23=xvolume=floor(((bass_att+treb_att))/(2));
per_frame_24=bordersize=floor(((xvolume+downbeats))/(27));
