per_frame_4=ob_b=abs(sin(floor((time)/(2))));
per_frame_5=ib_r=abs(cos(floor((time)/(3))));
per_frame_6=ib_g=abs(cos(floor((time)/(3))));
per_frame_7=ib_b=abs(cos(floor((time)/(3))));
per_frame_8=q1=(if(abs(above(abs((ob_size-ib_size)), 0.12))>0.00001,17,0.9));
per_frame_9=ob_size=abs(floor((sin(floor((time)/((5*q1)))))/(7)));
per_frame_10=ib_size=(bordersize-ob_size);
per_frame_11=rot=sin(floor((time)/(5.7)));
per_frame_12=volume=floor((((bass+mid)+treb))/(3));
