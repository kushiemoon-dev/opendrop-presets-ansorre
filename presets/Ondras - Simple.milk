per_frame_21=wave_b=((wave_r+wave_g)*0.5);
per_frame_22=q1=x;
per_frame_23=q2=y;
per_frame_24=q3=delka;
per_pixel_1=action=below((sqr((x-q1))+sqr((y-q2))), sqr(q3));
per_pixel_2=rot=(9+sin((time*0.2)));
per_pixel_3=sx=(1-(0.9*action));
per_pixel_4=sy=sx;
per_pixel_5=dx=0;
