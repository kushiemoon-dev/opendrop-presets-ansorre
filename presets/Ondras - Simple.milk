per_frame_1=zmena_x=bor(above(x, (1-delka_x)), below(x, 0));
per_frame_2=zmena_y=bor(above(y, (1-delka_y)), below(y, 0));
per_frame_3=smer_x=(((zmena_x*smer_x)*-1)+(smer_x*(1-zmena_x)));
per_frame_4=smer_y=(((zmena_y*smer_y)*-1)+(smer_y*(1-zmena_y)));
