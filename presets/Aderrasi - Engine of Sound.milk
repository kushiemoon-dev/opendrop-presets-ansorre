per_frame_init_1=volt = 0;
per_frame_1=volt=floor((((bass*treb)*mid))/(3));
per_frame_2=wave_y=(wave_y+(0.2*sin((2*time))));
per_pixel_1=sy=(sy+(if(abs(above(x, 0.1))>0.00001,(if(abs(below(x, 0.3))>0.00001,(0.00-(0.08*sin((3*bass)))),0)),0)));
per_pixel_2=sy=(sy+(if(abs(above(x, 0.4))>0.00001,(if(abs(below(x, 0.6))>0.00001,(0.00-(0.08*sin((3*mid)))),0)),0)));
per_pixel_3=sy=(sy+(if(abs(above(x, 0.7))>0.00001,(if(abs(below(x, 0.9))>0.00001,(0.00-(0.08*sin((3*treb)))),0)),0)));
