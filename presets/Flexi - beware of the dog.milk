per_pixel_1=cx1=(0.5+(sin((time*0.618))*0.2));
per_pixel_2=cy1=(0.5+(cos((time*1.618))*0.2));
per_pixel_3=dir=bass;
per_pixel_4=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_5=x1=(if(abs(above(d, 0.3))>0.00001,0,((sin((y-cy1))*0.05)*dir)));
per_pixel_6=y1=(if(abs(above(d, 0.3))>0.00001,0,((-sin((x-cx1))*0.05)*dir)));
per_pixel_7=cx1=(0.5+(sin((time*2.618))*0.3));
per_pixel_8=cy1=(0.5+(cos((time*3.14))*0.3));
per_pixel_9=dir=(-mid*2);
per_pixel_10=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_11=x2=(if(abs(above(d, 0.2))>0.00001,0,((sin((y-cy1))*0.05)*dir)));
per_pixel_12=y2=(if(abs(above(d, 0.2))>0.00001,0,((-sin((x-cx1))*0.05)*dir)));
per_pixel_13=cx1=(0.5+(sin((-time*2.618))*0.4));
per_pixel_14=cy1=(0.5+(cos((-time*1.14))*0.4));
per_pixel_15=dir=(treb*3);
per_pixel_16=d=sqrt((((x-cx1)*(x-cx1))+((y-cy1)*(y-cy1))));
per_pixel_17=x3=(if(abs(above(d, 0.1))>0.00001,0,((sin((y-cy1))*0.05)*dir)));
per_pixel_18=y3=(if(abs(above(d, 0.1))>0.00001,0,((-sin((x-cx1))*0.05)*dir)));
per_pixel_19=dx=((x1+x2)+x3);
per_pixel_20=dy=((y1+y2)+y3);
