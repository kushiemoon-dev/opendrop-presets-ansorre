MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bInvert=1.0
fDecay=1.0
ib_a=0.35
ib_b=1.0
ib_g=1.0
ib_r=1.0
mv_a=0.0
ob_a=1.0
ob_b=1.0
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=1.01
fVideoEchoAlpha=0.5
fVideoEchoZoom=0.99663
nVideoEchoOrientation=1.0
fWaveAlpha=0.001
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=0.0
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=basstime = 0;
per_frame_init_2=xs = 0;
per_frame_init_3=stickybit = 0;
per_frame_init_4=volavg2 = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=diff = 0;
per_frame_init_7=edge = 0;
per_frame_init_8=ys = 0;
per_frame_init_9=q4 = 0;
per_frame_init_10=volavg = 0;
per_frame_init_11=bit2 = 0;
per_frame_init_12=state = 0;
per_frame_init_13=vol = 0;
per_frame_init_14=q2 = 0;
per_frame_init_15=q3 = 0;
per_frame_init_16=basssum = 0;
per_frame_1=basstime=(basstime+(bass_att*0.03));
per_frame_2=vol=pow(((bass+mid)+treb), 2);
per_frame_3=basssum=vol;
per_frame_4=stickybit=((time)%(2));
per_frame_5=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_6=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_7=edge=bnot(equal(bit2, stickybit));
per_frame_8=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_9=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_10=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(volavg2)),0));
per_frame_11=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(volavg)),diff));
per_frame_12=bit2=((time)%(2));
per_frame_13=q1=diff;
per_frame_14=ob_r=(0.5+(0.5*sin((basstime*4.5))));
per_frame_15=ob_g=(0.5+(0.5*sin((basstime*5))));
per_frame_16=ob_b=(0.5+(0.5*sin((basstime*3.8))));
per_frame_17=q2=basstime;
per_frame_18=state=(state+above(bass_att, 1.3));
per_frame_19=state=(if(abs(above(state, 1))>0.00001,0,state));
per_frame_20=xs=(if(abs(below(xs, 1))>0.00001,5,xs));
per_frame_21=ys=(if(abs(below(xs, 1))>0.00001,5,ys));
per_frame_22=xs=((xs+((equal(state, 0)*cos((basstime*1.2)))*diff))+((equal(state, 1)*sin(((basstime*1.5)+1)))*diff));
per_frame_23=ys=((xs+((equal(state, 0)*cos(((basstime*1.45)+0.3)))*diff))+((equal(state, 1)*sin((basstime*1.05)))*diff));
per_frame_24=q3=(0.5+(0.5*sin((xs*2))));
per_frame_25=q4=(0.5+(0.5*sin((ys*2.1))));
per_frame_26=echo_orient=3;
per_frame_27=monitor=basstime;
per_pixel_1=rot=(((y*x)*q1)*5);
per_pixel_2=sx=(1-q1);
per_pixel_3=sy=(1-q1);
per_pixel_4=cx=q3;
per_pixel_5=cy=q4;
