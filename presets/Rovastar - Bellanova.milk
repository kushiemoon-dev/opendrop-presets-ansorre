MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveDots=1.0
fWaveScale=0.4511
fWaveSmoothing=0.606
mv_a=0.0
wave_b=0.5
wave_g=0.0
wave_r=0.5
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=wave_mystery=(-0.5+(0.1*sin((bass*10))));
per_frame_3=wave_g=(wave_r+(0.5*sin((time*3))));
per_frame_4=wave_b=(0.5+(0.5*sin(floor((time)/(10)))));
per_pixel_1=rot=(rot+(0.1*sin((ang*6))));
per_pixel_2=zoom=(1.05+(0.1*abs(sin(ang))));
per_pixel_3=sx=((0.1*rot)+1);
per_pixel_4=sy=(floor((rot)/(9))+1);
