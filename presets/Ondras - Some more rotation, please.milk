per_frame_1=ob_r=((1+sin(time))*0.5);
per_frame_2=ib_a=(0.5+(0.5*sin((0.9*time))));
per_frame_3=zmena_x=bor(above(x, (1-delka_x)), below(x, 0));
per_frame_4=zmena_y=bor(above(y, (1-delka_y)), below(y, 0));
per_frame_5=smer_x=(((zmena_x*smer_x)*-1)+(smer_x*(1-zmena_x)));
per_frame_6=smer_y=(((zmena_y*smer_y)*-1)+(smer_y*(1-zmena_y)));
per_frame_7=x=(x+(smer_x*speed_x));
per_frame_8=y=(y+(smer_y*speed_y));
per_frame_9=wave_x=(x+(delka*0.5));
per_frame_10=wave_y=((1-y)-(delka*0.5));
per_frame_11=cx=x;
per_frame_12=cy=y;
per_frame_13=q1=x;
per_frame_14=q2=y;
per_frame_15=q3=delka;
per_frame_16=monitor=speed_x;
per_pixel_1=action=below((sqr((x-q1))+sqr((y-q2))), sqr(q3));
per_pixel_2=rot=((((0.4*(1-action))*sin(time))*2)*cos(time));
