per_frame_init_9=q3 = 0;
per_frame_init_10=tmb = 0;
per_frame_1=tm=floor((time)/(6));
per_frame_2=tmb=(tmb+floor((bass)/(36)));
per_frame_3=adj=0.6;
per_frame_4=ib_r=(1-pow(((sin(floor((tmb)/(2)))*0.5)+adj), 3));
per_frame_5=ib_g=(1-pow(((sin((floor((tmb)/(2))+1))*0.5)+adj), 3));
per_frame_6=ib_b=(1-pow(((sin((floor((tmb)/(2))+3))*0.5)+adj), 3));
per_frame_7=ob_r=(1-pow(((sin((floor((tmb)/(2))+0.5))*0.5)+adj), 3));
per_frame_8=ob_g=(1-pow(((sin((floor((tmb)/(2))+1.5))*0.5)+adj), 3));
per_frame_9=ob_b=(1-pow(((sin((floor((tmb)/(2))+4.0))*0.5)+adj), 3));
per_frame_10=warp=sin(time);
per_frame_11=sy=0.982;
per_frame_12=sx=sy;
per_pixel_1=rot=(rot+q1);
per_pixel_2=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_3=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_4=ti=(time*-0.6);
per_pixel_5=rot=(sin(((rad+ti)*6.2832))*0.01);
per_pixel_6=sz=0.4;
per_pixel_7=xsec=(above(x, sz)*below(x, (1-sz)));
per_pixel_8=ysec=(above(y, sz)*below(y, (1-sz)));
per_pixel_9=zoom=(if(abs((xsec+ysec))>0.00001,zoom,0.75));
per_pixel_10=dx=(if(abs((xsec+ysec))>0.00001,dx,0.5));
per_pixel_11=dy=(if(abs((xsec+ysec))>0.00001,dy,0.5));
per_pixel_12=sx=(if(abs((xsec+ysec))>0.00001,(0.9+q3),1));
per_pixel_13=rot=(if(abs((xsec+ysec))>0.00001,rot,(q4*(1-(2*above(x, 0.5))))));
