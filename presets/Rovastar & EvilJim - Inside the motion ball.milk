per_frame_init_2=treb_effect = 0;
per_frame_1=wave_r=((0.4+(0.3*sin((time*0.345))))-(0.2*(1-bass)));
per_frame_2=wave_g=((0.4+(0.3*sin((time*0.421))))-(0.2*(1-treb)));
