per_pixel_3=dx=(if(abs(above((1.2-rad), ((bass_effect+1.2)*0.6)))>0.00001,(0.05*sin((time*0.234))),(-0.002*sin((time*0.234)))));
per_pixel_4=dy=(if(abs(above((1.2-rad), ((treb_effect+1.2)*0.5)))>0.00001,(0.05*sin((time*0.311))),(-0.002*sin((time*0.311)))));
