MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.925
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.26
mv_a=0.0
ob_a=1.0
ob_b=1.0
ob_r=0.5
ob_size=0.02
rot=1.0
sx=0.980296
sy=0.990099
warp=0.01
zoom=0.989618
bAdditiveWaves=1.0
fVideoEchoZoom=1.006596
nVideoEchoOrientation=3.0
fWaveAlpha=0.001581
fWaveParam=0.8
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=myzoomexp = 0;
per_frame_init_2=myzoom = 0;
per_frame_init_3=a = 0;
per_frame_1=ob_r=(if(abs(above(treb, treb_att))>0.00001,ob_r,(ob_r+0.20)));
per_frame_2=ob_g=(if(abs(above(mid, mid_att))>0.00001,ob_g,(ob_r+0.40)));
per_frame_3=ob_b=(if(abs(above(bass, bass_att))>0.00001,ob_b,(ob_r-0.20)));
per_frame_4=echo_alpha=(1*sin((time*0.20)));
per_pixel_1=myzoomexp=0;
per_pixel_2=myzoom=0.800;
per_pixel_3=a=pow(myzoom, pow(myzoomexp, ((rad*2)-1)));
per_pixel_4=dx=((((x-0.5)*a)+0.5)-x);
per_pixel_5=dy=((((y-0.5)*a)+0.5)-y);
per_pixel_6=rot=(if(abs(above(bass, bass_att))>0.00001,(rot*ang),(-rot*ang)));
