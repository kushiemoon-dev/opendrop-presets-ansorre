per_frame_11=wave_r=(0.799+(0.2*sin((0.645*time))));
per_frame_12=wave_g=(0.499+(0.1*sin((0.567*time))));
per_frame_13=zoom=(zoom-((bass_att-1)*0.08));
per_pixel_1=rot=((0.02*sin((1-rad)))+(0.05*q1));
per_pixel_2=warp=(0.012*sin(ang));
