per_frame_3=mv_g=bass;
per_frame_4=mv_b=mid;
per_frame_5=mv_a=(bass_att-floor((treb_att)/(3)));
per_frame_6=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_7=decay=(if(abs(above(bass_effect, 0))>0.00001,(0.97-(0.15*bass_effect)),0.9995));
per_frame_8=q1=bass_effect;
per_frame_9=warp=0;
