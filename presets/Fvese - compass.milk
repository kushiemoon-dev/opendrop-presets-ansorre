nMotionVectorsY=1.320001
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=beateven = 0;
per_frame_init_2=progress = 0;
per_frame_init_3=meanbass_att = 0;
per_frame_init_4=rozzorrate = 0;
per_frame_init_5=lastbeat = 0;
per_frame_init_6=beatrate = 0;
per_frame_init_7=peakbass_att = 0;
per_frame_init_8=beatcounter = 0;
per_frame_init_9=initframe = 0;
per_frame_init_10=att = 0;
per_frame_init_11=volume = 0;
per_frame_init_12=beat = 0;
per_frame_init_13=beatcount = 0;
per_frame_init_14=basseffect = 0;
per_frame_1=volume=((bass+mid)+att);
per_frame_2=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_3=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_4=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_5=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_6=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_7=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_8=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_9=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_10=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_11=beatcounter=(if(abs(above(progress, 0.01))>0.00001,(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter)),0));
per_frame_12=beatcounter=(if(abs(above(beatcounter, 101))>0.00001,0,beatcounter));
per_frame_13=beateven=((beatcounter)%(2));
per_frame_14=warp=0;
per_frame_15=basseffect=max((max(bass, bass_att)-1), 0);
per_frame_16=mv_y=(4-min((((peakbass_att+beatrate)-2)*0.25), 0.9));
per_frame_17=mv_r=(basseffect*4);
per_frame_18=mv_b=(basseffect*3);
per_frame_19=mv_g=(basseffect*3.5);
per_frame_20=wave_x=(if(abs(beat)>0.00001,0.5,0.2));
per_frame_21=wave_y=(if(abs(beat)>0.00001,0.5,0.2));
per_frame_22=beatcount=(beatcount+beat);
per_frame_23=initframe=(if(abs(below(beatcount, 1))>0.00001,frame,initframe));
per_frame_24=rozzorrate=floor(((frame-initframe))/(beatcount));
per_frame_25=monitor=rozzorrate;
per_frame_26=wave_r=(wave_r+(0.350*((0.60*sin((0.737*time)))+(0.40*sin((0.970*time))))));
per_frame_27=wave_g=(wave_g+(0.350*((0.60*sin((0.844*time)))+(0.40*sin((0.941*time))))));
per_frame_28=wave_b=(wave_b+(0.350*((0.60*sin((0.851*time)))+(0.40*sin((1.055*time))))));
per_frame_29=cx=(cx+(0.225*((0.60*sin((0.350*time)))+(0.40*sin((0.350*time))))));
per_frame_30=cy=(cy+(0.225*((0.60*sin((0.350*time)))+(0.40*sin((0.350*time))))));
per_frame_31=dx=-0.00005;
per_frame_32=dy=-0.00005;
per_frame_33=decay=(decay-(0.01*equal(((frame)%(16)), 0)));
per_frame_34=rot=(1-beatrate);
per_frame_35=zoom=(beat-1);
