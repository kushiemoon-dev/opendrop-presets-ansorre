MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bModWaveAlphaByVolume=1.0
bSolarize=1.0
fDecay=0.999
fGammaAdj=1.0
fWarpScale=2.138
fWaveScale=0.402184
fWaveSmoothing=0.9
ib_b=0.0
ib_g=0.0
ib_r=1.0
ib_size=0.0
mv_l=0.35
nWaveMode=5.0
ob_b=1.0
ob_size=0.0
