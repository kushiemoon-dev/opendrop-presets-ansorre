per_frame_1=warp=0;
per_frame_2=wave_r=(wave_r+(if(abs(above(bass_att, 1.4))>0.00001,1,(0.49*sin((time*2))))));
per_frame_3=wave_g=(wave_g+(if(abs(above(bass_att, 1.4))>0.00001,0,(if(abs(above(treb_att, 1.4))>0.00001,1,(0.49*sin((time*3))))))));
per_frame_4=wave_b=(wave_b+(if(abs(above(treb_att, 1.4))>0.00001,0,(0.49*sin(time)))));
per_frame_5=bass_flux=((if(abs(equal(abs(bass_flux), 1))>0.00001,bass_flux,1))*(if(abs(above(abs(timing), 0.97))>0.00001,-1,(if(abs(above(bass_att, 1.3))>0.00001,-1,1)))));
per_frame_6=treb_flux=((if(abs(equal(abs(treb_flux), 1))>0.00001,treb_flux,1))*(if(abs(above(treb_att, 1.3))>0.00001,-1,1)));
per_frame_7=timing=((if(abs(above(abs(timing), 0.97))>0.00001,(timing*0.9),timing))+((if(abs(above(mid_att, 1.3))>0.00001,0.09,0.03))*bass_flux));
per_frame_8=q1=timing;
per_frame_9=q2=(-timing*bass_flux);
per_frame_10=q3=(timing*treb_flux);
per_frame_11=rot=(if(abs(above(q1, 0))>0.00001,(if(abs(above(q2, 0))>0.00001,0.1,-0.1)),0));
per_frame_12=zoom=((zoom+(0.05*q2))+(0.05*q1));
per_frame_13=wave_mystery=((wave_mystery+(0.7*q1))+(0.3*q2));
per_frame_14=wave_size=(wave_size+(0.5*q3));
per_frame_15=cx=(cx+(0.2*q1));
per_frame_16=cy=(cy+(0.2*q3));
per_pixel_1=centerx=0.5;
per_pixel_2=centery=0.5;
per_pixel_3=crad=(abs((rad-0.5))*q2);
per_pixel_4=grid=(((abs(((x*10)-5)))%(2))+((abs(((y*10)-5)))%(2)));
per_pixel_5=sx_temp=(if(abs(equal(grid, 0))>0.00001,(if(abs(above(x, centerx))>0.00001,((sx-crad)-centerx),((sx+crad)-centerx))),sx));
per_pixel_6=sy_temp=(if(abs(equal(grid, 0))>0.00001,(if(abs(above(y, centery))>0.00001,((sy-crad)-centery),((sy+crad)-centery))),sy));
per_pixel_7=sx=(if(abs(below(q1, 0))>0.00001,(sx-((sx_temp*q2)*0.1)),sx));
per_pixel_8=sy=(if(abs(below(q1, 0))>0.00001,(sy-((sx_temp*q2)*0.1)),sy));
