per_pixel_1=iv1=(rad*sin(ang));
per_pixel_2=zoom=(zoom+(((0.10*sin((ang*(if(abs(above(x, y))>0.00001,ang,rad)))))*2)*sin((((ang*0.20)*time)*0.20))));
per_pixel_3=zoom=(zoom+0.10);
per_pixel_4=zoom=((if(abs(below(x, -iv1))>0.00001,-zoom,-zoom))-(0.20*sin(bass)));
per_pixel_5=dx=((if(abs(below(y, iv1))>0.00001,-dx,-dy))*sin(bass));
per_pixel_6=dx=((if(abs(below(y, 0.3))>0.00001,-dy,-dy))*sin(bass));
per_pixel_7=dy=((if(abs(above(x, 0.2))>0.00001,dx,dy))*sin(treb));
per_pixel_8=dy=((if(abs(above(x, iv1))>0.00001,dx,xy))*sin(treb));
