shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=0.0
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=bt = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=count = 0;
per_frame_init_4=mc = 0;
per_frame_init_5=boxc = 0;
per_frame_init_6=is_beat = 0;
per_frame_init_7=bd = 0;
per_frame_init_8=boxy = 0;
per_frame_init_9=boxd = 0;
per_frame_init_10=timp = 0;
per_frame_init_11=boxx = 0;
per_frame_init_12=boxa = 0;
