per_frame_init_15=bimp = 0;
per_frame_init_16=mimp = 0;
per_frame_init_17=tc = 0;
per_frame_init_18=bc = 0;
per_frame_init_19=bb = 0;
per_frame_init_20=boxb = 0;
per_frame_1=warp=0;
per_frame_2=wave_a=0;
per_frame_3=count=(count+1);
per_frame_4=bc=(bc+bass);
per_frame_5=tc=(tc+treb);
per_frame_6=mc=(mc+mid);
per_frame_7=bb=((0.5*bd)+(0.5*bass_att));
per_frame_8=bt=((0.5*bt)+(0.5*treb_att));
per_frame_9=mt=((0.5*mt)+(0.5*mid_att));
per_frame_10=bimp=(if(abs(above((3.25*bass), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_11=timp=(if(abs(above((3.25*treb), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_12=mimp=(if(abs(above((3.25*mid), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_13=is_beat=(if(abs(above(bb, floor((bc)/(count))))>0.00001,(1*bimp),(if(abs(above(bt, floor((tc)/(count))))>0.00001,(1*timp),(if(abs(above(mt, floor((mc)/(count))))>0.00001,(1*mimp),0))))));
per_frame_14=is_beat=(if(abs(above(reha, 0))>0.00001,0,is_beat));
per_frame_15=reha=(if(abs(is_beat)>0.00001,(fps*0.25),(if(abs(below(reha, 1))>0.00001,0,(reha-1)))));
per_frame_16=q1=is_beat;
per_pixel_1=boxx=((((((((((((x>0.025)?1:0)*((x<0.075)?1:0))+(((x>0.125)?1:0)*((x<0.175)?1:0)))+(((x>0.225)?1:0)*((x<0.275)?1:0)))+(((x>0.325)?1:0)*((x<0.375)?1:0)))+(((x>0.425)?1:0)*((x<0.475)?1:0)))+(((x>0.525)?1:0)*((x<0.575)?1:0)))+(((x>0.625)?1:0)*((x<0.675)?1:0)))+(((x>0.725)?1:0)*((x<0.775)?1:0)))+(((x>0.825)?1:0)*((x<0.875)?1:0)))+(((x>0.925)?1:0)*((x<0.975)?1:0)));
per_pixel_2=boxy=((((((((((((y>0.025)?1:0)*((y<0.075)?1:0))+(((y>0.125)?1:0)*((y<0.175)?1:0)))+(((y>0.225)?1:0)*((y<0.275)?1:0)))+(((y>0.325)?1:0)*((y<0.375)?1:0)))+(((y>0.425)?1:0)*((y<0.475)?1:0)))+(((y>0.525)?1:0)*((y<0.575)?1:0)))+(((y>0.625)?1:0)*((y<0.675)?1:0)))+(((y>0.725)?1:0)*((y<0.775)?1:0)))+(((y>0.825)?1:0)*((y<0.875)?1:0)))+(((y>0.925)?1:0)*((y<0.975)?1:0)));
per_pixel_3=boxa=(boxx*boxy);
per_pixel_4=boxb=((1-boxx)*(1-boxy));
per_pixel_5=boxc=((1-boxx)*boxy);
per_pixel_6=boxd=(boxx*(1-boxy));
per_pixel_7=sx=(1+(0.02*boxd));
per_pixel_8=sy=(1+(0.02*boxc));
per_pixel_9=zoom=((zoom+(0.1*boxa))+(0.02*boxb));
per_pixel_10=rot=((rot-(1.5*boxc))-(0.5*boxa));
