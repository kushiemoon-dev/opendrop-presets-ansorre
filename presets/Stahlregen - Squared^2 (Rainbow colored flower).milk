shape_0_init1=delay = 0;
shape_0_init2=q1 = 0;
shape_0_init3=counter = 0;
shape_0_per_frame1=delay=(1-q1);
shape_0_per_frame2=counter=(if(abs(equal(delay, 0))>0.00001,(counter+1),counter));
shape_0_per_frame3=counter=(if(abs(equal(counter, 7))>0.00001,1,counter));
shape_0_per_frame4=r=((0.5*below(counter, 4))+(0.25*above(counter, 5)));
shape_0_per_frame5=g=(((0.5*above(counter, 1))*below(counter, 5))-(0.25*equal(counter, 2)));
shape_0_per_frame6=b=((0.5*above(counter, 4))-(0.25*equal(counter, 7)));
shape_0_per_frame7=r2=r;
shape_0_per_frame8=g2=g;
shape_0_per_frame9=b2=b;
shape_0_per_frame10=rad=0.04;
