per_frame_1=wave_mystery=(wave_mystery+(1*tan((800*time))));
per_frame_2=wave_r=(wave_r+(0.8*sin((5*bass))));
per_frame_3=wave_g=(wave_g+(0.8*sin((5*treb))));
per_frame_4=wave_b=(wave_b+(0.8*sin((6*mid))));
per_frame_5=warp=0;
per_pixel_1=rot=(rot+(if(abs(above(ang, (0.2+(3*tan((2.5*time))))))>0.00001,(if(abs(below(ang, (0.4+(3*tan((2.5*time))))))>0.00001,(0.25*sin((3*bass))),0)),0)));
per_pixel_2=rot=(rot+(if(abs(above(ang, (0.5+(3*tan((2.5*time))))))>0.00001,(if(abs(below(ang, (0.7+(3*tan((2.5*time))))))>0.00001,(-0.35*sin((3*treb))),0)),0)));
per_pixel_3=zoom=(zoom+(if(abs(above(ang, (0.3+(3*tan((2.5*time))))))>0.00001,(if(abs(below(ang, (0.5+(3*tan((2.5*time))))))>0.00001,(0.5*sin((3*mid))),0)),0)));
per_pixel_4=zoom=(zoom+((0.06*(0.5-rad))*bass));
