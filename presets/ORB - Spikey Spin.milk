per_frame_9=yy=((cos(basstime)*speed)+yy);
per_frame_10=q2=cos((xx+speed));
per_frame_11=q3=cos((yy+speed));
per_frame_12=monitor=q2;
per_pixel_1=zoom=((1-((rad-(q2*q3))*0.1))-(bass*0.01));
per_pixel_2=dx=(q2*0.03);
per_pixel_3=dy=(q3*0.03);
