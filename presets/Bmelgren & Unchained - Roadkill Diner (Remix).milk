per_pixel_4=dx=(dx-(if(abs(below(x, 0.65))>0.00001,(if(abs(above(x, 0.35))>0.00001,((0.1*(x-0.5))+(0.01*sin(((y*30)+((sign((y-0.5))*time)*4))))),0)),(q5*0.02))));
