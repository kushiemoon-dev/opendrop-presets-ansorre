per_frame_init_1=q1 = 0;
per_frame_init_2=newrad = 0;
per_frame_init_3=madbass = 0;
per_frame_init_4=bass_effect = 0;
per_frame_1=wave_mystery=(-0.4+(0.1*sin(treb)));
per_frame_2=wave_x=(0.3+(0.2*mid));
per_frame_3=wave_y=(0.3+(0.2*bass));
per_frame_4=wave_r=bass;
per_frame_5=wave_g=mid;
per_frame_6=wave_b=treb;
per_frame_7=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_8=zoom=((zoom-(1.4*madbass))+0.02);
per_frame_9=ib_a=(if(abs(above(bass, 1.2))>0.00001,0.7,0));
per_frame_10=ob_r=(if(abs(above(treb, 1.2))>0.00001,0.3,0.1));
per_frame_11=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_12=q1=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_frame_13=ob_b=(mid+bass);
per_frame_14=wave_y=(treb*wave_r);
per_frame_15=ib_a=(wave_g-treb);
per_frame_16=wave_y=(if(abs(below(wave_y, 0.0))>0.00001,0.0,wave_y));
per_frame_17=wave_y=(if(abs(above(wave_y, 1.0))>0.00001,1.0,wave_y));
per_frame_18=ob_b=(if(abs(below(ob_b, 0.0))>0.00001,0.0,ob_b));
per_frame_19=ob_b=(if(abs(above(ob_b, 1.0))>0.00001,1.0,ob_b));
per_frame_20=ib_a=(if(abs(below(ib_a, 0.0))>0.00001,0.0,ib_a));
per_frame_21=ib_a=(if(abs(above(ib_a, 1.0))>0.00001,1.0,ib_a));
per_frame_22=ob_b=(if(abs(below(ob_b, 0.0))>0.00001,0.0,ob_b));
per_frame_23=ob_b=(if(abs(above(ob_b, 1.0))>0.00001,1.0,ob_b));
per_frame_24=wave_y=(if(abs(below(wave_y, 0.0))>0.00001,0.0,wave_y));
per_frame_25=wave_y=(if(abs(above(wave_y, 1.0))>0.00001,1.0,wave_y));
per_frame_26=ob_b=(if(abs(below(ob_b, 0.0))>0.00001,0.0,ob_b));
per_frame_27=ob_b=(if(abs(above(ob_b, 1.0))>0.00001,1.0,ob_b));
per_frame_28=wave_y=(if(abs(below(wave_y, 0.0))>0.00001,0.0,wave_y));
per_frame_29=wave_y=(if(abs(above(wave_y, 1.0))>0.00001,1.0,wave_y));
per_frame_30=ib_a=(if(abs(below(ib_a, 0.0))>0.00001,0.0,ib_a));
per_frame_31=ib_a=(if(abs(above(ib_a, 1.0))>0.00001,1.0,ib_a));
per_pixel_1=rot=(if(abs(below(rad, q1))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_2=zoom=(if(abs(below(rad, q1))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
per_pixel_3=rot=(warp-zoom);
per_pixel_4=sx=(time+newrad);
per_pixel_5=warp=(time+q1);
per_pixel_6=sy=(x+zoom);
per_pixel_7=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_8=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_9=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_pixel_10=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_pixel_11=sx=(if(abs(below(sx, 0.01))>0.00001,0.01,sx));
per_pixel_12=sx=(if(abs(above(sx, 100.0))>0.00001,100.0,sx));
per_pixel_13=sy=(if(abs(below(sy, 0.01))>0.00001,0.01,sy));
per_pixel_14=sy=(if(abs(above(sy, 100.0))>0.00001,100.0,sy));
