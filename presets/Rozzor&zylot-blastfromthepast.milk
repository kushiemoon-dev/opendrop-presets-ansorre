shapecode_3_enabled=0.0
per_frame_init_1=var1 = 0;
per_frame_init_2=var2 = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=vol_now = 0;
per_frame_init_5=vol_mean = 0;
per_frame_init_6=beat = 0;
per_frame_init_7=beatcount = 0;
per_frame_1=warp=0;
per_frame_2=wave_mystery=(0.3*sin(time));
per_frame_3=wave_r=(wave_r+(0.25*sin((time*0.666))));
per_frame_4=wave_b=(wave_g-(2*wave_mystery));
per_frame_5=wave_g=(treb_att*0.2);
per_frame_6=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_7=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_8=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
per_frame_9=beatcount=(beatcount+beat);
per_frame_10=q1=((beatcount)%(2));
per_frame_11=rot=(if(abs(q1)>0.00001,0,rot));
per_frame_12=wave_mode=(if(abs(q1)>0.00001,0,4));
per_pixel_1=var1=sqrt(sin((rad*5)));
per_pixel_2=var2=(cos((ang*5))+sin((time*rad)));
per_pixel_3=zoom=(if(abs(q1)>0.00001,(zoom+((0.1*var1)*var2)),1));
per_pixel_4=rot=(if(abs(q1)>0.00001,(0.4*var2),(rot+(0.1*sin(((pow(x, 2)*50)+(time*5)))))));
per_pixel_5=dy=(if(abs(q1)>0.00001,dy,rot));
