per_frame_1=brot=(brot+(0.035*(bass+treb)));
per_frame_2=trot=(trot+(0.035*treb));
per_frame_3=mrot=(mrot+(0.03*sqr(mid)));
per_frame_4=q1=brot;
per_frame_5=wave_mystery=((0.001*(((trot*1000))%(2000)))-1);
per_frame_6=echo_alpha=(0.5+(0.3*sin(mrot)));
per_frame_7=asnd=(((bass_att+mid_att)+treb_att)*0.333);
per_frame_8=mv_r=min(1, max(0, (0.5+(1.7*(bass-asnd)))));
per_frame_9=mv_g=min(1, max(0, (0.5+(1.7*(treb-asnd)))));
per_frame_10=mv_b=min(1, max(0, (0.5+(1.7*(mid-asnd)))));
per_frame_11=zoom=max(1, ((treb+bass)-3));
per_frame_12=btrig=(if(abs(above(bass, 2.7))>0.00001,time,btrig));
per_frame_13=mtrig=(if(abs(above(mid, 2.7))>0.00001,time,mtrig));
per_frame_14=ttrig=(if(abs(above(treb, 2.7))>0.00001,time,ttrig));
per_frame_15=wave_r=(if(abs(below((time-btrig), 0.5))>0.00001,cos(((time-btrig)*3.1416)),0));
per_frame_16=wave_g=(if(abs(below((time-ttrig), 0.5))>0.00001,cos(((time-ttrig)*3.1416)),0));
per_frame_17=wave_b=(if(abs(below((time-mtrig), 0.5))>0.00001,cos(((time-mtrig)*3.1416)),0));
per_frame_18=wave_y=min(1, max(0, (0.2*(bass_att+mid_att))));
per_frame_19=wrot=(if(abs(above(treb, 2.7))>0.00001,(if(abs(above(wrot, 2))>0.00001,0,(wrot+1))),wrot));
per_frame_20=wave_mode=(if(abs(below(wrot, 2))>0.00001,wrot,(if(abs(equal(wrot, 2))>0.00001,7,5))));
per_frame_21=ib_r=min(1, max(0, (sqr(bass)-1)));
per_frame_22=mbt=(if(abs(above(((mid+treb)+(2*bass)), 11))>0.00001,time,mbt));
per_frame_23=q2=(if(abs(above((time-mbt), 0.5))>0.00001,1,max(0, ((10*(time-mbt))-4))));
per_pixel_1=vo=(cos(q1)*((0.5-y)+((x-0.5)*tan(q1))));
per_pixel_2=vo=(if(abs(((frame)%(2)))>0.00001,max(vo, 0),min(vo, 0)));
per_pixel_3=dx=(((2*sin(q1))*vo)*q2);
per_pixel_4=dy=(((-2*cos(q1))*vo)*q2);
