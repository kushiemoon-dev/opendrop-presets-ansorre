shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=((wave_r+(0.2*sin((time*0.333))))+(bass_att*0.2));
per_frame_3=wave_g=((wave_g+(0.2*sin((time*0.555))))+(treb_att*0.2));
per_frame_4=wave_b=((wave_b+(0.2*sin((time*0.444))))+(mid_att*0.2));
per_frame_5=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_6=rot=min((if(abs(above(bass_effect, 0))>0.00001,(bass_effect+0.2),0)), 1.8);
per_frame_7=mv_x=1;
per_frame_8=mv_y=1;
per_frame_9=dx=-0.0005;
per_frame_10=dy=-0.0005;
per_frame_11=mv_l=(-25+(rot*500));
per_frame_12=mv_r=1;
per_frame_13=mv_b=(1-wave_g);
per_frame_14=mv_g=(1-wave_r);
per_frame_15=monitor=rot;
per_frame_16=cx=((0.8*sin(floor((time)/(2.4))))+(0.2*sin((time*1.2))));
per_frame_17=cy=(((0.4*sin(floor((time)/(2))))+(0.2*sin(time)))+abs((0.2*sin((time*1.2)))));
per_pixel_1=dx=(dx+(((0.1*treb_att)*abs(sin(time)))*atan((x-0.5))));
per_pixel_2=dy=(dy+(((0.1*bass_att)*abs(cos(time)))*atan((y-0.5))));
per_pixel_3=zoom=((zoom+(0.05*pow(zoom, 2)))-0.04);
per_pixel_4=rot=((dx*dy)*200);
per_pixel_5=zoom=(if(abs(below(rad, 0.087))>0.00001,-zoom,zoom));
