per_frame_1=decay=0.97;
per_frame_2=zoom=1.000;
per_frame_3=mv_x=((sin(floor((time)/(4)))*8)+56);
per_frame_4=mv_y=((cos(floor((time)/(4)))*8)+40);
per_frame_5=mv_r=((sin(floor((time)/(3)))*0.3)+0.3);
per_frame_6=mv_g=((cos(floor((time)/(3)))*0.3)+0.3);
per_frame_7=mv_b=((sin((time+1.5))*0.3)+0.3);
per_pixel_1=xpos1=((sin(floor((time)/(2)))*0.3)+0.5);
per_pixel_2=ypos1=((cos(floor((time)/(2)))*0.4)+0.5);
per_pixel_3=size=0.2;
per_pixel_4=xp_lo=(xpos1-size);
per_pixel_5=xp_hi=(xpos1+size);
per_pixel_6=yp_lo=(ypos1-size);
per_pixel_7=yp_hi=(ypos1+size);
per_pixel_8=xcheck=(above(x, xp_lo)*below(x, xp_hi));
per_pixel_9=ycheck=(above(y, yp_lo)*below(y, yp_hi));
per_pixel_10=xfade_ctrl=((sin(floor((time)/(5)))*0.5)+0.5);
per_pixel_11=crossfade1=((xcheck*xfade_ctrl)+(ycheck*(1-xfade_ctrl)));
per_pixel_12=crossfade2=((ycheck*xfade_ctrl)+(xcheck*(1-xfade_ctrl)));
per_pixel_13=zflux=((sin(floor((time)/(2)))*0.4)+0.5);
per_pixel_14=rflux=(sin(floor((time)/(1.5)))*0.8);
per_pixel_15=zoom=((1.0*xcheck)+(zflux*(1-xcheck)));
per_pixel_16=rot=((0.00*ycheck)+(rflux*(1-ycheck)));
