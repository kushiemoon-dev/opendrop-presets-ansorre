per_frame_7=redif=(if(abs(above(bass, 1.2))>0.00001,redsine,(if(abs(above(redif, 0.95))>0.00001,0,(redif*0.85)))));
per_frame_8=greenif=(if(abs(above(mid, 1.2))>0.00001,greensine,(if(abs(above(greenif, 0.95))>0.00001,0,(greenif*0.85)))));
per_frame_9=blueif=(if(abs(above(treb, 1.2))>0.00001,bluesine,(if(abs(above(blueif, 0.95))>0.00001,0,(blueif*0.85)))));
