per_frame_init_1=newx = 0;
per_frame_init_2=newy = 0;
per_frame_init_3=newrad = 0;
per_frame_init_4=newang = 0;
per_frame_init_5=newzoom = 0;
per_frame_init_6=q1 = 0;
per_frame_init_7=q2 = 0;
per_frame_1=wave_b=(bass_att-1);
per_frame_2=wave_r=(treb_att-1.3);
per_frame_3=q1=(0.5*(time*0.125));
per_frame_4=q2=(1*(time*0.1));
per_pixel_1=newx=((x-0.5)+((bass_att-1)*0.1));
per_pixel_2=newy=(y-(0.15*cos((bass*5))));
per_pixel_3=newrad=(sqrt(((newx*newx)+((0.5625*newy)*newy)))*2);
per_pixel_4=newang=(newx*atan((-newy)/( newx)));
per_pixel_5=newzoom=(1+(0.5*sin((bass_att*(newrad+(3.1*sin(newang)))))));
per_pixel_6=dx=((-0.0005+(newx*newzoom))-newx);
per_pixel_7=dy=((-0.0005+(newy*newzoom))-newy);
