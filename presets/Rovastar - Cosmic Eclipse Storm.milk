PSVERSION_COMP=2
[preset00]
fDecay=0.988
fGammaAdj=1.7
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.26
mv_a=0.0
ob_r=0.01
ob_size=0.5
warp=0.01
wave_b=0.65
wave_g=0.65
wave_r=0.65
bAdditiveWaves=1.0
fVideoEchoZoom=1.0
nVideoEchoOrientation=3.0
fWaveAlpha=4.099998
nMotionVectorsX=1.0
nMotionVectorsY=48.0
fWaveParam=0.05
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=bass_effect = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_1=wave_r=(0.5+(0.5*sin(floor((time)/(3)))));
per_frame_2=wave_b=(0.5+(0.5*sin((time*47))));
per_frame_3=wave_g=(0.65+(0.1*sin((time*0.23))));
per_frame_4=bass_effect=max(0, (max(bass_att, bass)-1));
per_frame_5=bass_effect=(if(abs(above(bass_effect, 0))>0.00001,1,0));
per_frame_6=treb_effect=max(0, (max(treb_att, treb)-1));
per_frame_7=treb_effect=(if(abs(above(treb_effect, 0))>0.00001,1,0));
per_frame_8=wave_mystery=((0.05+floor((bass_effect)/(50)))-floor((treb_effect)/(50)));
per_frame_9=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_10=q1=bass_thresh;
per_pixel_1=rot=(if(abs(equal(q1, 2))>0.00001,floor((log((sqrt(2)-rad)))/(2)),floor((-log((sqrt(2)-rad)))/(10))));
per_pixel_2=zoom=(1-(0.1*log((sqrt(2)-rad))));
