per_frame_init_4=beg_for_mercy = 0;
per_frame_1=wave_r=(wave_r+(0.250*((0.60*sin((2.137*time)))+(0.40*sin((1.770*time))))));
per_frame_2=wave_g=(wave_g+(0.300*((0.60*sin((1.944*time)))+(0.40*sin((1.541*time))))));
per_frame_3=flip=bnot(((frame)%(mid_att)));
per_frame_4=flop=bnot(((frame)%(bass_att)));
per_frame_5=flap=bnot(((frame)%(treb_att)));
per_frame_6=rot=(((rot+(0.1*flip))-(0.1*flop))+((sign((wave_g-0.5))*flap)*0.1));
per_frame_7=cx=(cx+(0.410*((0.60*sin((0.374*time)))+(0.40*sin((0.294*time))))));
per_frame_8=cy=(cy+(0.410*((0.60*sin((0.393*time)))+(0.40*sin((0.223*time))))));
per_frame_9=dx=(dx+(0.010*((0.60*sin((0.234*time)))+(0.40*sin((0.277*time))))));
per_frame_10=dy=(dy+(0.010*((0.60*sin((0.284*time)))+(0.40*sin((0.247*time))))));
per_frame_11=decay=(decay-(0.01*equal(((frame)%(6)), 0)));
per_frame_12=wave_x=(wave_x+rot);
per_frame_13=wave_y=(wave_y+rot);
per_frame_14=sx=(sx+rot);
per_frame_15=sy=(sy-rot);
per_frame_16=cx=(cx+rot);
per_frame_17=cy=(cy-rot);
per_frame_18=beg_for_mercy=(beg_for_mercy+rot);
per_frame_19=zoom=(zoom+(rot*sin((beg_for_mercy*1.618))));
per_frame_20=warp=((flip+flop)+flap);
