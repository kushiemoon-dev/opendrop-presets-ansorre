nMotionVectorsY=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=thresh = 0;
per_frame_init_2=dx_r = 0;
per_frame_init_3=dy_r = 0;
per_frame_1=zoom=(zoom-(0.005*sin(bass)));
per_frame_2=wave_a=(2*bass);
per_frame_3=ob_a=(0.9*bass);
per_frame_4=ib_a=(0.9*bass);
per_frame_5=wave_r=(wave_r+(2*bass));
per_frame_6=wave_b=(wave_b-(2*bass));
per_frame_7=wave_g=0;
per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=rot=(rot+((0.06*((0.3-rad)*thresh))*sin((2.2*time))));
per_pixel_5=dy=(dy+(2*((((dy_r*0.3)*sqrt((2-rad)))*sqr((2*rad)))*sin((6*bass)))));
per_pixel_6=dx=(dx+(2*((((dx_r*0.3)*sqrt((2-rad)))*sqr((2*rad)))*sin((6*treb)))));
per_pixel_7=zoom=(zoom+(if(abs(above(thresh, 0.5))>0.00001,-0.03,0.03)));
per_pixel_8=cx=(cx+(10*dx_r));
per_pixel_9=cy=(cy+(10*dy_r));
