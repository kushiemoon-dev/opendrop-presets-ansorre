PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
dx=1e-05
dy=1e-05
fDecay=0.999
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.312747
fWaveSmoothing=0.0
ib_a=0.4
ib_b=1.0
ib_g=1.0
ib_r=0.0
ib_size=0.02
mv_a=0.0
mv_l=1.0
nWaveMode=2.0
ob_a=0.03
ob_b=0.8
ob_size=0.005
warp=0.01
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.0201
fWaveAlpha=100.0
