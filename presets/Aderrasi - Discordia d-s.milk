per_pixel_9=sx=(sx-((((1.5*above(x, (0.5*cos((1.1*time)))))*above(y, (0.5*cos((1.1*time)))))*dx_r)*mid));
per_pixel_10=sy=(sy-((((1.5*above(x, (0.5*sin((2.1*time)))))*above(y, (0.5*sin((2.1*time)))))*dy_r)*mid));
per_pixel_11=sx=(sx-((((1.5*below(x, (0.5*sin((0.5*time)))))*above(y, (0.5*sin((0.5*time)))))*dx_r)*volt));
per_pixel_12=sy=(sy-((((1.5*below(x, (0.5*cos(time))))*above(y, (0.5*cos(time))))*dy_r)*volt));
per_pixel_13=zoom=(zoom-(0.025*rad));
