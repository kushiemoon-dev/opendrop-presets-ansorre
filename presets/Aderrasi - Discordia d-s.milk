per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=volt=floor((((treb_att+mid_att)+bass_att))/(3));
per_pixel_5=sx=(sx-((((1.5*above(x, (0.5*sin(time))))*below(y, (0.5*sin(time))))*dx_r)*bass));
per_pixel_6=sy=(sy-((((1.5*above(x, (0.5*sin((1.25*time)))))*below(y, (0.5*sin((1.25*time)))))*dy_r)*bass));
per_pixel_7=sx=(sx-((((1.5*below(x, (0.5*sin((1.18*time)))))*below(y, (0.5*sin((1.18*time)))))*dx_r)*treb));
