per_frame_init_1=bass_mod = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=split = 0;
per_frame_init_4=state = 0;
per_frame_1=warp=0;
per_frame_2=state=(if(abs(above(bass_att, 1.3))>0.00001,3,(if(abs(above(treb_att, 1.3))>0.00001,2,1))));
per_frame_3=wave_r=(if(abs(equal(state, 2))>0.00001,(0.2+(0.2*sin(time))),(if(abs(equal(state, 3))>0.00001,(0.9+(0.1*sin(time))),(0.6+(0.08*sin(time)))))));
per_frame_4=wave_g=(if(abs(equal(state, 2))>0.00001,0,(if(abs(equal(state, 3))>0.00001,0,0.49))));
per_frame_5=wave_b=(if(abs(equal(state, 2))>0.00001,(0.9+(0.1*sin((time*0.888)))),0));
per_frame_6=q1=state;
per_frame_7=wave_mystery=(0+(if(abs(above(sin((time*0.8)), 0))>0.00001,sin((time*0.4)),-sin((time*0.4)))));
per_frame_8=zoom=(zoom+(wave_mystery*0.01));
per_frame_9=wave_y=(wave_y+(0.25*sin((time*0.8))));
per_pixel_1=bass_mod=(if(abs(equal(q1, 3))>0.00001,-1,1));
per_pixel_2=split=(0.8+((0.2*sin(floor((time)/(2))))*bass_mod));
per_pixel_3=rot=((rot+(if(abs(above(sin(abs(ang)), split))>0.00001,-rot,0.05)))*bass_mod);
per_pixel_4=zoom=(1+(abs((1-(if(abs(above(sin(abs(ang)), split))>0.00001,0.98,zoom))))*bass_mod));
