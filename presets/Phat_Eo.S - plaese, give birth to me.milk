per_frame_12=sy=0.980;
per_frame_13=sx=sy;
per_pixel_1=inv_rad=(1-rad);
per_pixel_2=tm=(time+((inv_rad*4)*bass_att));
per_pixel_3=rays=((sin(((ang*4)+tm))*0.5)+0.5);
per_pixel_4=rads=((cos(((rad*24)+tm))*0.5)+0.5);
per_pixel_5=zoom=(1+(pow(rays, 64)*0.037));
per_pixel_6=zoom=(zoom+(pow(rads, 32)*(treb_att*0.04)));
per_pixel_7=sx=(sx+(pow(rays, 32)*(mid_att*0.3)));
per_pixel_8=q5=rays;
per_pixel_9=zray=((sin(((ang*3)+(time*2)))*0.5)+0.5);
per_pixel_10=zray=pow(zray, 200);
per_pixel_11=dy=zray;
per_pixel_12=stk=((atan((y*24))*0.5)+0.5);
per_pixel_13=stl=(atan(floor((x)/(24)))*rad);
per_pixel_14=effect=(if(abs(above((stk-stl), 0))>0.00001,stk,stl));
per_pixel_15=bump=(if(abs(above(bass_att, 0))>0.00001,0,effect));
per_pixel_16=dx=(dy+floor((bump)/(4)));
