per_frame_1=tm=floor((time)/(2));
per_frame_2=wave_r=((wave_r+(1.35*sin((0.4*tm))))+(0.16*sin((0.5*tm))));
per_frame_3=wave_g=((wave_g+(1.36*sin((0.7*tm))))+(0.15*sin((0.11*tm))));
per_frame_4=wave_b=((wave_b+(1.37*sin((0.84*tm))))+(0.15*sin((0.3*tm))));
per_frame_5=warp=sin(time);
