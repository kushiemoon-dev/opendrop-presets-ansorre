bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=debased = 0;
per_frame_1=wave_r=(wave_r-(2*tan((0.6*time))));
per_frame_2=wave_g=(wave_g-(2*tan((0.2*mid))));
per_frame_3=wave_b=(wave_b-(2*tan((0.77*bass))));
per_pixel_1=zoom=(zoom+(0.02*sin(rad)));
per_pixel_2=zoom=(zoom-(0.02*cos((-12*sin(ang)))));
per_pixel_3=warp=0;
per_pixel_4=debased=sqrt(min(((bass-bass_att)*0.25), ((treb-treb_att)*0.25)));
per_pixel_5=rot=(rot+(if(abs(above(bass, 1.2))>0.00001,0.05,0)));
per_pixel_6=zoom=(zoom-(floor((debased)/(7.6))*sin(time)));
per_pixel_7=zoom=(zoom+(if(abs(below(rad, 0.05))>0.00001,0.1,0)));
