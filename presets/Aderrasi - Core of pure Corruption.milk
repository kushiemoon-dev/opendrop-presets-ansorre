MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveThick=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.149766
fWaveSmoothing=0.9
ib_a=0.05
ib_b=0.0
ib_g=0.0
ib_r=1.0
ib_size=0.055
mv_a=0.0
mv_l=1.0
ob_a=0.05
ob_g=0.3
ob_r=0.9
ob_size=0.05
warp=0.01
fVideoEchoZoom=1.0
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
fZoomExponent=0.999997
nMotionVectorsX=0.0
nMotionVectorsY=0.0
