per_frame_init_1=timer_base = 0;
per_frame_init_2=sx_temp = 0;
per_frame_init_3=grid = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sy_temp = 0;
per_frame_init_6=centerx = 0;
per_frame_init_7=wave_size = 0;
per_frame_init_8=crad = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=q3 = 0;
per_frame_init_11=centery = 0;
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.001);
per_frame_3=dy=(dy-0.001);
per_frame_4=wave_r=(wave_r+(if(abs(above(bass_att, 1.4))>0.00001,1,(0.49*sin((time*2))))));
per_frame_5=wave_g=(wave_g+(if(abs(above(bass_att, 1.4))>0.00001,0,(if(abs(above(treb_att, 1.4))>0.00001,1,(0.49*sin((time*3))))))));
per_frame_6=wave_b=(wave_b+(if(abs(above(treb_att, 1.4))>0.00001,0,(0.49*sin(time)))));
per_frame_7=timer_base=0.5;
per_frame_8=q1=sin(((time*timer_base)*4));
per_frame_9=q2=sin(((time*timer_base)*2));
per_frame_10=q3=sin((time*timer_base));
per_frame_11=rot=(if(abs(above(q1, 0))>0.00001,(if(abs(above(q2, 0))>0.00001,0.1,-0.1)),0));
per_frame_12=zoom=((zoom+(0.05*q2))+(0.05*q1));
per_frame_13=wave_mystery=((wave_mystery+(0.7*q1))+(0.3*q2));
per_frame_14=wave_size=(wave_size+(0.5*q3));
per_frame_15=cx=(cx+(0.2*q1));
per_frame_16=cy=(cy+(0.2*q3));
per_pixel_1=centerx=0.5;
per_pixel_2=centery=0.5;
per_pixel_3=crad=(abs((rad-0.5))*q2);
per_pixel_4=grid=(((abs(((x*10)-5)))%(2))+((abs(((y*10)-5)))%(2)));
per_pixel_5=sx_temp=(if(abs(equal(grid, 0))>0.00001,(if(abs(above(x, centerx))>0.00001,((sx-crad)-centerx),((sx+crad)-centerx))),sx));
per_pixel_6=sy_temp=(if(abs(equal(grid, 0))>0.00001,(if(abs(above(y, centery))>0.00001,((sy-crad)-centery),((sy+crad)-centery))),sy));
per_pixel_7=sx=(if(abs(below(q1, 0))>0.00001,(sx-((sx_temp*q2)*0.1)),sx));
per_pixel_8=sy=(if(abs(below(q1, 0))>0.00001,(sy-((sx_temp*q2)*0.1)),sy));
