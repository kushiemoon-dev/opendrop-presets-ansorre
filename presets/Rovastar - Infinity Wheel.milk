shapecode_3_enabled=0.0
per_frame_init_1=blue = 0;
per_frame_init_2=red_aim = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_init_5=bass_on = 0;
per_frame_init_6=treb_thresh = 0;
per_frame_init_7=treb_on = 0;
per_frame_init_8=bass_effect = 0;
per_frame_init_9=green = 0;
per_frame_init_10=red = 0;
per_frame_init_11=blue_aim = 0;
per_frame_init_12=swapcolour = 0;
per_frame_init_13=green_aim = 0;
per_frame_1=warp=0;
per_frame_2=mv_r=(0.7-(0.2*sin((time*0.683))));
per_frame_3=mv_b=(0.9+(0.1*sin((time*0.832))));
per_frame_4=mv_g=(0.2+(0.17*sin((time*1.03))));
per_frame_5=q1=max((max(bass, bass_att)-1.15), 0);
per_frame_6=rot=(abs((0.05*sin(time)))-bass_effect);
per_frame_7=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_8=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.75)+1.5)));
per_frame_9=bass_on=above(bass_thresh, 1.8);
per_frame_10=treb_on=above(treb_thresh, 1.9);
per_frame_11=swapcolour=(bass_on-treb_on);
per_frame_12=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,1,(if(abs(equal(swapcolour, 0))>0.00001,1,0))));
per_frame_13=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0.5,0.25))));
per_frame_14=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,1))));
per_frame_15=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,0.65,0.45))));
per_frame_16=green=(green+((green_aim-green)*0.5));
per_frame_17=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.45,0.65))));
per_frame_18=wave_r=(red+(0.2*green));
per_frame_19=wave_g=(0.15*green);
per_frame_20=wave_b=(green+blue);
per_pixel_1=zoom=((0.4+atan(((atan(rad)*1.5)*rad)))+q1);
per_pixel_2=zoomexp=(1-rad);
