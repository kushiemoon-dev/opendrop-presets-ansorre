MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fGammaAdj=1.5
fWarpScale=2.853
fWaveScale=2.201646
fWaveSmoothing=0.9
mv_a=0.0
nWaveMode=6.0
warp=0.0
wave_b=0.0
wave_g=0.5
zoom=1.064
fWaveAlpha=1.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=blue = 0;
per_frame_init_2=red_aim = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_init_4=bass_on = 0;
per_frame_init_5=treb_thresh = 0;
per_frame_init_6=treb_on = 0;
per_frame_init_7=green = 0;
per_frame_init_8=red = 0;
per_frame_init_9=blue_aim = 0;
per_frame_init_10=swapcolour = 0;
per_frame_init_11=green_aim = 0;
per_frame_1=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_2=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.75)+1.5)));
per_frame_3=bass_on=above(bass_thresh, 1.8);
per_frame_4=treb_on=above(treb_thresh, 1.9);
per_frame_5=swapcolour=(bass_on-treb_on);
per_frame_6=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,1,(if(abs(equal(swapcolour, 0))>0.00001,1,0))));
per_frame_7=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0.5,0.25))));
per_frame_8=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,1))));
per_frame_9=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,0.65,0.45))));
per_frame_10=green=(green+((green_aim-green)*0.5));
per_frame_11=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.45,0.65))));
per_frame_12=wave_r=red;
per_frame_13=wave_g=green;
per_frame_14=wave_b=blue;
per_frame_15=zoom=(zoom+(0.013*((0.60*sin((0.339*time)))+(0.40*sin((0.276*time))))));
per_frame_16=rot=(rot+(0.040*((0.60*sin((0.381*time)))+(0.40*sin((0.579*time))))));
per_frame_17=decay=(decay-(0.01*equal(((frame)%(50)), 0)));
per_frame_18=zoom=(zoom+((bass_att-1)*0.1));
