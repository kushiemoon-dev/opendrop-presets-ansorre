per_frame_1=beatb=above(bass, bass_att);
per_frame_2=beatbhard=(if(abs(beatb)>0.00001,(bass-(bass_att*0.9)),beatbhard));
per_frame_3=beatm=above(mid, mid_att);
per_frame_4=beatmhard=(if(abs(beatm)>0.00001,(mid-(mid_att*0.9)),beatmhard));
per_frame_5=beatt=above(treb, treb_att);
