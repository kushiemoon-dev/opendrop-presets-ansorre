MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWaveScale=0.01
wave_b=0.1
wave_g=0.1
wave_r=0.1
bMotionVectorsOn=0.0
fWaveParam=-0.52
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=ray = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=(wave_r+(bass*0.3));
per_frame_3=wave_g=(wave_g+(treb*0.3));
per_frame_4=wave_b=(wave_b+(mid*0.3));
per_frame_5=dx=(dx-0.001);
per_frame_6=dy=(dy-0.001);
per_frame_7=rot=(0.1*sin((time*0.05)));
per_frame_8=decay=0.5;
per_pixel_1=ray=(3.1415926*pow(rad, 2));
per_pixel_2=zoom=((if(abs(above(rad, 0.8))>0.00001,0,sin(((ray*0.1)*time))))+(2*tan((((ang*2)+(time*1))+sin((time*0.5))))));
