per_pixel_1=dx=(if(abs(equal(q1, 0))>0.00001,(if(abs(above(x, 0.5))>0.00001,floor((sin((0.5-x)))/(15)),floor(((log(floor((1)/(x)))/2.302585092994046))/(45)))),0));
per_pixel_2=dy=(if(abs(equal(q1, 1))>0.00001,(if(abs(above(y, 0.5))>0.00001,floor((sin((0.5-y)))/(10)),floor(((log(floor((1)/(y)))/2.302585092994046))/(35)))),0));
