per_frame_9=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,(0.55+abs(floor((sin(floor((time)/(2))))/(10)))),0.45))));
per_frame_10=green=(green+((green_aim-green)*0.5));
per_frame_11=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.35,0.7))));
per_frame_12=wave_g=green;
per_frame_13=wave_b=blue;
per_frame_14=wave_r=red;
per_frame_15=mybass=(if(abs(above((bass+bass_att), 2.1))>0.00001,(bass+bass_att),0));
