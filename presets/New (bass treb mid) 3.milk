per_frame_1=old_bass=(bass-1);
per_frame_2=old_treb=(treb-1);
per_frame_3=old_mid=(mid-1);
per_frame_4=old_vol=(vol-1);
per_frame_5=vol_att=((bass_att+treb_att)+mid_att);
per_frame_6=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*((bass_thresh-1.3)+1.3)));
per_frame_7=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*((treb_thresh-1.3)+1.3)));
per_frame_8=mid_thresh=((above(mid_att, mid_thresh)*2)+((1-above(mid_att, mid_thresh))*((mid_thresh-1.3)+1.3)));
per_frame_9=temp_bass=(old_bass+(if(abs(above(old_bass, new_bass))>0.00001,bnot(bass),bnot(temp_bass))));
per_frame_10=temp_treb=(old_treb+(if(abs(above(old_treb, new_treb))>0.00001,bnot(treb),bnot(temp_treb))));
per_frame_11=temp_mid=(old_mid+(if(abs(above(old_mid, new_mid))>0.00001,bnot(mid),bnot(temp_mid))));
per_frame_12=new_bass_thresh=(((above(bass_att, new_bass_thresh)*2)+((1-above(bass_att, new_bass_thresh))*((new_bass_thresh-1.3)+1.3)))+above(bass, bass_att));
per_frame_13=new_treb_thresh=(((above(treb_att, new_treb_thresh)*2)+((1-above(treb_att, new_treb_thresh))*((new_treb_thresh-1.3)+1.3)))+above(treb, treb_att));
per_frame_14=new_mid_thresh=(((above(mid_att, new_mid_thresh)*2)+((1-above(mid_att, new_mid_thresh))*((new_mid_thresh-1.3)+1.3)))+above(mid, mid_att));
per_frame_15=new_bass=((temp_bass+bass_thresh)+bass_att);
per_frame_16=new_treb=((temp_treb+treb_thresh)+treb_att);
per_frame_17=new_mid=((temp_mid+mid_thresh)+mid_att);
per_frame_18=q1=new_bass;
per_frame_19=q2=new_treb;
per_frame_20=q3=new_mid;
per_frame_21=q4=new_bass_thresh;
