per_frame_4=ob_b=abs(sin(floor((time)/(2))));
per_frame_5=ib_r=abs(cos(floor((time)/(3))));
per_frame_6=ib_g=abs(cos(floor((time)/(3))));
per_frame_7=ib_b=abs(cos(floor((time)/(3))));
per_frame_8=q1=(if(abs(above(abs((ob_size-ib_size)), 0.15))>0.00001,9,0.8));
per_frame_9=ob_size=abs(floor((sin(floor((time)/((5*q1)))))/(5)));
per_frame_10=ib_size=(0.17-ob_size);
per_frame_11=volume=floor((((bass+mid)+treb))/(3));
per_frame_12=upbeat=(if(abs(above(treb_att, (last_treb*1.3)))>0.00001,1,0));
per_frame_13=downbeat=(if(abs(above(bass_att, (last_bass*1.3)))>0.00001,1,0));
per_frame_14=last_bass=bass_att;
per_frame_15=last_treb=treb_att;
per_frame_16=beat=(if(abs(above(beatcount, floor((14)/(volume))))>0.00001,1,0));
per_frame_17=beatcount=(if(abs(above(beatcount, floor((14)/(volume))))>0.00001,0,((beatcount+upbeat)+downbeat)));
per_frame_18=dx=(beat+floor((sin(floor((time)/(4.4))))/(5)));
per_frame_19=dy=(beat+floor((cos(floor((time)/(3.6))))/(5)));
per_pixel_1=rot=-sin(floor((time)/(5.3)));
