per_frame_init_9=q3 = 0;
per_frame_1=brot=(brot+(0.035*bass));
per_frame_2=mrot=(mrot+(0.035*mid));
per_frame_3=trot=(trot+(0.035*treb));
per_frame_4=wave_x=(0.15+(0.7*sqr(sin((0.6*mrot)))));
per_frame_5=wave_y=(0.15+(0.7*sqr(sin((0.47*mrot)))));
per_frame_6=wave_r=sqr(sin((1.7*brot)));
per_frame_7=wave_g=sqr(sin((1.8*brot)));
per_frame_8=wave_b=sqr(sin((1.9*brot)));
per_frame_9=q1=sqr(sin((0.3*mrot)));
per_frame_10=q2=sqr(sin((0.21*trot)));
per_frame_11=q3=sqr(sin(((0.17*brot)+(0.05*mrot))));
per_frame_12=q4=sqr(sin(((0.11*trot)+(0.06*mrot))));
per_frame_13=mv_dx=(0.02*bass);
per_frame_14=mvrot=(if(abs(above((bass+treb), 4.4))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0,(mvrot+1))),mvrot));
per_frame_15=mv_r=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.039,(if(abs(equal(mvrot, 3))>0.00001,0.137,0.835)))),(if(abs(above(mvrot, 1))>0.00001,0.651,(if(abs(equal(mvrot, 0))>0.00001,1,0.773))))));
per_frame_16=mv_g=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.267,(if(abs(equal(mvrot, 3))>0.00001,0.886,0.176)))),(if(abs(above(mvrot, 1))>0.00001,0.804,(if(abs(equal(mvrot, 0))>0.00001,1,0.38))))));
per_frame_17=mv_b=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.694,(if(abs(equal(mvrot, 3))>0.00001,0.776,0.851)))),(if(abs(above(mvrot, 1))>0.00001,0.114,(if(abs(equal(mvrot, 0))>0.00001,1,0.145))))));
per_pixel_1=partone=equal(above(sin((x*18.85)), 0), above(sin((y*12.57)), 0));
per_pixel_2=cx=(if(abs(partone)>0.00001,q1,q3));
per_pixel_3=cy=(if(abs(partone)>0.00001,q2,q4));
per_pixel_4=rot=(0.007*(if(abs(partone)>0.00001,(bass+mid),(-treb-mid))));
