fWaveScale=3.109081
mv_b=0.4
mv_g=0.4
nWaveMode=5.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
zoom=1.0201
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.0065
nVideoEchoOrientation=1.0
fWaveAlpha=0.7999
nMotionVectorsX=64.0
nMotionVectorsY=48.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=floon = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=flarn = 0;
per_frame_init_4=state = 0;
per_frame_init_5=bass_effect = 0;
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.0005);
per_frame_3=dy=(dy-0.0005);
per_frame_4=state=(if(abs(above(bass_att, mid))>0.00001,(if(abs(above(bass_att, treb_att))>0.00001,3,2)),(if(abs(above(treb_att, mid))>0.00001,2,1))));
per_frame_5=wave_r=(wave_r+(if(abs(equal(state, 3))>0.00001,(0.5*sin(bass)),(0.5*sin((time*0.777))))));
per_frame_6=wave_g=(wave_g+(if(abs(equal(state, 2))>0.00001,(0.5*sin(treb)),(0.5*sin((time*0.888))))));
per_frame_7=wave_b=(wave_b+(0.5*sin(time)));
per_frame_8=q1=state;
per_frame_9=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_10=mv_l=(3*bass_effect);
per_frame_11=mv_r=(0.8+(0.19*sin((time*0.678))));
per_frame_12=mv_g=(0.2+(0.199*cos((time*1.023))));
per_pixel_1=floon=(if(abs(equal(q1, 3))>0.00001,-0.1,(if(abs(equal(q1, 2))>0.00001,2,1))));
per_pixel_2=flarn=sin((((ang*10)+(1.5*time))+abs((((pow((1-rad), q1)*32))%(2)))));
per_pixel_3=zoom=(zoom+((0.007*flarn)*floon));
per_pixel_4=rot=(rot+((0.07*flarn)*floon));
