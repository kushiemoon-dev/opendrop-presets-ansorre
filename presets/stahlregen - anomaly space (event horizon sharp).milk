per_frame_5=count=(count+1);
per_frame_6=bc=(bc+bass);
per_frame_7=tc=(tc+treb);
per_frame_8=mc=(mc+mid);
per_frame_9=bb=((0.5*bd)+(0.5*bass_att));
per_frame_10=bt=((0.5*bt)+(0.5*treb_att));
per_frame_11=mt=((0.5*mt)+(0.5*mid_att));
per_frame_12=bimp=(if(abs(above((3*bass), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_13=timp=(if(abs(above((3*treb), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_14=mimp=(if(abs(above((3*mid), ((bass+treb)+mid)))>0.00001,1,0));
per_frame_15=is_beat=(if(abs(above((bb*0.9), floor((bc)/(count))))>0.00001,(1*bimp),(if(abs(above((bt*0.9), floor((tc)/(count))))>0.00001,(1*timp),(if(abs(above((mt*0.9), floor((mc)/(count))))>0.00001,(1*mimp),0))))));
per_frame_16=is_beat=(if(abs(above(reha, 0))>0.00001,0,is_beat));
per_frame_17=reha=(if(abs(is_beat)>0.00001,(fps*0.25),(if(abs(below(reha, 1))>0.00001,0,(reha-1)))));
per_frame_18=xrand=(if(abs(is_beat)>0.00001,(0.2+floor((int(rand(600)))/(1000))),xrand));
per_frame_19=xpos=(xpos+floor(((bass_att*(xrand-xpos)))/(40)));
per_frame_20=yrand=(if(abs(is_beat)>0.00001,(0.2+floor((int(rand(600)))/(1000))),yrand));
per_frame_21=ypos=(ypos+floor(((bass_att*(yrand-ypos)))/(40)));
per_frame_22=dx=floor(((2*xpos))/(ypos));
per_frame_23=dy=floor(((2*ypos))/(xpos));
per_frame_24=monitor=floor((xrand)/(yrand));
