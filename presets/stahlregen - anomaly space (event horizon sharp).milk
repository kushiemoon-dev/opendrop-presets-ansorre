per_frame_26=q2=ypos;
per_pixel_1=ceny=q1;
per_pixel_2=cenx=q2;
per_pixel_3=brad=(2*sqrt((pow((x-cenx), 2)+pow((y-ceny), 2))));
per_pixel_4=c=1000;
per_pixel_5=sx=((0.85-(1.8*((1-brad)+(brad*sigmoid((-brad+0.45), c)))))+(0.33*((1-brad)+(brad*sigmoid((brad-1.6), -c)))));
per_pixel_6=sy=((0.85-(1.8*((1-brad)+(brad*sigmoid((-brad+0.45), c)))))+(0.33*((1-brad)+(brad*sigmoid((brad-1.6), -c)))));
