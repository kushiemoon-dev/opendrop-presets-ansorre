per_frame_init_1=whirl = 0;
per_frame_1=wave_r=11;
per_frame_2=wave_g=-11;
per_frame_3=wave_b=-11;
per_frame_4=ob_size=(0.1+(0.1*cos((8*time))));
per_frame_5=zoom=(zoom+(0.5*tan((0.05*bass))));
per_frame_6=zoom=(zoom+0.01);
per_pixel_1=whirl=(0.1+(0.1*cos((8*time))));
per_pixel_2=dy=(dy+(if(abs(above(y, 0.5))>0.00001,(0.0025*sin(bass)),0)));
per_pixel_3=dy=(dy+(if(abs(below(y, 0.5))>0.00001,(-0.0025*sin(bass)),0)));
per_pixel_4=dx=(dx+(if(abs(above(y, 0.4))>0.00001,(if(abs(below(y, 0.6))>0.00001,(if(abs(above(x, 0.5))>0.00001,(-0.02*bass),0)),0)),0)));
per_pixel_5=dx=(dx+(if(abs(above(y, 0.4))>0.00001,(if(abs(below(y, 0.6))>0.00001,(if(abs(below(x, 0.5))>0.00001,(0.02*bass),0)),0)),0)));
per_pixel_6=warp=(warp+(if(abs(below(y, 0.2))>0.00001,(if(abs(below(whirl, 0.1))>0.00001,(1*bass),0)),0)));
per_pixel_7=warp=(warp+(if(abs(above(y, 0.8))>0.00001,(if(abs(below(whirl, 0.1))>0.00001,(1*bass),0)),0)));
per_pixel_8=dy=(dy+(if(abs(above(x, 0.3))>0.00001,(if(abs(below(x, 0.7))>0.00001,(if(abs(below(whirl, 0.05))>0.00001,(if(abs(below(y, 0.5))>0.00001,(0.025*bass),0)),0)),0)),0)));
per_pixel_9=dy=(dy+(if(abs(above(x, 0.3))>0.00001,(if(abs(below(x, 0.7))>0.00001,(if(abs(below(whirl, 0.05))>0.00001,(if(abs(above(y, 0.5))>0.00001,(-0.025*bass),0)),0)),0)),0)));
per_pixel_10=rot=(rot+(if(abs(above(whirl, 0.1))>0.00001,((0.1*bass)*sin(time)),0.0)));
