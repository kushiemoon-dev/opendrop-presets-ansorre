shape_0_per_frame1=yrapidness=0.01;
shape_0_per_frame2=nowdiff=(treb_att-bass_att);
shape_0_per_frame3=backdiff=nowdiff;
shape_0_per_frame4=nowdiff=(if(abs(above(nowdiff, 1))>0.00001,1,nowdiff));
shape_0_per_frame5=nowdiff=(if(abs(below(nowdiff, -1))>0.00001,-1,nowdiff));
shape_0_per_frame6=steadiff=(if(abs(equal(steadiff, nowdiff))>0.00001,nowdiff,steadiff));
shape_0_per_frame7=steadiff=(if(abs(below(steadiff, nowdiff))>0.00001,(steadiff+(yrapidness*(nowdiff-steadiff))),steadiff));
shape_0_per_frame8=steadiff=(if(abs(above(steadiff, nowdiff))>0.00001,(steadiff-(yrapidness*(steadiff-nowdiff))),steadiff));
shape_0_per_frame9=threshold=(0.24-(0.3*steadiff));
shape_0_per_frame10=beat=(if(abs(above((treb+bass), 1.4))>0.00001,(if(abs(below(beat, 0.02))>0.00001,(if(abs(above((bass+mid), ((mid_att+threshold)+(bass_att+threshold))))>0.00001,1,beat)),beat)),beat));
shape_0_per_frame11=beat=(beat*0.8);
shape_0_per_frame12=a=beat;
shape_0_per_frame13=a2=beat;
