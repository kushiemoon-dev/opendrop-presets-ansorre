per_frame_1=wave_x=(wave_x+(if(abs(above(wave_y, 0.75))>0.00001,(-0.1*tan(time)),(0.1*tan(time)))));
per_frame_2=wave_y=(wave_y+(0.40*cos((2*mid))));
