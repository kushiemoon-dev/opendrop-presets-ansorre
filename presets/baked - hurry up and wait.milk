per_frame_1=wave_a=0;
per_frame_2=ob_r=(2*(time*0.7));
per_frame_3=ob_b=(2*(time*0.6));
per_frame_4=ob_g=(2*(time*0.9));
per_frame_5=basstemp=((bass+bass_att)+bass_thresh);
per_frame_6=trebtemp=((treb+treb_att)+treb_thresh);
per_frame_7=trasstemp=max(basstemp, trebtemp);
per_frame_8=trassave=floor((trasstemp)/(3));
per_frame_9=basst=max((bass+bass_att), (treb+treb_att));
per_frame_10=trebb=min((basst+bass_thresh), (basst+treb_thresh));
per_frame_11=midbeat=floor((trebb)/(3));
per_frame_12=midtb=max((midbeat+mid), (midbeat+mid_att));
per_frame_13=mtb=floor((midtb)/(2.25));
per_frame_14=decay=0.989;
per_frame_15=warp=(trassave*0.05);
per_frame_16=zoom=(zoom+-0.06);
per_pixel_1=basstemp=((bass+bass_att)+bass_thresh);
per_pixel_2=trebtemp=((treb+treb_att)+treb_thresh);
per_pixel_3=trasstemp=max(basstemp, trebtemp);
per_pixel_4=trassave=floor((trasstemp)/(3));
per_pixel_5=dx=(cos((trassave*2.1))*0.03);
per_pixel_6=dy=(sin((-trassave*2.1))*0.008);
per_pixel_7=sx=1;
per_pixel_8=sy=1.01;
per_pixel_9=basst=max((bass+bass_att), (treb+treb_att));
per_pixel_10=trebb=min((basst+bass_thresh), (basst+treb_thresh));
per_pixel_11=midbeat=floor((trebb)/(3));
per_pixel_12=midtb=max((midbeat+mid), (midbeat+mid_att));
per_pixel_13=mtb=floor((midtb)/(2.25));
per_pixel_14=cy=floor(((floor(((mtb+trassave))/(-trassave))*mtb))/(10));
per_pixel_15=cx=floor(((mtb+trassave))/(1));
