per_frame_4=bass_on=(if(abs(above(bass_att, 1.2))>0.00001,1,0));
per_frame_5=treb_on=(if(abs(above(treb_att, 1.2))>0.00001,1,0));
per_frame_6=state=((1+(if(abs(equal(bass_on, 1))>0.00001,1,0)))+(if(abs(equal(treb_on, 1))>0.00001,2,0)));
per_frame_7=wave_r=(wave_r+((0.25*((0.6*sin((0.784*time)))+(0.4*sin((0.986*time)))))*state));
per_frame_8=wave_g=(wave_g+((0.25*((0.6*sin((0.671*time)))+(0.4*sin((1.164*time)))))*(4-state)));
per_frame_9=wave_b=(wave_b+((0.25*((0.6*sin((1.423*time)))+(0.4*sin((0.687*time)))))*floor((4)/(state))));
per_frame_10=wave_y=(if(abs(equal(state, 1))>0.00001,(wave_y+((int(rand(10))*0.1)*sin((time*3)))),wave_y));
per_frame_11=bass_effect=(if(abs(above(bass_att, 1.4))>0.00001,(0.1*bass_att),(0.1*mid_att)));
per_frame_12=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,(-0.1*treb_att),(-0.1*mid_att)));
per_frame_13=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,bass_effect,treb_effect));
per_frame_14=rot=net_effect;
per_frame_15=wave_mystery=(wave_mystery+((0.2*state)*sin((time*2))));
per_frame_16=wave_x=(wave_x-(wave_mystery*0.2));
per_frame_17=q1=state;
per_pixel_1=zoom=(if(abs(below(rad, (mid_att*0.5)))>0.00001,(zoom+((if(abs(equal(sin(ang), 0))>0.00001,-0.1,0.1))*(if(abs(above(q1, 1))>0.00001,(if(abs(above(q1, 2))>0.00001,-1,1)),0)))),(zoom-(0.13*sin(((ang*q1)+(time*2)))))));
per_pixel_2=rot=(if(abs(below(rad, (mid_att*0.5)))>0.00001,-rot,rot));
