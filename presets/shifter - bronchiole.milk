per_frame_1=warp=0;
per_frame_2=tic=min((time-tin), 0.1);
per_frame_3=tin=time;
per_frame_4=vol=(((bass_att+treb_att)+mid_att)*0.333333);
per_frame_5=ra=(floor((1)/(tic))*0.25);
per_frame_6=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_7=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_8=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_9=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_10=tt=(tt+(tic*treb));
per_frame_11=mt=(mt+(tic*mid));
per_frame_12=bt=(bt+(tic*bass));
per_frame_13=vt=(vt+((tic*(((bass*bass)+(mid*mid))+(treb*treb)))*0.3333));
per_frame_14=zoom=1;
per_frame_15=ti=(time*3);
per_frame_16=ib_r=(0.5+(0.5*sin((ti*1.123))));
per_frame_17=ib_g=(0.5+(0.5*sin((ti*1.456))));
per_frame_18=ib_b=(0.5+(0.5*sin((ti*1.789))));
per_frame_19=q7=(0.5+(0.3*sin(vt)));
per_frame_20=q8=(0.5+(0.3*sin((vt*2.6546))));
per_pixel_1=mx=(x-q7);
per_pixel_2=my=(y-q8);
per_pixel_3=mx=(mx+(equal(mx, 0)*0.000001));
per_pixel_4=ra=(pow(((mx*mx)+((my*my)*0.5625)), 0.5)*4);
per_pixel_5=zm=((ra*ra)+0.0001);
per_pixel_6=zm=(1-floor((1)/(zm)));
per_pixel_7=dx=(zm*(x-q7));
per_pixel_8=dy=(zm*(y-q8));
