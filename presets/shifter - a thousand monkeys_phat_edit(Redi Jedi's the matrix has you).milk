per_frame_1=db=((bass-lbass)*fps);
per_frame_2=lbass=bass;
per_frame_3=avgdb=((avgdb*0.99)+(abs(db)*0.01));
per_frame_4=rawbeatb=above(abs(db), avgdb);
per_frame_5=beatb=(rawbeatb*above((time-lbbtime), (avgbbeatrate*0.75)));
per_frame_6=beatbhard=(beatb*(abs(db)-(avgdb*5)));
per_frame_7=avgbbeatrate=((beatb*((avgbbeatrate*0.9)+((time-lbbtime)*0.1)))+((1-beatb)*(avgbbeatrate+((3-avgbbeatrate)*0.00001))));
per_frame_8=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_9=ph=(((time-lbbtime)*floor((60)/(avgbbeatrate)))*const);
per_frame_10=phase=max(min(ph, 1), 0);
per_frame_11=const=((const*(1-beatb))+(beatb*(const+(0.01*bool))));
per_frame_12=bool=((below(phase, 0.98)*(0.99-ph))-(above(phase, 0.98)*(ph*0.5)));
per_frame_13=bc=(bc+beatb);
per_frame_14=vol=((rawbeatb*abs(db))*0.001);
per_frame_15=avgvol=((avgvol*0.999)+(vol*0.01));
per_frame_16=mtime=(mtime+((min((treb_att*0.01), 0.25)-(beatbhard*0.01))*floor((1)/(fps))));
per_frame_17=mtime2=(mtime2+((min((avgdb*0.01), 0.25)+(beatbhard*0.01))*floor((1)/(fps))));
per_frame_18=warp=0;
per_frame_19=zoom=1;
per_frame_20=gamma=(1+(db*0.01));
