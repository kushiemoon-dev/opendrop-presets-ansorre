per_frame_29=q8=mtime2;
per_frame_30=monitor=q3;
per_frame_31=dy=(0.00009*q3);
per_frame_32=tdy=(tdy+(dy*floor((50)/(fps))));
per_frame_33=q6=(1-above(tdy, 0.06));
per_frame_34=tdy=(if(abs((1-q6))>0.00001,0,tdy));
