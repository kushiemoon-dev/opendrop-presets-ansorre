per_frame_1=wave_g=(wave_g+(0.200*((0.60*sin((0.900*time)))+(0.40*sin((0.956*time))))));
per_frame_2=wave_b=(wave_b+(0.200*((0.60*sin((0.910*time)))+(0.40*sin((0.920*time))))));
per_frame_3=warp=0;
per_frame_4=volume=(0.15*(((bass_att+bass)+mid)+mid_att));
per_frame_5=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_6=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_7=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_8=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_9=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_10=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_11=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_12=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_13=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_14=beatcounter=(if(abs(above(progress, 0.01))>0.00001,(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter)),0));
per_frame_15=beatcounter=(if(abs(above(beatcounter, 7))>0.00001,0,beatcounter));
per_frame_16=beateven=((beatcounter)%(2));
per_frame_17=ob_r=(if(abs(beat)>0.00001,(0.3+(0.1*beatcounter)),0));
per_frame_18=ob_g=(if(abs(beat)>0.00001,mv_b,0));
per_frame_19=ob_b=(if(abs(beat)>0.00001,(0.3+(0.1*beatcounter)),0));
per_frame_20=ob_size=(if(abs(beat)>0.00001,(3*ob_size),ob_size));
per_frame_21=wave_r=(if(abs(above(beateven, 1))>0.00001,1,0));
per_frame_22=ib_r=(if(abs(beateven)>0.00001,(0.2+(0.1*beatcounter)),0));
per_frame_23=ib_b=(if(abs(beateven)>0.00001,(0.2+(0.1*beatcounter)),0));
per_frame_24=ib_r=(if(abs(beateven)>0.00001,(0.2+(0.1*beatcounter)),0));
per_frame_25=mv_g=(if(abs(beateven)>0.00001,(1-(0.12*beatcounter)),(0.15+(0.15*sin((time*0.7981))))));
per_frame_26=mv_r=(if(abs(beateven)>0.00001,(1-(0.12*beatcounter)),(0.15+(0.15*sin((time*0.8391))))));
per_frame_27=mv_b=(if(abs(beateven)>0.00001,(0.12*beatcounter),(0.15+(0.15*sin((time*0.564))))));
