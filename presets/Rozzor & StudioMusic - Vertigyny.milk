per_frame_init_8=q2 = 0;
per_frame_init_9=vol_mean = 0;
per_frame_1=slowtime=(slowtime+(beat*time));
per_frame_2=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_3=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_4=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
per_frame_5=ib_r=sin(cos((slowtime*0.235)));
per_frame_6=ib_g=sin(cos((slowtime*0.335)));
per_frame_7=ib_b=sin(cos((slowtime*0.435)));
per_frame_8=redneg=(if(abs(below(ib_r, 0))>0.00001,1,0));
per_frame_9=greenneg=(if(abs(below(ib_g, 0))>0.00001,1,0));
per_frame_10=blueneg=(if(abs(below(ib_b, 0))>0.00001,1,0));
per_frame_11=ib_r=(1-(if(abs(redneg)>0.00001,(if(abs(bor(greenneg, blueneg))>0.00001,1,(1+ib_r))),ib_r)));
per_frame_12=ib_g=(1-(if(abs(greenneg)>0.00001,(if(abs(equal((greenneg+blueneg), 2))>0.00001,1,(1+ib_g))),ib_g)));
per_frame_13=ib_b=(1-(if(abs(blueneg)>0.00001,(1+ib_b),ib_b)));
per_frame_14=ff=floor((slowtime)/(100));
per_frame_15=wave_r=(floor((sin(floor(((5*ff))/(bass))))/(2))+0.5);
per_frame_16=wave_g=(floor((cos(floor((ff)/(mid))))/(2))+0.5);
per_frame_17=wave_b=(floor((cos(floor(((3*ff))/(treb))))/(2))+0.5);
per_frame_18=rot=(rot+(0.040*((0.60*sin((0.381*slowtime)))+(0.40*sin((0.579*slowtime))))));
per_frame_19=zoom=max(0.97, min((0.15+(0.7*bass_att)), 1.75));
per_frame_20=ob_r=sin((beat*cos((slowtime*0.735))));
per_frame_21=ob_g=sin((bass*cos((slowtime*0.635))));
per_frame_22=ob_b=sin((bass*cos((slowtime*0.535))));
per_frame_23=redneg=(if(abs(below(ob_r, 0))>0.00001,1,0));
per_frame_24=greenneg=(if(abs(below(ob_g, 0))>0.00001,1,0));
per_frame_25=blueneg=(if(abs(below(ob_b, 0))>0.00001,1,0));
per_frame_26=ob_r=(1-(if(abs(redneg)>0.00001,(if(abs(bor(greenneg, blueneg))>0.00001,1,(1+ob_r))),ob_r)));
per_frame_27=ob_g=(1-(if(abs(greenneg)>0.00001,(if(abs(equal((greenneg+blueneg), 2))>0.00001,1,(1+ob_g))),ob_g)));
per_frame_28=ob_b=(1-(if(abs(blueneg)>0.00001,(1+ob_b),ob_b)));
per_pixel_1=q2=above(rad, 0.603);
per_pixel_2=rot=(rot+(if(abs(q2)>0.00001,0,(sin((time*0.7243))*0.5))));
per_pixel_3=zoom=(zoom+(if(abs(q2)>0.00001,0,((rad*sin((time*0.734)))*0.8))));
per_pixel_4=warp=(warp+(if(abs(above(rad, 0.2166))>0.00001,sin((ang*rad)),0)));
