per_pixel_1=bass_factor=((0.45+(0.15*bass))+att);
per_pixel_2=rot=(if(abs(below(rad, bass_factor))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_3=zoom=(if(abs(below(rad, bass_factor))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
per_pixel_4=warp=(if(abs(below(rad, bass_factor))>0.00001,0,warp));
