per_frame_init_7=q2 = 0;
per_frame_init_8=q4 = 0;
per_frame_1=q1=(if(abs(above(bass, 1.5))>0.00001,above(bass, 0.8),-above(0.4, bass)));
per_frame_2=q2=(if(abs(above(treb, 1.5))>0.00001,above(treb, 0.8),-above(0.4, treb)));
per_frame_3=q3=(if(abs(above(mid, 1.5))>0.00001,above(mid, 0.8),-above(0.4, mid)));
per_frame_4=q4=((q1+q2)+q3);
per_frame_5=wave_r=(wave_r+(0.10*sin(q2)));
per_frame_6=wave_b=(wave_b-(0.20*sin(q1)));
per_frame_7=wave_g=(above(q1, q2)+0.2);
per_frame_8=zoom=(zoom+(0.10*sin(q3)));
per_frame_9=rot=(rot*sin((q1+q2)));
per_frame_10=ob_r=(ob_r-(0.20*sin((q3+q2))));
per_frame_11=ob_b=(ob_b+(0.20*cos((q2-q3))));
per_frame_12=ob_g=(ob_g*sin(q3));
per_pixel_1=right_most=(0.8*sin(x));
per_pixel_2=left_most=(-0.8*sin(x));
per_pixel_3=top=(0.8*sin(y));
per_pixel_4=bottom=(0.8*sin(y));
per_pixel_5=dy=((((top*sin((q3*0.23)))*bottom)*sin((q3*0.42)))*x);
per_pixel_6=dx=((((right_most*sin((q1+q2)))*left_most)*sin((q3+q1)))*x);
per_pixel_7=rot=((((if(abs(above(q1, (q2-0.2)))>0.00001,((rot*rad)*sin(q2)),((-rot*rad)*cos(q4))))*rad)*ang)*above(q2, q4));
per_pixel_8=sx=(sx+((0.200*sin(q2))*y));
per_pixel_9=sy=(sy-((0.200*sin(q4))*x));
per_pixel_10=cx=(0.500-(0.090*sin((q2*x))));
per_pixel_11=cy=(0.500+(0.090*sin((q3*x))));
