MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bDarken=1.0
dx=-0.012
fDecay=0.999
fGammaAdj=1.0
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWaveScale=0.10049
fWaveSmoothing=0.9
warp=0.01
wave_b=0.0
wave_r=0.0
wave_x=0.9
fVideoEchoZoom=0.999609
fWaveAlpha=100.0
nMotionVectorsX=64.0
nMotionVectorsY=3.984009
fWaveParam=-0.484
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=sin_beat = 0;
per_frame_init_2=long_beat = 0;
per_frame_init_3=vol_now = 0;
per_frame_init_4=mysign = 0;
per_frame_init_5=cycle = 0;
per_frame_init_6=rozzorrate = 0;
per_frame_init_7=thanks_to_rovastar = 0;
per_frame_init_8=beat_max = 0;
per_frame_init_9=bass_effect = 0;
per_frame_init_10=new_beat = 0;
per_frame_init_11=beat_min = 0;
per_frame_init_12=initframe = 0;
per_frame_init_13=beat_rate = 0;
per_frame_init_14=myframe = 0;
per_frame_init_15=myendframe = 0;
per_frame_init_16=beat = 0;
per_frame_init_17=last_beat_rate = 0;
per_frame_init_18=beatcount = 0;
per_frame_init_19=basseffect = 0;
per_frame_1=bass_effect=thanks_to_rovastar;
per_frame_2=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_3=vol_now=(4*bass_effect);
per_frame_4=beat_max=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,max(beat_max, vol_now)));
per_frame_5=beat_min=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,min(beat_min, vol_now)));
per_frame_6=beat_rate=(if(abs(equal(((frame)%(50)), 0))>0.00001,0,(beat_rate+beat)));
per_frame_7=last_beat_rate=(if(abs(equal(((frame)%(50)), 49))>0.00001,(if(abs(above(beat_rate, 10))>0.00001,(if(abs(below(beat_rate, 30))>0.00001,beat_rate,last_beat_rate)),last_beat_rate)),last_beat_rate));
per_frame_8=last_beat_rate=max(last_beat_rate, (10*beat_min));
per_frame_9=beat=(if(abs(above(vol_now, ((0.035*last_beat_rate)*(beat_max-beat_min))))>0.00001,1,0));
per_frame_10=sin_beat=sin((beat_max-vol_now));
per_frame_11=mysign=(if(abs(above(sin_beat, 0.1))>0.00001,1,-1));
per_frame_12=myframe=(if(abs(above(0.2, sin_beat))>0.00001,frame,0));
per_frame_13=myframe=(if(abs(above(myendframe, frame))>0.00001,0,myframe));
per_frame_14=myendframe=(if(abs(above(0.2, sin_beat))>0.00001,(myframe+100),myendframe));
per_frame_15=long_beat=((mysign*10)*sin((myendframe-myframe)));
per_frame_16=cycle=(if(abs(equal(long_beat, 0))>0.00001,(long_beat+1.57),long_beat));
per_frame_17=new_beat=(if(abs(above(sin_beat, 0.55))>0.00001,1,0));
per_frame_18=warp=0;
per_frame_19=dx=(dx-0.0005);
per_frame_20=dy=(dy-0.0005);
per_frame_21=basseffect=max((max(bass, bass_att)-1), 0);
per_frame_22=mv_y=(4-min((((bass_att+bass)-2)*0.25), 0.9));
per_frame_23=mv_r=(basseffect*4);
per_frame_24=mv_b=(basseffect*3);
per_frame_25=mv_g=(basseffect*3.5);
per_frame_26=wave_y=(if(abs(beat)>0.00001,0.5,0.4));
per_frame_27=beatcount=(beatcount+beat);
per_frame_28=initframe=(if(abs(below(beatcount, 1))>0.00001,frame,initframe));
per_frame_29=rozzorrate=floor(((frame-initframe))/(beatcount));
per_frame_30=monitor=rozzorrate;
