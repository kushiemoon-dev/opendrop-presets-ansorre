per_frame_1=warp=0;
per_frame_2=wave_r=min(1, max(0, (0.2*bass)));
per_frame_3=wave_g=min(1, max(0, (0.2*mid)));
per_frame_4=wave_b=min(1, max(0, (0.2*treb)));
per_frame_5=ib_g=(abs(sin((0.1*time)))*0.2);
per_frame_6=ib_b=(abs(sin((0.3*time)))*0.2);
per_frame_7=ib_r=(abs(sin((0.7*time)))*0.2);
per_frame_8=ob_g=min(1, max(0, (0.2*treb)));
per_frame_9=ob_r=min(1, max(0, (0.2*mid)));
per_frame_10=ob_b=min(1, max(0, (0.2*bass)));
per_frame_11=xmovn=((0.01*floor(int(rand(6))))-0.03);
per_frame_12=ymovn=((0.01*floor(int(rand(6))))-0.03);
per_frame_13=xmov=(if(abs(beat)>0.00001,xmovn,xmov));
per_frame_14=ymov=(if(abs(beat)>0.00001,ymovn,ymov));
per_frame_15=q1=oldx;
per_frame_16=q2=oldy;
per_frame_17=out_x=bor(above((q1+xmov), 0.8), below((q1+xmov), 0.2));
per_frame_18=out_y=bor(above((q2+ymov), 0.8), below((q2+ymov), 0.2));
per_frame_19=xmov=(xmov+((-2*xmov)*out_x));
per_frame_20=ymov=(ymov+((-2*ymov)*out_y));
per_frame_21=wave_x=(q1+xmov);
per_frame_22=wave_y=(q2+ymov);
per_frame_23=q1=wave_x;
per_frame_24=q2=wave_y;
per_frame_25=oldx=q1;
per_frame_26=oldy=q2;
per_frame_27=decay=(decay-(0.91*treble));
per_frame_28=volume=((0.3*bass)+mid);
per_frame_29=beatrate=(equal(beatrate, 0)+((1-equal(beatrate, 0))*(below(volume, 0.01)+((1-below(volume, 0.01))*beatrate))));
per_frame_30=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_31=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_32=peakbass_att=max(bass_att, peakbass_att);
per_frame_33=beat=((above(volume, 0.8)*above(bass_att, (meanbass_att*1.2)))*above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))));
per_frame_34=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_35=monitor=beatrate;
per_pixel_1=mrad=(pow((pow((x-q1), 2)+pow((y-(1-q2)), 2)), 0.5)*pow(2, 0.5));
per_pixel_2=cx=q1;
per_pixel_3=cy=(1-q2);
per_pixel_4=rot=((if(abs(above(mrad, (0.485+(bass*0.2))))>0.00001,(if(abs(below(rad, (0.515+(bass*0.2))))>0.00001,((floor(int(rand(30)))-15)*0.012),0)),0))+(if(abs(above(mrad, 0.185))>0.00001,(if(abs(below(rad, 0.215))>0.00001,((floor(int(rand(30)))-15)*0.012),0)),((mrad+(1*y))+(0.4*sin(above(bass, 1.4)))))));
per_pixel_5=zoom=(zoom-((above((mrad-0.2), 0)*0.05)*mrad));
