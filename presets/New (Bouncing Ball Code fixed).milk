per_frame_19=direction=(if(abs(above(wave_x_mod, (right_extreme-0.5)))>0.00001,-1,(if(abs(below(wave_x_mod, (left_extreme-0.5)))>0.00001,1,direction))));
per_frame_20=bounce=(((below(wave_y_mod, 0)+equal(wave_y_mod, 0))+above(wave_y_mod, (top_extreme-bottom_extreme)))+equal(wave_y_mod, (top_extreme-bottom_extreme)));
per_frame_21=x_speed=(((x_speed*(if(abs(equal(bounce, 0))>0.00001,1,x_speed_loss)))*(if(abs(above(wave_x_mod, (right_extreme-0.5)))>0.00001,x_speed_loss,(if(abs(below(wave_x_mod, (left_extreme-0.5)))>0.00001,x_speed_loss,1)))))*(if(abs(equal(y_speed, 0))>0.00001,x_speed_loss,1)));
per_frame_22=wave_x_mod=(wave_x_mod+(direction*x_speed));
per_frame_23=wave_x=(wave_x+wave_x_mod);
per_frame_24=y_speed=((y_speed-(if(abs(equal(bounce, 0))>0.00001,(if(abs(equal(y_speed_loss, 1))>0.00001,0,gravity)),(2*y_speed))))-(equal(y_speed_loss, 1)*gravity));
per_frame_25=y_speed=(if(abs(above(wave_y_mod, 0))>0.00001,(if(abs(below(wave_y_mod, 0.001))>0.00001,(if(abs(below(abs(y_speed), (gravity*1.01)))>0.00001,0,y_speed)),y_speed)),(if(abs(below(y_speed, 0))>0.00001,(-y_speed*0.9),y_speed))));
per_frame_26=wave_y_mod=(wave_y_mod+y_speed);
per_frame_27=wave_y=(bottom_extreme+wave_y_mod);
