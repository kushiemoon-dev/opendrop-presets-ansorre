per_frame_9=wave_g=(((wave_g*0.3)*sin((1.7*time)))*bass_att);
per_frame_10=dx=(dx+(if(abs(above(change, 1))>0.00001,(if(abs(below(change, 2))>0.00001,((0.03*sin(bass_att))-(0.04*sin(treb_att))),0)),0)));
per_frame_11=dy=(dy+(if(abs(above(change, 1))>0.00001,(if(abs(below(change, 2))>0.00001,((0.03*sin(mid_att))-(0.04*cos(mid_att))),0)),0)));
