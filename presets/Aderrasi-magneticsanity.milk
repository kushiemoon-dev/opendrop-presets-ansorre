per_frame_3=change=((2*sin((5*bass_att)))-(2*cos((5*treb_att))));
per_frame_4=warp=(warp+(if(abs(above(change, -2))>0.00001,(if(abs(below(change, -1))>0.00001,2,0)),0)));
