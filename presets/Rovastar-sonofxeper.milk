shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=wave_mystery=floor((time)/(2));
per_frame_3=wave_g=(wave_r-floor((sin((time*3)))/(2)));
per_frame_4=wave_r=abs(wave_mystery);
per_frame_5=wave_b=(0.5+floor((sin(floor((time)/(10))))/(2)));
per_pixel_1=rot=((0.1*sin(pow(sin(-ang), 5)))+0.25);
per_pixel_2=zoom=((1+abs((0.1*sin((ang*7)))))+(0.1*bass_att));
per_pixel_3=sx=((0.1*rot)+1);
per_pixel_4=sy=(floor((rot)/(9))+1);
