MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveDots=1.0
bWaveThick=1.0
fWaveScale=1.868316
fWaveSmoothing=0.72
ib_a=1.0
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.005
mv_a=0.0
ob_a=1.0
ob_size=0.035
wave_b=0.5
wave_g=0.5
wave_r=0.5
fWaveAlpha=1.315701
fWaveParam=-0.5
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=((-1)&(bass));
per_frame_3=wave_g=((-1)&(treb));
per_frame_4=wave_b=(if(abs(below(wave_r, 1))>0.00001,(if(abs(below(wave_g, 1))>0.00001,1,0)),0));
per_frame_5=q1=(0.475*(bass+bass_att));
per_frame_6=ib_a=(treb-0.8);
per_frame_7=ob_a=(mid-0.8);
per_frame_8=ib_r=(1-wave_b);
per_frame_9=ib_g=(1-wave_r);
per_frame_10=ib_b=(1-wave_g);
per_pixel_1=zoom=(if(abs(above(rad, 0.275))>0.00001,((rad*0.1)+q1),(1+(0.1*rad))));
