per_frame_init_1=myvolume = 0;
per_frame_1=myvolume=min(floor((((bass+mid)+treb))/(3)), 2.5);
per_frame_2=wave_mystery=((wave_mystery-0.75)+(0.75*sin(myvolume)));
per_frame_3=zoom=(zoom+(0.03*(myvolume-0.6)));
per_frame_4=wave_x=(wave_x+(0.1*sin((5*time))));
per_frame_5=wave_y=(wave_y+(0.1*cos((5*time))));
per_frame_6=wave_r=((wave_r+(0.5*sin((1.2*time))))+(2*sin((bass*2))));
per_frame_7=wave_g=((wave_g+(0.5*sin((1.3*time))))+(2*sin((mid*2))));
per_frame_8=wave_b=((wave_b+(0.5*sin((2*time))))+(2*sin((treb*2))));
per_frame_9=zoom=(zoom+0.001);
per_frame_10=dx=(dx-(0.0006*sin(time)));
per_frame_11=dy=(dy-(0.0006*cos(time)));
per_pixel_1=warp=(warp+(if(abs(above(rad, 0.8))>0.00001,((0.2*bass)-rad),0)));
per_pixel_2=dx=(dx+(if(abs(below(x, 0.5))>0.00001,(0.001*rad),(-0.001*rad))));
per_pixel_3=dy=(dy+(if(abs(below(y, 0.5))>0.00001,(0.001*rad),(-0.001*rad))));
per_pixel_4=rot=(rot+(if(abs(below(rad, 0.5))>0.00001,(0.05*(((((floor((-rad)/(bass))*2.1)*rad)*sin(treb))*-rad)*cos(bass))),0)));
