per_frame_1=bass_2=(above((bass+1), (bass_att+1))+(if(abs(equal(bass, bass_att))>0.00001,1,0)));
per_frame_2=treb_2=(above((treb+1), (treb_att+1))+(if(abs(equal(bass, bass_att))>0.00001,1,0)));
