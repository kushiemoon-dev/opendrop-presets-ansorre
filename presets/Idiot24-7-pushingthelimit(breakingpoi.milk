per_frame_16=ob_b=(if(abs(above(bass, bass_att))>0.00001,(0.60*sin((time*0.42))),(0.40*sin(bass))));
per_pixel_1=dx=((dx+((0.10*(if(abs(above(bass, mid_att))>0.00001,((dx+rad)-log(rad)),((dx+rad)-log((rad-(0.2*sin(((ang+(0.2*sin(time)))-(ang*sin(time)))))))))))*sin((bass+time))))+(0.01*sin(above(bass, bass_att))));
per_pixel_2=dy=((dx+((0.10*(if(abs(above(treb, bass_att))>0.00001,((dx+rad)-log(rad)),((dx+rad)-log((rad-(0.2*sin(((ang+(0.2*sin(time)))-(ang*sin(time)))))))))))*sin((mid+time))))+(0.01*sin(above(treb, treb_att))));
