per_frame_init_13=wave_r_b = 0;
per_frame_1=zoom=(zoom+(0.20*sin((treb-bass))));
per_frame_2=mv_a=(mv_a*sin(treb));
per_frame_3=mv_x=(mv_x+(5*sin(mid)));
per_frame_4=mv_y=(mv_y+(5*sin(mid)));
per_frame_5=mv_r_b=wave_r_b;
per_frame_6=mv_r_b=((wave_r*wave_b)*sin(time));
per_frame_7=mv_r_b=mid;
per_frame_8=mv_g=(wave_g*sin(time));
per_frame_9=mv_r=(wave_r_b*sin(time));
per_frame_10=bass_max=max(bass, bass_att);
per_frame_11=treb_max=max(treb, treb_att);
per_frame_12=mid_max=max(mid, mid_att);
per_frame_13=min_bass=min(bass, bass_att);
per_frame_14=min_treb=min(treb, treb_att);
per_frame_15=min_mid=min(mid, mid_att);
per_frame_16=max_beat=((bass_max*treb_max)*mid_max);
per_frame_17=min_beat=((min_bass*min_treb)*min_mid);
per_frame_18=beat=((max_beat*min_beat)-max(max_beat, min_beat));
per_frame_19=q1=beat;
per_frame_20=wave_x=(mid_att*treb);
per_frame_21=wave_x=(wave_x*bass);
per_frame_22=ib_r=(wave_x*bass);
per_frame_23=mv_l=(wave_g*treb);
per_frame_24=wave_g=(mid_att*mid);
per_frame_25=wave_mystery=(time*wave_b);
per_frame_26=ob_g=(mid-wave_b);
per_frame_27=ob_g=(ob_g*bass);
per_frame_28=decay=(treb*bass);
per_frame_29=ob_g=(ob_g*wave_g);
per_frame_30=decay=(if(abs(below(decay, 0.0))>0.00001,0.0,decay));
per_frame_31=decay=(if(abs(above(decay, 5.0))>0.00001,5.0,decay));
per_frame_32=wave_g=(if(abs(below(wave_g, 0.0))>0.00001,0.0,wave_g));
per_frame_33=wave_g=(if(abs(above(wave_g, 1.0))>0.00001,1.0,wave_g));
per_frame_34=wave_x=(if(abs(below(wave_x, 0.0))>0.00001,0.0,wave_x));
per_frame_35=wave_x=(if(abs(above(wave_x, 1.0))>0.00001,1.0,wave_x));
per_frame_36=wave_mystery=(if(abs(below(wave_mystery, -1.0))>0.00001,-1.0,wave_mystery));
per_frame_37=wave_mystery=(if(abs(above(wave_mystery, 1.0))>0.00001,1.0,wave_mystery));
per_frame_38=ob_g=(if(abs(below(ob_g, 0.0))>0.00001,0.0,ob_g));
per_frame_39=ob_g=(if(abs(above(ob_g, 1.0))>0.00001,1.0,ob_g));
