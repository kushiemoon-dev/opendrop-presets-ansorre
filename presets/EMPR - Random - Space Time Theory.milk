per_frame_51=wave_g=(if(abs(above(wave_g, 1.0))>0.00001,1.0,wave_g));
per_frame_52=ob_g=(if(abs(below(ob_g, 0.0))>0.00001,0.0,ob_g));
per_frame_53=ob_g=(if(abs(above(ob_g, 1.0))>0.00001,1.0,ob_g));
per_frame_54=ib_r=(if(abs(below(ib_r, 0.0))>0.00001,0.0,ib_r));
per_frame_55=ib_r=(if(abs(above(ib_r, 1.0))>0.00001,1.0,ib_r));
per_pixel_1=rot=(ang*5);
per_pixel_2=newrad=(((rad*pow(1, 2))*(if(abs(below(1, 2))>0.00001,1,0)))*rad);
per_pixel_3=rot=(warp-ang);
per_pixel_4=zoom=(sx*zoomexp);
per_pixel_5=sy=(sy*sy);
per_pixel_6=zoomexp=(time*zoomexp);
per_pixel_7=rot=(rot*ang);
per_pixel_8=rot=(rot-sy);
per_pixel_9=cx=(zoomexp*y);
per_pixel_10=dx=(sy*newrad);
per_pixel_11=dy=(warp+x);
per_pixel_12=cy=(warp+time);
per_pixel_13=zoom=(if(abs(below(zoom, 0.01))>0.00001,0.01,zoom));
per_pixel_14=zoom=(if(abs(above(zoom, 100))>0.00001,100,zoom));
per_pixel_15=zoomexp=(if(abs(below(zoomexp, 0.01))>0.00001,0.01,zoomexp));
per_pixel_16=zoomexp=(if(abs(above(zoomexp, 100.0))>0.00001,100.0,zoomexp));
per_pixel_17=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_18=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_19=cx=(if(abs(below(cx, -1.0))>0.00001,-1.0,cx));
per_pixel_20=cx=(if(abs(above(cx, 2.0))>0.00001,2.0,cx));
per_pixel_21=cy=(if(abs(below(cy, -1.0))>0.00001,-1.0,cy));
per_pixel_22=cy=(if(abs(above(cy, 2.0))>0.00001,2.0,cy));
per_pixel_23=dx=(if(abs(below(dx, -1))>0.00001,-1,dx));
per_pixel_24=dx=(if(abs(above(dx, 1.0))>0.00001,1.0,dx));
per_pixel_25=dy=(if(abs(below(dy, -1))>0.00001,-1,dy));
per_pixel_26=dy=(if(abs(above(dy, 1.0))>0.00001,1.0,dy));
