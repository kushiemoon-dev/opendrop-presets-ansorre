per_frame_13=bass_effect=min(max((max(bass, bass_effect)-1.3), 0), 0.5);
per_frame_14=ib_size=(ib_size+bass_effect);
per_frame_15=wave_mystery=(wave_mystery+(0.4*bass_effect));
