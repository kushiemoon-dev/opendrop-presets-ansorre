per_frame_17=q1=bass_effect;
per_pixel_1=zoom=(0.9-(sin((time+(ang*2)))*0.02));
per_pixel_2=zoom=(zoom+(q1*0.1));
per_pixel_3=rot=(rot+((0.1*q1)*(3.14-ang)));
