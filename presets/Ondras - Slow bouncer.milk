per_frame_1=ob_r=((1+sin(time))*0.5);
per_frame_2=zmena_x=bor(above(x, (1-delka_x)), below(x, 0));
per_frame_3=zmena_y=bor(above(y, (1-delka_y)), below(y, 0));
per_frame_4=smer_x=(((zmena_x*smer_x)*-1)+(smer_x*(1-zmena_x)));
per_frame_5=smer_y=(((zmena_y*smer_y)*-1)+(smer_y*(1-zmena_y)));
per_frame_6=x=(x+(smer_x*speed_x));
per_frame_7=y=(y+(smer_y*speed_y));
per_frame_8=wave_x=(x+(delka_x*0.5));
per_frame_9=wave_y=((1-y)-(delka_y*0.5));
per_frame_10=q1=x;
per_frame_11=q2=y;
per_frame_12=q3=delka_x;
per_frame_13=q4=delka_y;
per_pixel_1=action=(((above(x, q1)*below(x, (q1+q3)))*above(y, q2))*below(y, (q2+q4)));
per_pixel_2=neakce_x=(0.003*sin(time));
per_pixel_3=akce_x=0;
per_pixel_4=neakce_y=(0.003*sin((2*time)));
per_pixel_5=akce_y=0;
per_pixel_6=dx=((action*akce_x)+((1-action)*neakce_x));
per_pixel_7=dy=((action*akce_y)+((1-action)*neakce_y));
per_pixel_8=rot=((0.1*(1-action))+(sin(time)*0.02));
per_pixel_9=zoom=(0.95+(action*0.05));
