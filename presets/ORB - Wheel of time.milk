MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bSolarize=1.0
fDecay=1.0
mv_a=0.0
ob_b=1.0
ob_g=1.0
ob_r=1.0
warp=0.000521
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=1.16
nVideoEchoOrientation=3.0
fWaveAlpha=0.001
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=1.0
wavecode_0_a=0.5
wave_0_init1=zs = 0;
wave_0_init2=speed = 0;
wave_0_init3=q1 = 0;
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=basstime = 0;
per_frame_init_2=stickybit = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sample1 = 0;
per_frame_init_6=difftime = 0;
per_frame_init_7=diff = 0;
per_frame_init_8=edge = 0;
per_frame_init_9=basstime2 = 0;
per_frame_init_10=volavg = 0;
per_frame_init_11=bit2 = 0;
per_frame_init_12=vol = 0;
per_frame_init_13=q2 = 0;
per_frame_init_14=q3 = 0;
per_frame_init_15=basssum = 0;
per_frame_init_16=sample2 = 0;
per_frame_1=basstime=(basstime+(bass*0.03));
per_frame_2=basstime2=(basstime+(bass*0.03));
per_frame_3=q1=basstime2;
per_frame_4=basstime=(if(abs(below(basstime, 465))>0.00001,465,basstime));
per_frame_5=basstime=(if(abs(above(basstime, 515))>0.00001,465,basstime));
per_frame_6=basstime=(basstime+(bass_att*0.03));
per_frame_7=vol=pow(((bass+mid)+treb), 2);
per_frame_8=basssum=vol;
per_frame_9=stickybit=((time)%(2));
per_frame_10=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_11=sample1=(sample1+equal(stickybit, 1));
per_frame_12=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_13=sample2=(sample2+equal(stickybit, 0));
per_frame_14=edge=bnot(equal(bit2, stickybit));
per_frame_15=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_16=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_17=sample1=(sample1-((sample1*edge)*stickybit));
per_frame_18=sample2=(sample2-((sample2*edge)*equal(stickybit, 0)));
per_frame_19=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(floor((volavg2)/(sample2)))),0));
per_frame_20=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(floor((volavg)/(sample1)))),diff));
per_frame_21=q3=diff;
per_frame_22=bit2=((time)%(2));
per_frame_23=difftime=(difftime+(diff*0.03));
per_frame_24=q2=difftime;
per_frame_25=difftime=(if(abs(above(difftime, 2000))>0.00001,0,difftime));
per_frame_26=monitor=q1;
per_pixel_1=zoom=(1+((((q3*0.1)*rad)*rad)*3));
per_pixel_2=rot=(((rad-q3)*q3)*0.1);
