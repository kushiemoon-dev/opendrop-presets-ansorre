[preset00]
fDecay=0.975
fModWaveAlphaEnd=1.95
fModWaveAlphaStart=0.85
fWaveScale=0.054279
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
nWaveMode=6.0
ob_a=1.0
ob_size=0.005
wave_b=0.3
wave_g=0.3
wave_r=0.3
fVideoEchoZoom=1.0
fWaveAlpha=1.0
bMotionVectorsOn=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=dominant = 0;
per_frame_init_2=bass_plus = 0;
per_frame_init_3=mid_plus = 0;
per_frame_init_4=treb_plus = 0;
per_frame_1=warp=0;
per_frame_2=dx=-0.0005;
per_frame_3=dy=-0.0005;
per_frame_4=dominant=(if(abs(above(bass_att, mid_att))>0.00001,(if(abs(above(bass_att, treb_att))>0.00001,1,3)),(if(abs(above(mid_att, treb_att))>0.00001,2,3))));
per_frame_5=bass_plus=(if(abs(equal(dominant, 1))>0.00001,0.3,(if(abs(equal(dominant, 2))>0.00001,0,-0.1))));
per_frame_6=mid_plus=(if(abs(equal(dominant, 1))>0.00001,-0.1,(if(abs(equal(dominant, 2))>0.00001,0,-0.1))));
per_frame_7=treb_plus=(if(abs(equal(dominant, 1))>0.00001,-0.1,(if(abs(equal(dominant, 2))>0.00001,0,0.3))));
per_frame_8=wave_r=((0.3+(bass*bass_plus))+(0.125*((0.6*sin((0.784*time)))+(0.4*sin((0.986*time))))));
per_frame_9=wave_g=((0.3+(mid*mid_plus))+(0.125*((0.6*sin((0.671*time)))+(0.4*sin((1.164*time))))));
per_frame_10=wave_b=((0.2+(treb*treb_plus))+(0.125*((0.6*sin((1.423*time)))+(0.4*sin((0.687*time))))));
per_frame_11=zoom=(if(abs(above(bass_att, 1.4))>0.00001,pow(1.2, bass_att),1));
per_pixel_1=rot=(if(abs(below(y, 0.5))>0.00001,0.05,(if(abs(above(y, 0.5))>0.00001,0.05,0))));
