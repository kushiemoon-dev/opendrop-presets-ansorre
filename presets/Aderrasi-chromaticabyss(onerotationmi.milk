per_frame_7=cx=(cx+((5*rot)*sin(time)));
per_frame_8=cy=(cy+((5*rot)*cos(time)));
per_pixel_1=sx=(sx+(if(abs(above(rad, (0.52+(0.07*sin(time)))))>0.00001,0.05,-0.01)));
