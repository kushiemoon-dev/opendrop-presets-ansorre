per_frame_1=wave_r=(wave_r+(((0.5*sin((5*bass)))*time)*5));
per_frame_2=wave_b=(wave_b+(((0.5*sin((5*treb)))*time)*5));
per_frame_3=wave_g=(wave_g+(((0.5*sin((5*mid)))*time)*5));
per_frame_4=wave_x=(wave_x+(0.30*sin((2.5*time))));
per_frame_5=wave_y=(wave_y+(0.30*cos((2.5*time))));
