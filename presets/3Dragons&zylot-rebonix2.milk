per_frame_3=timer=(if(abs(equal(changer, 1))>0.00001,10,(timer-0.1)));
per_frame_4=setter=(if(abs(equal(changer, 0))>0.00001,(if(abs(below(timer, 1))>0.00001,0,1)),1));
per_frame_5=changer=(if(abs(equal(setter, 0))>0.00001,(if(abs(below(random, 20))>0.00001,1,(if(abs(above(random, 80))>0.00001,1,0)))),0));
per_frame_6=speed=(if(abs(equal(setter, 0))>0.00001,((int(rand(55))*0.1)-1),speed));
per_frame_7=wave_mystery=(if(abs(above(((frame)%(2)), 0))>0.00001,wave_mystery,(-0.45+(bass*0.05))));
per_frame_8=wave_x=(if(abs(above(((frame)%(2)), 0))>0.00001,0.5,(0.5+(0.2*sin((time*speed))))));
per_frame_9=wave_y=(if(abs(above(((frame)%(2)), 0))>0.00001,0.5,(0.5+(0.265*cos((time*speed))))));
per_frame_10=monitor=timer;
per_frame_11=wave_r=(if(abs(equal(((frame)%(2)), 0))>0.00001,((0.2+(0.2*sin((time*0.888))))+(bass*0.5)),1));
per_frame_12=wave_g=(if(abs(equal(((frame)%(2)), 0))>0.00001,((0.2+(0.2*sin((time*0.777))))+(treb*0.5)),1));
per_frame_13=wave_b=(if(abs(equal(((frame)%(2)), 0))>0.00001,((0.2+(0.2*sin(time)))+(mid*0.5)),1));
per_frame_14=q1=speed;
per_pixel_1=rot=(if(abs(below(rad, 0.35))>0.00001,(((0.2*rad)*q1)*sin((ang*10))),0));
per_pixel_2=zoom=(if(abs(below(rad, 0.4))>0.00001,(zoom-(0.2*rad)),(zoom+((pow(rad, 3)*bass)*0.1))));
