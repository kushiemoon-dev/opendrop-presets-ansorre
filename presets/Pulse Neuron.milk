MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWarpScale=0.999994
nWaveMode=6.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
bMotionVectorsOn=0.0
fWaveParam=-1.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=push = 0;
per_frame_init_2=progress = 0;
per_frame_1=push=(if(abs(above(progress, 0))>0.00001,(if(abs(above(push, 1))>0.00001,-1,(push+0.05))),-1));
per_frame_2=wave_mystery=(wave_mystery+push);
per_frame_3=wave_r=(wave_r+(0.5*sin((time*0.222))));
per_frame_4=wave_g=(wave_g+(0.5*sin((time*0.333))));
per_frame_5=wave_b=(wave_b+(0.5*sin((time*0.444))));
per_frame_6=warp=0;
per_frame_7=dx=(dx-0.001);
per_frame_8=dy=(dy-0.001);
per_pixel_1=zoom=(zoom+abs((((rad-0.3)-(bass*0.2))*0.3)));
per_pixel_2=rot=(if(abs(above(rad, (0.3+(bass*0.2))))>0.00001,(rot-(rad*0.1)),0));
