per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0035);
per_frame_3=mv_l=3000;
per_frame_4=mv_r=(0.5+(0.499*sin((time*1.12))));
per_frame_5=mv_b=(0.2+(0.19*cos((time*0.45))));
per_frame_6=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_7=vol_now=(4*bass_effect);
per_frame_8=beat_max=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,max(beat_max, vol_now)));
per_frame_9=beat_min=(if(abs(equal(((frame)%(50)), 0))>0.00001,vol_now,min(beat_min, vol_now)));
per_frame_10=beat_rate=(if(abs(equal(((frame)%(50)), 0))>0.00001,0,(beat_rate+beat)));
per_frame_11=last_beat_rate=(if(abs(equal(((frame)%(50)), 49))>0.00001,(if(abs(above(beat_rate, 10))>0.00001,(if(abs(below(beat_rate, 30))>0.00001,beat_rate,last_beat_rate)),last_beat_rate)),last_beat_rate));
per_frame_12=last_beat_rate=max(last_beat_rate, (10*beat_min));
per_frame_13=beat=(if(abs(above(vol_now, ((0.035*last_beat_rate)*(beat_max-beat_min))))>0.00001,1,0));
per_frame_14=sin_beat=sin((beat_max-vol_now));
per_frame_15=mysign=(if(abs(above(sin_beat, 0.1))>0.00001,1,-1));
per_frame_16=myframe=(if(abs(above(0.2, sin_beat))>0.00001,frame,0));
per_frame_17=myframe=(if(abs(above(myendframe, frame))>0.00001,0,myframe));
per_frame_18=myendframe=(if(abs(above(0.2, sin_beat))>0.00001,(myframe+100),myendframe));
per_frame_19=long_beat=((mysign*10)*sin((myendframe-myframe)));
per_frame_20=cycle=(if(abs(equal(long_beat, 0))>0.00001,(long_beat+1.57),long_beat));
per_frame_21=decay=(if(abs(above(bass_effect, 0))>0.00001,0.96,0.996));
per_frame_22=wave_x=(0.6+(0.3*sin((long_beat*0.724))));
per_frame_23=wave_b=(wave_b+(0.5*sin(long_beat)));
per_frame_24=wave_r=(wave_r+cycle);
per_frame_25=q1=(progress*cycle);
per_frame_26=monitor=progress;
per_frame_27=ib_b=(20*sin(progress));
per_frame_28=ib_g=cos(progress);
per_pixel_1=sx=(sx+((0.01*q1)*x));
