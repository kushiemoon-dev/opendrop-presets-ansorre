per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=zoom=(zoom+((0.2*abs((0.3*cos((4*rad)))))*cos((12*ang))));
per_pixel_5=sx=(sx-((13*dx_r)*sin((((2*sin((6*rad)))*2)*cos((6*rad))))));
per_pixel_6=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_7=tg1=abs(sin(time));
per_pixel_8=tg2=(((((12*above(tg1, 0.8))+(4*below(tg1, 0.2)))+((6*above(tg1, 0.2))*below(tg1, 0.4)))+((8*above(tg1, 0.4))*below(tg1, 0.6)))+((10*above(tg1, 0.6))*below(tg1, 0.8)));
per_pixel_9=tg3=(if(abs(equal(thresh, 2))>0.00001,tg2,tg3));
