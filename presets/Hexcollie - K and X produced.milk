per_frame_1=basstime=(basstime+(bass_att*0.03));
per_frame_2=vol=pow(((bass+mid)+treb), 2);
per_frame_3=basssum=vol;
per_frame_4=stickybit=((time)%(2));
per_frame_5=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_6=sample1=(sample1+equal(stickybit, 1));
per_frame_7=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_8=sample2=(sample2+equal(stickybit, 0));
per_frame_9=edge=bnot(equal(bit2, stickybit));
per_frame_10=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_11=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_12=sample1=(sample1-((sample1*edge)*stickybit));
per_frame_13=sample2=(sample2-((sample2*edge)*equal(stickybit, 0)));
per_frame_14=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(floor((volavg2)/(sample2)))),0));
per_frame_15=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(floor((volavg)/(sample1)))),diff));
per_frame_16=diff=diff;
per_frame_17=bit2=((time)%(2));
per_frame_18=q1=diff;
per_frame_19=difftime=(difftime+(diff*0.03));
per_frame_20=q2=difftime;
per_frame_21=difftime=(if(abs(above(difftime, 2000))>0.00001,0,difftime));
per_frame_22=ib_r=cos((difftime*0.17));
per_frame_23=ib_g=cos((difftime*0.27));
per_frame_24=ib_b=cos((difftime*0.37));
per_frame_25=ob_r=cos((difftime*0.67));
per_frame_26=ob_g=cos((difftime*0.77));
per_frame_27=ob_b=cos((difftime*0.87));
per_frame_28=mtime=(mtime+(1*above(vol, 14)));
per_frame_29=q5=mtime;
per_frame_30=monitor=mtime;
per_pixel_1=aa1=((cos(q5)*below(zoom, 1))+(sin(q5)*above(zoom, 1)));
per_pixel_2=zoom=(1-(aa1*0.07));
per_pixel_3=sx=-1;
per_pixel_4=sy=-1;
