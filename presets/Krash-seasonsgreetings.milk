MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.94
fWaveScale=0.042592
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
mv_a=0.0
nWaveMode=6.0
ob_size=0.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
fVideoEchoZoom=1.0
fWaveAlpha=1.0
fWaveParam=-1.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=blue = 0;
per_frame_init_2=red_aim = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=bass_thresh = 0;
per_frame_init_5=bass_on = 0;
per_frame_init_6=treb_thresh = 0;
per_frame_init_7=treb_on = 0;
per_frame_init_8=green = 0;
per_frame_init_9=red = 0;
per_frame_init_10=q2 = 0;
per_frame_init_11=blue_aim = 0;
per_frame_init_12=swapcolour = 0;
per_frame_init_13=green_aim = 0;
per_frame_1=warp=0;
per_frame_2=q1=floor((((bass_att+mid_att)+treb_att))/(3));
per_frame_3=q2=(time+(5*((bass+mid)+treb)));
per_frame_4=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.95)+1.4)));
per_frame_5=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.85)+1.2)));
per_frame_6=bass_on=above(bass_thresh, 1.9);
per_frame_7=treb_on=above(treb_thresh, 1.9);
per_frame_8=swapcolour=(bass_on-treb_on);
per_frame_9=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,0))));
per_frame_10=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0.4,(if(abs(equal(swapcolour, 0))>0.00001,0.3,0.2))));
per_frame_11=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0.3,(if(abs(equal(swapcolour, 0))>0.00001,0.2,0))));
per_frame_12=red=(red+((red_aim-red)*0.5));
per_frame_13=green=(green+((green_aim-green)*0.5));
per_frame_14=blue=(blue+((blue_aim-blue)*0.5));
per_frame_15=wave_r=red;
per_frame_16=wave_g=green;
per_frame_17=wave_b=blue;
per_pixel_1=dx=(if(abs(above(x, 0.5))>0.00001,(if(abs(below(y, 0.9))>0.00001,((above(int(rand(20)), 1)*0.02)*pow((y+0.15), 2)),0.005)),dx));
per_pixel_2=dx=(if(abs(below(x, 0.5))>0.00001,(if(abs(below(y, 0.9))>0.00001,((above(int(rand(20)), 1)*-0.02)*pow((y+0.15), 2)),-0.005)),dx));
per_pixel_3=dy=(-0.02*abs((x-0.5)));
