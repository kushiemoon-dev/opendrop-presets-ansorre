MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.925
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_a=0.12
ib_g=1.0
ib_r=1.0
ib_size=0.1
mv_a=0.0
ob_b=1.0
ob_g=1.0
ob_r=1.0
ob_size=0.02
rot=1.0
sy=0.999999
warp=0.01
zoom=0.904847
bAdditiveWaves=1.0
fVideoEchoZoom=0.999609
fWaveAlpha=0.001
fZoomExponent=10.892505
fWaveParam=1.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_max = 0;
per_frame_init_2=mid_max = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=newrad = 0;
per_frame_init_5=min_treb = 0;
per_frame_init_6=treb_max = 0;
per_frame_init_7=min_mid = 0;
per_frame_init_8=max_beat = 0;
per_frame_init_9=min_bass = 0;
per_frame_init_10=min_beat = 0;
per_frame_init_11=beat = 0;
per_frame_1=bass_max=max(bass, bass_att);
per_frame_2=treb_max=max(treb, treb_att);
per_frame_3=mid_max=max(mid, mid_att);
per_frame_4=min_bass=min(bass, bass_att);
per_frame_5=min_treb=min(treb, treb_att);
per_frame_6=min_mid=min(mid, mid_att);
per_frame_7=max_beat=((bass_max*treb_max)*mid_max);
per_frame_8=min_beat=((min_bass*min_treb)*min_mid);
per_frame_9=beat=((max_beat*min_beat)-max(max_beat, min_beat));
per_frame_10=q1=beat;
per_frame_11=ob_a=1;
per_frame_12=ob_g=(if(abs(above(beat, 0.5))>0.00001,1,0));
per_frame_13=ob_r=(if(abs(below(beat, 0.1))>0.00001,1,0));
per_frame_14=ob_b=(if(abs(below(beat, 0.8))>0.00001,1,0));
per_frame_15=ib_r=(if(abs(above(beat, 0.5))>0.00001,1,0));
per_frame_16=ib_b=(if(abs(below(beat, 0.4))>0.00001,1,0));
per_frame_17=ib_g=(if(abs(equal(beat, 1))>0.00001,1,0));
per_pixel_1=newrad=(((rad*pow(1, 2))*(if(abs(below(1, 2))>0.00001,1,0)))*rad);
per_pixel_2=rot=(((rot*rad)*sin(time))*(if(abs(above(q1, 0.3))>0.00001,1,0)));
per_pixel_3=zoom=(zoom-((0.10*sin(time))*(if(abs(below(q1, 0.3))>0.00001,1,0))));
per_pixel_4=zoom=(zoom-(0.10*sin((q1*newrad))));
per_pixel_5=zoomexp=(zoomexp+(0.20*sin((time+newrad))));
