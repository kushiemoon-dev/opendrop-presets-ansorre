MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.653093
fWaveSmoothing=0.0
ib_size=0.26
mv_a=0.0
nWaveMode=7.0
ob_a=1.0
ob_r=0.01
ob_size=0.005
warp=0.01
wave_b=0.0
wave_g=0.25
wave_r=0.95
wave_x=0.1
wave_y=0.0
bAdditiveWaves=1.0
fVideoEchoZoom=4.946229
nVideoEchoOrientation=1.0
fWaveAlpha=4.099998
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=red_rand = 0;
per_frame_init_2=progress = 0;
per_frame_init_3=green_rand = 0;
per_frame_1=dy=(dy-0.0005);
per_frame_2=dx=(dx-0.0005);
per_frame_3=warp=0;
per_frame_4=red_rand=(if(abs(below(progress, 0.01))>0.00001,int(rand(100)),red_rand));
per_frame_5=green_rand=(if(abs(below(progress, 0.01))>0.00001,int(rand(100)),green_rand));
per_frame_6=wave_r=((0.01*red_rand)+(0.1*sin((time*1.17))));
per_frame_7=wave_g=((0.01*green_rand)+(0.1*sin((time*1.36))));
per_frame_8=wave_b=((1-(0.5*(wave_r+wave_g)))+(0.1*sin((time*1.09))));
per_frame_9=decay=(if(abs(below(progress, 0.01))>0.00001,0.94,1));
per_frame_10=monitor=progress;
per_pixel_1=dy=(-0.012*(y+0.1));
