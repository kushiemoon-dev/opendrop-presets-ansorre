per_frame_15=avgdb=((avgdb*0.999)+(abs(db)*0.001));
per_frame_16=rawbeatb=above((db*fakebeatb), (avgdb*1.3));
per_frame_17=beatb=(rawbeatb*above((time-lbbtime), (0.1*avgbeatrate)));
per_frame_18=maxdb=max((maxdb*0.9999), abs(db));
per_frame_19=bbtime=(time*beatb);
per_frame_20=beatrate=((beatb*(bbtime-lbbtime))+((1-beatb)*beatrate));
per_frame_21=avgbeatrate=((beatb*((avgbeatrate*0.999)+(beatrate*0.001)))+((1-beatb)*avgbeatrate));
per_frame_22=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_23=faketime=(faketime+(avgbeatrate*0.005));
per_frame_24=fakebeatb=((cos(faketime)*0.5)+0.5);
per_frame_25=fb=(above(fakebeatb, 0.9999)*above((faketime-lftime), (0.5*avgfbr)));
per_frame_26=fbr=(((1-fb)*fbr)+(fb*((fbr*0.99)+((faketime-lftime)*0.01))));
per_frame_27=avgfbr=((avgbr*(1-fb))+(fb*((avgfbr*0.99)+(fbr*0.01))));
per_frame_28=fbc=(fbc+fb);
per_frame_29=lftime=((faketime*fb)+((1-fb)*lftime));
per_frame_30=bc=(bc+beatb);
