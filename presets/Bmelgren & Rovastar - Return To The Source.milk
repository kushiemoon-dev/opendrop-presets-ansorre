per_frame_init_1=ff = 0;
per_frame_1=ff=floor((frame)/(150));
per_frame_2=zoom=(1+floor(((pow(cos(ff), 4)*pow(sin(ff), 3)))/(mid_att)));
per_frame_3=wave_g=((cos(ff)-(pow(sin(ff), 2)*0.45))+0.55);
per_frame_4=wave_b=(floor((sin(ff))/(2))+0.5);
per_frame_5=wave_r=(floor((cos(ff))/(2))+0.5);
per_frame_6=decay=(1-(floor((sin(ff))/(20))+0.055));
per_frame_7=dx=floor((cos(ff))/(200));
per_frame_8=rot=((floor((pow(sin((4*ff)), 5))/(30))+floor((pow(sin((2*ff)), 3))/(30)))-floor((sin(ff))/(30)));
per_frame_9=dx=floor((pow(sin(ff), 3))/(100));
