per_frame_1=wave_mode=(cy-ob_r);
per_frame_2=wave_y=sigmoid((wave_y+mv_g), (ib_size*dy));
per_frame_3=ob_size=min((ib_a*mv_r), (ib_a+mv_l));
per_frame_4=mv_y=(if(abs(above((ob_r*wave_g), (wave_mode*ob_r)))>0.00001,(ob_b-ob_g),(zoomexp*wave_mode)));
per_frame_5=ib_b=(0.94505525*sqr((zoom*sy)));
per_frame_6=wave_y=(if(abs(below(wave_y, 0.0))>0.00001,0.0,wave_y));
per_frame_7=wave_y=(if(abs(above(wave_y, 1.0))>0.00001,1.0,wave_y));
per_frame_8=wave_mode=(if(abs(below(wave_mode, 0))>0.00001,0,wave_mode));
per_frame_9=wave_mode=(if(abs(above(wave_mode, 7.0))>0.00001,7.0,wave_mode));
per_frame_10=ob_size=(if(abs(below(ob_size, 0.0))>0.00001,0.0,ob_size));
per_frame_11=ob_size=(if(abs(above(ob_size, 0.5))>0.00001,0.5,ob_size));
per_frame_12=ib_b=(if(abs(below(ib_b, 0.0))>0.00001,0.0,ib_b));
per_frame_13=ib_b=(if(abs(above(ib_b, 1.0))>0.00001,1.0,ib_b));
per_frame_14=mv_y=(if(abs(below(mv_y, 0.0))>0.00001,0.0,mv_y));
per_frame_15=mv_y=(if(abs(above(mv_y, 48.0))>0.00001,48.0,mv_y));
