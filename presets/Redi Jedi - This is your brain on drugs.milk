per_frame_1=beatb=above(bass, bass_att);
per_frame_2=beatbhard=(if(abs(beatb)>0.00001,(bass-(bass_att*0.9)),beatbhard));
per_frame_3=beatm=above(mid, mid_att);
per_frame_4=beatmhard=(if(abs(beatm)>0.00001,(mid-(mid_att*0.9)),beatmhard));
per_frame_5=beatt=above(treb, treb_att);
per_frame_6=beatthard=(if(abs(beatt)>0.00001,(treb-(treb_att*0.9)),beatthard));
per_frame_7=vol=((bass+mid)+treb);
per_frame_8=vol_att=((bass_att+mid_att)+treb_att);
per_frame_9=q1=beatb;
per_frame_10=q2=beatbhard;
per_frame_11=q3=beatm;
per_frame_12=q4=beatmhard;
per_frame_13=q5=beatt;
per_frame_14=q6=beatthard;
per_frame_15=q8=((10*bass_att)*q4);
per_frame_16=decay=0.98;
per_frame_17=wrap=0;
per_pixel_1=ns=q8;
per_pixel_2=cx=floor(((((x*ns))%(ns)))/(ns));
per_pixel_3=cy=floor(((((y*ns))%(ns)))/(ns));
per_pixel_4=rot=(((((rad*100))%(2))-0.5)*0.3);
