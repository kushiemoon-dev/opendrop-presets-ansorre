per_frame_8=wave_g=(wave_g+mid_shift);
per_frame_9=wave_b=(wave_b+treb_shift);
per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.151)*sin((3*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.15)*sin((3.23*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=zoom=(zoom+0.04);
per_pixel_5=dx=(dx+(0.076*abs(((3*dx_r)*sin(above(x, 0.5))))));
per_pixel_6=dx=(dx-(0.076*abs(((3*dx_r)*sin(below(x, 0.5))))));
per_pixel_7=dy=(dy+(0.076*((3*dy_r)*sin(below(x, 0.5)))));
per_pixel_8=dy=(dy+(0.076*((3*dy_r)*sin(above(x, 0.5)))));
per_pixel_9=rot=(rot+(((5*dx_r)*sin(((0.1*max(1, bass_att))-(2*sin((0.5-rad))))))*above(y, 0.5)));
per_pixel_10=rot=(rot+(((5*dy_r)*sin(((0.1*max(1, treb_att))-(2*cos((0.5-rad))))))*below(y, 0.5)));
