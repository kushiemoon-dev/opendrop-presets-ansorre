per_frame_1=bass_tick=((above(bass_att, bass_tick)*2)+((1-above(bass_att, bass_tick))*(((bass_tick-1.3)*0.96)+1.3)));
per_frame_2=treb_tick=((above(treb_att, treb_tick)*2)+((1-above(treb_att, treb_tick))*(((treb_tick-1.3)*0.96)+1.3)));
per_frame_3=mid_tick=((above(mid_att, mid_tick)*2)+((1-above(mid_att, mid_tick))*(((mid_tick-1.3)*0.96)+1.3)));
per_frame_4=bass_shift=(((equal(bass_tick, 2)*0.95)*sin((time*5)))+((1-equal(bass_tick, 2))*bass_shift));
per_frame_5=treb_shift=(((equal(treb_tick, 2)*0.95)*sin((time*5)))+((1-equal(treb_tick, 2))*treb_shift));
per_frame_6=mid_shift=(((equal(mid_tick, 2)*0.95)*sin((time*5)))+((1-equal(mid_tick, 2))*mid_shift));
