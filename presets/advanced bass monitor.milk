MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bDarken=1.0
dx=-0.012
fDecay=0.999
fGammaAdj=1.0
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWaveScale=0.10049
fWaveSmoothing=0.9
warp=0.01
wave_b=0.0
wave_r=0.0
wave_x=0.9
fVideoEchoZoom=0.999609
fWaveAlpha=100.0
nMotionVectorsX=64.0
nMotionVectorsY=3.984009
fWaveParam=-0.484
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=basseffect = 0;
per_frame_init_2=att = 0;
per_frame_init_3=progress = 0;
per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0005);
per_frame_3=basseffect=max((max(bass, att)-1), 0);
per_frame_4=wave_y=min((0.35+(bass_att*0.2)), 1);
per_frame_5=decay=(if(abs(above(progress, 0.05))>0.00001,1,0));
per_frame_6=mv_y=(4-min((((bass_att+bass)-2)*0.25), 0.9));
per_frame_7=mv_r=(basseffect*4);
per_frame_8=mv_b=(basseffect*3);
per_frame_9=mv_g=(basseffect*3.5);
