MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveThick=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.059958
fWaveSmoothing=0.5
ib_size=0.0
mv_a=0.0
mv_b=0.0
mv_g=0.0
mv_l=5.0
nWaveMode=2.0
ob_a=1.0
ob_size=0.0
warp=0.01
fVideoEchoAlpha=0.5
fVideoEchoZoom=4.027077
fWaveAlpha=100.0
