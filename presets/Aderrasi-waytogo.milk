nMotionVectorsY=5.28
fWaveParam=-0.46
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=progress = 0;
per_frame_1=wave_r=(wave_r+sin((time-bass)));
per_frame_2=wave_g=(wave_g+(0.7*sin((8*time))));
per_frame_3=wave_b=(wave_b+(0.8*sin(time)));
per_frame_4=decay=(if(abs(below(progress, 0.05))>0.00001,0.9,decay));
per_frame_5=warp=0;
per_frame_6=dx=(dx+(if(abs(above(bass, 1.3))>0.00001,0.01,0)));
per_frame_7=dx=(dx+(if(abs(below(bass, 0.8))>0.00001,-0.01,0)));
per_frame_8=dy=(dy+(if(abs(below(dx, 0.01))>0.00001,(if(abs(above(dx, -0.01))>0.00001,(if(abs(above(treb, 1))>0.00001,0.002,0)),0)),0)));
per_frame_9=dy=(dy+(if(abs(below(dx, 0.01))>0.00001,(if(abs(above(dx, -0.01))>0.00001,(if(abs(below(treb, 0.75))>0.00001,-0.002,0)),0)),0)));
