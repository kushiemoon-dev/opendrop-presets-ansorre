per_frame_1=warp=0;
per_frame_2=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_3=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_4=beat=(if(abs(above(vol_now, (1.15*vol_mean)))>0.00001,1,0));
per_frame_5=sinbeat=sin((beat*(vol_now-vol_mean)));
per_frame_6=wave_b=(cos(time)+abs(cos(time)));
per_frame_7=wave_g=abs(sin(time));
per_frame_8=wave_r=(((-1*cos(time))+abs((-1*cos(time))))+(0.2*(cos(sin(time))+(abs(cos(sin(time)))+cos(sin(time))))));
per_frame_9=ib_a=(0.5*beat);
per_frame_10=ib_size=(0.2*abs(sin(vol_mean)));
per_pixel_1=a=pow(1.02, pow(1, ((rad*2)-1)));
per_pixel_2=dx=((((x-0.5)*a)+0.5)-x);
per_pixel_3=dy=((((y-0.5)*a)+0.5)-y);
per_pixel_4=zoom=(0.65+x);
