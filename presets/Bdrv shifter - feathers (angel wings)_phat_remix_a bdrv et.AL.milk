per_pixel_1=tm=(time*(rad+0.9));
per_pixel_2=it=((0.3*sin((tm*1.5)))+((rad*sin(x))+cos(y)));
per_pixel_3=radm=(rad*0.5);
per_pixel_4=rot=((0.02*sin(((radm+it)*5)))*rad);
per_pixel_5=mod=sin(floor((ang)/(x)));
per_pixel_6=mod=((((mod*mod)*mod)*mod)*mod);
per_pixel_7=zoom=(1+abs((0.01*mod)));
per_pixel_8=num=8;
per_pixel_9=pi=3.141592654;
per_pixel_10=radi=((y-0.5)*0.75);
per_pixel_11=radi=(y-0.5);
per_pixel_12=radi=pow(((radi*radi)+((x-0.5)*(x-0.5))), 0.5);
per_pixel_13=an=((ang+pi)+time);
per_pixel_14=an=(an-((pi*2)*floor(floor((an)/((pi*2))))));
per_pixel_15=mod=0.1;
per_pixel_16=seg=(ang+pi);
per_pixel_17=seg=(floor((seg)/((pi*2)))*num);
per_pixel_18=seg=floor(seg);
per_pixel_19=seg=(seg-equal(seg, num));
per_pixel_20=anga=((ang+pi)-(floor(((pi*2))/(num))*seg));
per_pixel_21=anga=(if(abs(equal(((seg)%(2)), 0))>0.00001,(floor(((pi*2))/(num))-anga),anga));
per_pixel_22=anga=(anga+floor((pi)/(4)));
per_pixel_23=ox=(0.5-(radi*sin(anga)));
per_pixel_24=oy=(0.5+(radi*cos(anga)));
per_pixel_25=dx=(equal(seg, 3)*(x-ox));
per_pixel_26=dy=(equal(seg, 3)*(y-oy));
per_pixel_27=dx=(above(seg, 0)*(x-ox));
per_pixel_28=dy=(above(seg, 0)*(y-oy));
