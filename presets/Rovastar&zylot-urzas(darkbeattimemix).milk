per_pixel_1=zoom=(0.01+(if(abs(below(rad, ((0.08*sin((time*1.46)))+0.18)))>0.00001,(1.2+floor((sin((time*1.54)))/(5))),(zoom+((0.07+(0.03*sin((time*0.55))))*sin(((ang*10)+(time*8))))))));
per_pixel_2=rot=(0.1*sin((((if(abs(above(sin(q1), 0))>0.00001,-rad,rad))*5)+(time*0.05))));
