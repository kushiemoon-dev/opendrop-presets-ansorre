per_frame_init_1=rv = 0;
per_frame_init_2=progress = 0;
per_frame_1=rv=(bass*bass);
per_frame_2=monitor=progress;
per_frame_3=rot=(if(abs(above(progress, 0.25))>0.00001,((sin(time)*0.25)*above(bass, 1)),0));
per_frame_4=wave_mystery=(if(abs(above(progress, 0.25))>0.00001,(progress-0.65),-0.6));
per_frame_5=wave_y=(if(abs(above(progress, 0.25))>0.00001,0.5,(floor((floor((progress*750)))/(750))*2)));
per_frame_6=dy=(if(abs(above(progress, 0.25))>0.00001,0,-0.00195));
per_frame_7=wave_x=0.5;
per_frame_8=cy=((floor((int(rand(((50*rv)*bass))))/(1000))+wave_y)-((0.025*bass)*rv));
per_frame_9=cx=((floor((int(rand(((50*rv)*bass))))/(1000))+wave_x)-((0.025*bass)*rv));
per_frame_10=wave_r=(if(abs(above(progress, 0.25))>0.00001,(((0.5*bass)*sin((time+3)))+0.5),1));
per_frame_11=wave_b=(if(abs(above(progress, 0.25))>0.00001,(((0.5*bass)*sin((time+2)))+0.5),1));
per_frame_12=wave_g=(if(abs(above(progress, 0.25))>0.00001,(((0.5*bass)*sin((time+1)))+0.5),1));
