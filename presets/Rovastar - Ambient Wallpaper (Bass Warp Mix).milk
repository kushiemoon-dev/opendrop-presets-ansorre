per_frame_4=wave_r=((0.01*red_rand)+(0.1*sin((time*1.311))));
per_frame_5=wave_b=((0.01*blue_rand)-(0.1*sin((time*1.46))));
per_frame_6=wave_g=((1-(0.5*(wave_r+wave_b)))+(0.1*cos((time*0.789))));
per_frame_7=decay=1;
