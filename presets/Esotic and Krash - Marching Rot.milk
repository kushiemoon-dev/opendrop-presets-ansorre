per_frame_20=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_frame_21=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_frame_22=zoom=(if(abs(below(zoom, 0.01))>0.00001,0.01,zoom));
per_frame_23=zoom=(if(abs(above(zoom, 100))>0.00001,100,zoom));
