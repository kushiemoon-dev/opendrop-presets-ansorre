per_frame_27=dy=(if(abs(above(dy, 1.0))>0.00001,1.0,dy));
per_frame_28=wave_mystery=(if(abs(below(wave_mystery, -1.0))>0.00001,-1.0,wave_mystery));
per_frame_29=wave_mystery=(if(abs(above(wave_mystery, 1.0))>0.00001,1.0,wave_mystery));
per_frame_30=my_rot=(my_rot+(0.03*beatrate));
