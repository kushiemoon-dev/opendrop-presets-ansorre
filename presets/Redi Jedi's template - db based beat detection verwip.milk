per_frame_init_49=mtime=(100+(bass_att*1000));
per_frame_init_50=mtime2=(100+(treb_att*1000));
per_frame_1=db=((bass-lbass)*fps);
per_frame_2=dt=((treb-ltreb)*fps);
per_frame_3=ltreb=treb;
per_frame_4=lbass=bass;
per_frame_5=avgdb=((avgdb*0.9)+(abs(db)*0.1));
per_frame_6=avgdt=((avgdt*0.9)+(abs(dt)*0.1));
per_frame_7=rawbeatb=above(abs(db), avgdt);
per_frame_8=beatb=(rawbeatb*above((time-lbbtime), (avgbbeatrate*0.75)));
per_frame_9=beatb2=(beatb*above(abs(dt), avgdb));
per_frame_10=beatbhard=(beatb2*(abs(db)-(avgdb*3)));
per_frame_11=avgbbeatrate=((beatb*((avgbbeatrate*0.99)+((time-lbbtime)*0.01)))+((1-beatb)*(avgbbeatrate+((3-avgbbeatrate)*0.00001))));
per_frame_12=lbbtime2=((time*beatb2)+((1-beatb2)*lbbtime2));
per_frame_13=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_14=ph=(((time-lbbtime2)*floor((60)/(avgbbeatrate)))*const);
per_frame_15=phase=max(min(ph, 1), 0);
per_frame_16=const=((const*(1-beatb2))+(beatb2*(const+(0.001*bool))));
per_frame_17=bool=((below(phase, 0.98)*(0.99-ph))-(above(phase, 0.98)*(ph*0.5)));
per_frame_18=bc=(bc+beatb);
per_frame_19=vol=((rawbeatb*abs(db))*0.001);
per_frame_20=avgvol=((avgvol*0.999)+(vol*0.01));
per_frame_21=mtime=(mtime+((min((avgdt*0.01), 0.25)-((beatbhard*0.01)*dt))*floor((1)/(fps))));
per_frame_22=mtime2=(mtime2+((min((avgdb*0.01), 0.25)+((beatbhard*0.01)*db))*floor((1)/(fps))));
per_frame_23=q2=phase;
per_frame_24=q1=beatb2;
per_frame_25=q3=avgdb;
per_frame_26=q4=floor((60)/(avgbbeatrate));
per_frame_27=q5=(beatbhard*0.05);
per_frame_28=q6=mtime;
per_frame_29=q7=mtime2;
per_frame_30=monitor=q7;
