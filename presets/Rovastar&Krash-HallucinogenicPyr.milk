per_frame_13=beat_time=(if(abs(above(bass_effect, 0.5))>0.00001,(if(abs(ok_to_change)>0.00001,time,beat_time)),beat_time));
per_frame_14=effect=(if(abs(equal(time, beat_time))>0.00001,((effect+int(rand(3)))+1),effect));
per_frame_15=effect=(if(abs(above(effect, 3))>0.00001,(effect-4),effect));
per_frame_16=bass_effect=max((max(bass, bass_att)-1.34), 0);
per_frame_17=q1=effect;
per_frame_18=q2=bass_effect;
per_pixel_1=zoom=(((if(abs(equal(q1, 0))>0.00001,(0.4*x),(if(abs(equal(q1, 1))>0.00001,(0.4*(1-x)),(if(abs(equal(q1, 2))>0.00001,(0.4*y),(0.4*(1-y))))))))+0.6)-(0.13*min(q2, 0.3)));
