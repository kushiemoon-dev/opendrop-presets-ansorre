MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
fDecay=1.0
fGammaAdj=1.21
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.26
mv_a=0.51
nWaveMode=1.0
ob_a=0.1
ob_size=0.1
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.999514
bAdditiveWaves=1.0
fVideoEchoAlpha=1.0
fVideoEchoZoom=1.111904
fWaveAlpha=4.099998
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=ying = 0;
per_frame_init_3=yin = 0;
per_frame_init_4=yang = 0;
per_frame_1=warp=0;
per_frame_2=ying=(if(abs(below(ying, 1))>0.00001,1,ying));
per_frame_3=ying=(ying+equal(abs(sin((time+5000))), 1));
per_frame_4=yin=((ying)%(2));
per_frame_5=ob_g=(if(abs(yin)>0.00001,((time)%(2)),0));
per_frame_6=ob_r=(if(abs(yin)>0.00001,((time)%(3)),0));
per_frame_7=ob_b=(if(abs(yin)>0.00001,((time)%(4)),0));
per_frame_8=mv_b=(sin(time)+abs(sin(time)));
per_frame_9=mv_r=cos(time);
per_frame_10=mv_g=((-0.8*sign(sin(time)))*abs(sin(time)));
per_frame_11=dx=(if(abs(yin)>0.00001,(0.3*sin(time)),(if(abs(equal(yin, yang))>0.00001,0,(if(abs(below(abs(dx), 0.05))>0.00001,(dx-0.005),dx))))));
per_frame_12=dy=(if(abs(yin)>0.00001,(0.3*cos((3*time))),0));
per_frame_13=mv_y=(if(abs(yin)>0.00001,9,(sin(time)*ying)));
per_frame_14=yang=bnot(yin);
per_frame_15=q1=yin;
per_pixel_1=rot=(if(abs(q1)>0.00001,(rot+(8*sin(rad))),0));
per_pixel_2=zoom=(if(abs(q1)>0.00001,(zoom+(0.001*rad)),(zoom+(0.001*x))));
