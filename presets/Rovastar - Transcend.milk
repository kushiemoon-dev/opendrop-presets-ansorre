per_frame_init_3=mid_effect = 0;
per_frame_init_4=treb_effect = 0;
per_frame_init_5=xxwave_mystery = 0;
per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0005);
per_frame_3=warp=0;
per_frame_4=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_5=mid_effect=max((max(mid, mid_att)-1.2), 0);
per_frame_6=treb_effect=max((max(treb, treb_att)-1.2), 0);
per_frame_7=wave_r=((0.25+(0.25*sin((time*1.218))))+(0.5*bass_effect));
per_frame_8=wave_g=((0.25+(0.25*sin((time*1.018))))+(0.45*treb_effect));
per_frame_9=wave_b=((0.25+(0.25*sin((time*1.381))))+(0.45*mid_effect));
per_frame_10=xxwave_mystery=((wave_mystery+(0.05*bass_effect))-(0.05*treb_effect));
per_frame_11=q1=bass_effect;
per_frame_12=monitor=(5*treb_effect);
per_pixel_1=zoomexp=(if(abs(below(rad, 0.31))>0.00001,(0.2-min((q1*rad), 0.1)),4));
per_pixel_2=zoom=(zoom+(0.1*log(sin(rad))));
per_pixel_3=rot=(if(abs(below(rad, 0.31))>0.00001,(0.8+((8*q1)*rad)),0));
