MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.218587
fWaveSmoothing=0.5
ib_size=0.25
mv_a=0.0
mv_l=1.0
ob_a=1.0
ob_size=0.005
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
bAdditiveWaves=1.0
fVideoEchoZoom=1.0
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
nMotionVectorsX=0.0
nMotionVectorsY=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=wave_type = 0;
per_frame_1=wave_x=(if(abs(above(bass, 1.5))>0.00001,0.5,1.11));
per_frame_2=wave_mystery=(if(abs(below(wave_x, 0.7))>0.00001,-0.45,wave_mystery));
per_frame_3=wave_x=(if(abs(above(treb, 1))>0.00001,-0.11,wave_x));
per_frame_4=warp=0;
per_frame_5=decay=1;
per_frame_6=wave_type=(if(abs(equal(wave_x, 0.5))>0.00001,7,0));
per_pixel_1=rot=(rot-(0.05*rad));
