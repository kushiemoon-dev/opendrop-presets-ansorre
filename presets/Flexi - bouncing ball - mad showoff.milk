per_frame_24=q2=y1;
per_pixel_1=x1=q1;
per_pixel_2=y1=q2;
per_pixel_3=d=sqrt((((x1-x)*(x1-x))+((y1-y)*(y1-y))));
per_pixel_4=c=100;
per_pixel_5=d1=(treb*0.02);
per_pixel_6=s=floor((2)/((1+pow(2, ((d-d1)*c)))));
per_pixel_7=v=(-2*bass);
per_pixel_8=mx=(((x-x1)*v)*(1-d));
per_pixel_9=my=(((y-y1)*v)*(1-d));
per_pixel_10=dx=(mx*s);
per_pixel_11=dy=(my*s);
