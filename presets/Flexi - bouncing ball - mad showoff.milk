per_frame_11=vy=(if(abs(above(y1, (1-bb)))>0.00001,(-abs(vy)*bounce),vy));
per_frame_12=vy=(if(abs(below(y1, bb))>0.00001,(abs(vy)*0.7),vy));
per_frame_13=y1=(if(abs(above(y1, (1-bb)))>0.00001,((1-bb)-abs(vy)),y1));
per_frame_14=y1=(if(abs(below(y1, bb))>0.00001,(bb+abs(vy)),y1));
per_frame_15=x1=(x1+vx);
