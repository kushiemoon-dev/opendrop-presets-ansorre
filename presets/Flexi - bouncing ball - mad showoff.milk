per_frame_1=vx=(if(abs(equal(vx, 0))>0.00001,0.01,vx));
per_frame_2=bounce=(0.95+(pow(((mid*treb)*bass), 1)*0.02));
per_frame_3=bb=0.1;
per_frame_4=vy=(if(abs(above(abs(vy), 1))>0.00001,(vy*0.1),vy));
