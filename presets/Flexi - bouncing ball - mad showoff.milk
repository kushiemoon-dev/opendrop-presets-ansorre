per_frame_17=wave_x=x1;
per_frame_18=wave_y=(1-y1);
per_frame_19=wave_mystery=((-0.35+(d*0.33))+(pow(((mid*treb)*bass), 1)*0.001));
per_frame_20=wave_r=(if(abs((equal(((frame)%(3)), 2)-1))>0.00001,(if(abs(equal(((frame)%(3)), 1))>0.00001,1,0)),0));
per_frame_21=wave_g=(if(abs((equal(((frame)%(3)), 2)-1))>0.00001,(if(abs(equal(((frame)%(3)), 1))>0.00001,0,1)),0));
per_frame_22=wave_b=(if(abs((equal(((frame)%(3)), 2)-1))>0.00001,(if(abs(equal(((frame)%(3)), 1))>0.00001,0,0)),1));
