[preset00]
bDarken=1.0
fDecay=0.9958
fGammaAdj=1.3
fWaveScale=0.026515
fWaveSmoothing=0.9
mv_a=0.0
nWaveMode=7.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
zoom=0.990099
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.006596
nVideoEchoOrientation=1.0
fShader=0.2
fWaveParam=0.3
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=bass_thresh = 0;
per_frame_init_3=treb_factor = 0;
per_frame_init_4=treb_thresh = 0;
per_frame_init_5=pulse = 0;
per_frame_init_6=mid_thresh = 0;
per_frame_init_7=mid_factor = 0;
per_frame_init_8=ripple = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=bass_factor = 0;
per_frame_1=warp=0;
per_frame_2=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.35)*0.96)+1.3)));
per_frame_3=bass_factor=((equal(bass_thresh, 2)*sin((time*7)))+((1-equal(bass_thresh, 2))*bass_factor));
per_frame_4=mid_thresh=((above(mid_att, mid_thresh)*2)+((1-above(mid_att, mid_thresh))*(((mid_thresh-1.35)*0.96)+1.3)));
per_frame_5=mid_factor=((equal(mid_thresh, 2)*sin((time*7)))+((1-equal(mid_thresh, 2))*mid_factor));
per_frame_6=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.35)*0.96)+1.3)));
per_frame_7=treb_factor=((equal(treb_thresh, 2)*sin((time*7)))+((1-equal(treb_thresh, 2))*treb_factor));
per_frame_8=q1=bass_factor;
per_frame_9=q2=mid_factor;
per_frame_10=pulse=(pulse+(abs(((bass_factor-mid_factor)+treb_factor))*0.03));
per_frame_11=wave_r=(wave_r+(0.4*bass_factor));
per_frame_12=wave_g=(wave_g+(0.4*mid_factor));
per_frame_13=wave_b=(wave_b+(0.4*treb_factor));
per_frame_14=wave_mystery=sin(pulse);
per_frame_15=zoom=(zoom+(0.1*sin(pulse)));
per_frame_16=wave_x=(wave_x+(0.2*treb_factor));
per_pixel_1=ripple=(cos(((((rad+x)*10)*q1)-(((rad+x)*10)*q2)))*0.1);
per_pixel_2=zoom=(zoom+ripple);
per_pixel_3=rot=(rot+(ripple*-0.2));
