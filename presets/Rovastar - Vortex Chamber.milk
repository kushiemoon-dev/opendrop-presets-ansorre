per_frame_1=wave_r=(wave_r+(0.5*((0.60*sin((0.933*time)))+(0.40*sin((1.045*time))))));
per_frame_2=wave_g=(wave_g+(0.5*((0.60*sin((0.900*time)))+(0.40*sin((0.956*time))))));
per_frame_3=wave_b=(wave_b+(0.5*((0.60*sin((0.910*time)))+(0.40*sin((0.920*time))))));
