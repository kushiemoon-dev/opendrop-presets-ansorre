per_frame_init_5=newy = 0;
per_frame_init_6=newzoom = 0;
per_frame_init_7=newrad = 0;
per_frame_1=mv_a=(mv_a+0.8);
per_frame_2=mv_x=(mv_x+(bass*treb));
per_frame_3=mv_y=(mv_y+(bass*mid));
per_frame_4=mv_l=(mv_l+(2*sin(time)));
per_frame_5=ob_b=((ob_b+0.3)+(0.4*sin((2.5*bass))));
per_frame_6=ib_b=(ob_b-0.2);
per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=newx=(x-(0.45*cos((3*time))));
per_pixel_5=newy=(y+(0.45*sin((2.62*time))));
per_pixel_6=newzoom=(0.3*sin((bass_att*(newrad+(3.5*sin(treb_att))))));
per_pixel_7=newrad=(sqrt(((newx*newx)+((0.5*newy)*newy)))*2);
per_pixel_8=rot=(rot+((0.5*newrad)*sin((1.26*time))));
per_pixel_9=dx=((dx-((0.1*newx)*newzoom))-newx);
per_pixel_10=dy=((dy-((0.1*newy)*newzoom))-newy);
