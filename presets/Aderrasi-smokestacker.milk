per_frame_1=dx=(dx-0.0007);
per_frame_2=dy=(dy-0.0007);
per_frame_3=wave_x=(if(abs(above(bass, 1))>0.00001,0.7,0.3));
per_frame_4=ib_r=(0.75+(0.2*sin((5*bass_att))));
per_frame_5=ib_g=(0.75+(0.2*sin((5*bass_att))));
per_frame_6=ib_b=(0.75+(0.2*sin((5*bass_att))));
per_frame_7=wave_r=(wave_r+(5*sin((5*bass))));
per_pixel_1=dx=(dx+(if(abs(below(x, 0.45))>0.00001,(if(abs(above(y, 0.35))>0.00001,0.005,-0.005)),0)));
per_pixel_2=dx=(dx+(if(abs(above(x, 0.55))>0.00001,(if(abs(above(y, 0.35))>0.00001,-0.005,0.005)),0)));
per_pixel_3=dy=(dy+(if(abs(above(x, 0.35))>0.00001,(if(abs(below(x, 0.4))>0.00001,(-0.01*sin(bass)),0)),0)));
per_pixel_4=dy=(dy+(if(abs(above(x, 0.6))>0.00001,(if(abs(below(x, 0.65))>0.00001,(-0.01*sin(bass)),0)),0)));
per_pixel_5=dy=(dy+(if(abs(above(x, 0.4))>0.00001,(if(abs(below(x, 0.6))>0.00001,(-0.02*sin(bass)),0)),0)));
per_pixel_6=rot=(rot+(if(abs(above(x, 0.4))>0.00001,(if(abs(below(x, 0.6))>0.00001,(-0.00*sin((4*time))),0)),0)));
per_pixel_7=warp=(warp+(if(abs(above(x, 0.4))>0.00001,(if(abs(below(x, 0.6))>0.00001,0.7,0)),0)));
