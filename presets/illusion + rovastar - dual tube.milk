per_frame_init_12=green_aim = 0;
per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0035);
per_frame_3=mv_r=(mv_r+(0.5*bass));
per_frame_4=mv_g=(mv_g+(0.5*mid));
per_frame_5=mv_b=(mv_b+(0.5*treb));
per_frame_6=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_7=decay=(if(abs(above(bass_effect, 0))>0.00001,0.96,0.996));
per_frame_8=wave_x=(0.6+(0.3*sin((time*0.724))));
per_frame_9=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_10=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.75)+1.5)));
per_frame_11=bass_on=above(bass_thresh, 1.8);
per_frame_12=treb_on=above(treb_thresh, 1.9);
per_frame_13=swapcolour=(bass_on-treb_on);
per_frame_14=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,1,(if(abs(equal(swapcolour, 0))>0.00001,1,0))));
per_frame_15=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0.5,0.25))));
per_frame_16=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,1))));
per_frame_17=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,0.65,0.45))));
per_frame_18=green=(green+((green_aim-green)*0.5));
per_frame_19=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.45,0.65))));
per_frame_20=wave_r=red;
per_frame_21=wave_g=green;
per_frame_22=wave_b=blue;
per_frame_23=mv_l=3000;
