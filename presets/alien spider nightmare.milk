MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bDarken=1.0
bDarkenCenter=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWarpScale=1.331
fWaveScale=0.669541
fWaveSmoothing=0.63
ib_a=0.4
ib_b=0.65
nWaveMode=3.0
ob_a=1.0
ob_r=0.23
ob_size=0.015
warp=0.0101
wave_b=0.0
wave_g=0.0
wave_r=0.0
wave_x=0.0
wave_y=0.0
zoom=0.999514
fVideoEchoAlpha=0.5
fVideoEchoZoom=0.999609
nVideoEchoOrientation=1.0
fWaveAlpha=1.000158
fWaveParam=-1.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=bass_factor = 0;
per_frame_init_3=madbass = 0;
per_frame_init_4=madtreb = 0;
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.0005);
per_frame_3=dy=(dy-0.0005);
per_frame_4=wave_x=(0.4+(0.1*mid));
per_frame_5=wave_y=(0.4+(0.1*bass));
per_frame_6=wave_r=bass;
per_frame_7=wave_g=mid;
per_frame_8=wave_b=treb;
per_frame_9=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_10=madtreb=max((max(treb, treb_att)-1.3), 0);
per_frame_11=zoom=((zoom-(1.1*madbass))-0.005);
per_frame_12=rot=(rot+abs((0.005*sin((0.05*time)))));
per_frame_13=ib_a=(if(abs(above(bass, 1.2))>0.00001,0.7,0));
per_frame_14=ob_r=(if(abs(above(treb, 1.2))>0.00001,0.3,0.1));
per_frame_15=ob_g=(if(abs(above(madtreb, 0))>0.00001,madtreb,madbass));
per_frame_16=mv_x=(madbass*30);
per_frame_17=mv_y=(100-(madbass*4));
per_frame_18=mv_r=bass_att;
per_frame_19=mv_g=(1-treb_att);
per_frame_20=mv_b=(1-mid_att);
per_pixel_1=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_pixel_2=bass_factor=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_pixel_3=rot=(if(abs(below(rad, bass_factor))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_4=zoom=(if(abs(below(rad, bass_factor))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
