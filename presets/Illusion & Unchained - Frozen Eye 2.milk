[preset00]
bWaveThick=1.0
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.95
fModWaveAlphaStart=0.85
fWaveScale=1.599179
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
mv_a=0.0
ob_a=1.0
ob_size=0.005
wave_b=0.4
wave_g=0.4
wave_r=0.4
bAdditiveWaves=1.0
fVideoEchoAlpha=0.5
