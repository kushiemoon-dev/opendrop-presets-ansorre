shapecode_3_enabled=0.0
per_frame_init_1=treb_effect = 0;
per_frame_init_2=bass_thresh = 0;
per_frame_init_3=bass_on = 0;
per_frame_init_4=net_effect = 0;
per_frame_init_5=treb_on = 0;
per_frame_init_6=bass_effect = 0;
per_frame_init_7=dx_residual = 0;
per_frame_init_8=wave_size = 0;
per_frame_init_9=state = 0;
per_frame_init_10=dy_residual = 0;
per_frame_1=warp=0;
per_frame_2=bass_on=(if(abs(above(bass_att, 1.3))>0.00001,1,0));
per_frame_3=treb_on=(if(abs(above(treb_att, 1.3))>0.00001,1,0));
per_frame_4=state=(1+bass);
per_frame_5=wave_r=(wave_r+((0.25*((0.6*sin((0.784*time)))+(0.4*sin((0.986*time)))))*state));
per_frame_6=wave_g=(wave_g+((0.25*((0.6*sin((0.671*time)))+(0.4*sin((1.164*time)))))*(4-state)));
per_frame_7=wave_b=(wave_b+((0.25*((0.6*sin((1.423*time)))+(0.4*sin((0.687*time)))))*floor((4)/(state))));
per_frame_8=wave_y=(if(abs(equal(state, 1))>0.00001,(wave_y+((floor(int(rand(10)))*0.1)*sin((time*3)))),wave_y));
per_frame_9=bass_effect=(if(abs(above(bass_att, 1.4))>0.00001,pow(1.1, bass_att),1));
per_frame_10=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,pow(0.97, treb_att),1));
per_frame_11=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,bass_effect,treb_effect));
per_frame_12=zoom=net_effect;
per_frame_13=wave_size=(2*state);
per_frame_14=dx=(dx+dx_residual);
per_frame_15=dy=(dy+dy_residual);
per_frame_16=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_17=dx_residual=(((equal(bass_thresh, 2)*0.016)*sin((time*7)))+((1-equal(bass_thresh, 2))*dx_residual));
per_frame_18=dy_residual=(((equal(bass_thresh, 2)*0.012)*sin((time*9)))+((1-equal(bass_thresh, 2))*dy_residual));
