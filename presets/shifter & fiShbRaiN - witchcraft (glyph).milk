per_frame_4=cha=0.01;
per_frame_5=gv=(if(abs(above(gv, bl))>0.00001,(if(abs(below(gv, ul))>0.00001,(if(abs(above(fps, rate))>0.00001,(gv+cha),(gv-cha))),(ul-0.1))),(bl+0.1)));
