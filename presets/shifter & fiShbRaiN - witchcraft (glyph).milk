per_frame_10=tic=min((time-tin), 0.1);
per_frame_11=tin=time;
per_frame_12=ra=(floor((1)/(tic))*0.25);
per_frame_13=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_14=vt=(vt+(tic*vav));
per_frame_15=q7=(4+sin((vt*2)));
per_frame_16=q8=(4+sin((vt*2)));
per_frame_17=mod=min(2, vav);
per_frame_18=q7=(6-mod);
per_frame_19=q8=(6-mod);
per_pixel_1=xnum=q7;
per_pixel_2=ynum=q8;
per_pixel_3=pi=3.141592654;
per_pixel_4=xfx=below(x, 0.5);
per_pixel_5=yfx=below(y, 0.5);
per_pixel_6=xseg=(floor(((x-0.5)*xnum))-xfx);
per_pixel_7=yseg=(floor(((y-0.5)*ynum))-yfx);
per_pixel_8=xsw=equal((((xseg+equal(((yseg)%(2)), 0)))%(2)), 0);
per_pixel_9=xsw=equal((((xseg+1))%(2)), 0);
per_pixel_10=ysw=equal((((yseg+1))%(2)), 0);
per_pixel_11=ox=(x-(xseg*floor((1)/(xnum))));
per_pixel_12=ox=(if(abs(xsw)>0.00001,((floor((1)/(xnum))-(ox-0.5))+0.5),ox));
per_pixel_13=oy=(y-(yseg*floor((1)/(ynum))));
per_pixel_14=oy=(if(abs(ysw)>0.00001,((floor((1)/(ynum))-(oy-0.5))+0.5),oy));
per_pixel_15=modx=(x-ox);
per_pixel_16=mody=(y-oy);
per_pixel_17=sw=(equal(xseg, 0)*equal(yseg, 0));
per_pixel_18=dx=(if(abs(sw)>0.00001,0,modx));
per_pixel_19=dy=(if(abs(sw)>0.00001,0,mody));
