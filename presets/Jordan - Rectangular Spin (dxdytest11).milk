per_frame_init_4=before = 0;
per_frame_init_5=counter = 0;
per_frame_init_6=status=0;
per_frame_init_7=total=0;
per_frame_1=total=(((total+bass_att)+mid_att)+treb_att);
per_frame_2=rot=(0.2*sin(floor((total)/(150))));
per_frame_3=dx=(0.005*sin(time));
per_frame_4=dy=(0.005*cos((time*1.11)));
per_frame_5=wave_r=min(1, (2*max((bass_att-1), 0)));
per_frame_6=wave_b=min(1, (2*max((treb_att-1), 0)));
per_frame_7=wave_g=min(1, (2*max((mid_att-1), 0)));
per_frame_8=ib_r=min(1, (2*max((bass_att-1), 0)));
per_frame_9=ib_b=min(1, (2*max((treb_att-1), 0)));
per_frame_10=ib_g=min(1, (2*max((mid_att-1), 0)));
per_frame_11=ib_size=(0.03+(0.015*sin(floor((total)/(100)))));
per_frame_12=ob_size=(0.5+(0.25*sin(floor((total)/(200)))));
per_frame_13=a=(status+1);
per_frame_14=a=((a)%(2));
per_frame_15=before=status;
per_frame_16=status=(if(abs(above(counter, 50))>0.00001,(if(abs(((above(bass, 1.2)*above(mid, 1.2))*above(treb, 1.2)))>0.00001,a,status)),status));
per_frame_17=counter=(equal(before, status)*counter);
per_frame_18=counter=(counter+1);
per_frame_19=monitor=((above(bass_att, 1.5)*above(mid_att, 1.5))*above(treb_att, 1.5));
per_frame_20=invert=status;
per_pixel_1=dx=(if(abs(above(x, 0.5))>0.00001,(dx+(rad*0.01)),(dx-(rad*0.01))));
per_pixel_2=dy=(if(abs(above(y, 0.5))>0.00001,(dy+(rad*0.01)),(dy-(rad*0.01))));
