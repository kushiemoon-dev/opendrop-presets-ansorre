per_frame_15=ripple3r=((ripple3r+ripple3s)*below(ripple3r, 2.7));
per_frame_16=q1=(if(abs(equal(((frame)%(3)), 0))>0.00001,ripple1x,(if(abs(equal(((frame)%(3)), 1))>0.00001,ripple2x,ripple3x))));
per_frame_17=q2=(if(abs(equal(((frame)%(3)), 0))>0.00001,ripple1y,(if(abs(equal(((frame)%(3)), 1))>0.00001,ripple2y,ripple3y))));
per_frame_18=q3=(if(abs(equal(((frame)%(3)), 0))>0.00001,ripple1r,(if(abs(equal(((frame)%(3)), 1))>0.00001,ripple2r,ripple3r))));
per_frame_19=wave_r=(wave_r+(0.350*((0.60*sin((0.980*time)))+(0.40*sin((1.047*time))))));
per_frame_20=wave_g=(wave_g+(0.350*((0.60*sin((0.835*time)))+(0.40*sin((1.081*time))))));
per_frame_21=wave_b=(wave_b+(0.350*((0.60*sin((0.814*time)))+(0.40*sin((1.011*time))))));
per_frame_22=wave_y=(wave_y+cos((time*0.20)));
