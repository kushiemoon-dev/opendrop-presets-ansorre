per_frame_4=ripple1x=(if(abs(equal(ripple1r, 0))>0.00001,(1.01*floor(int(rand(100)))),ripple1x));
per_frame_5=ripple1y=(if(abs(equal(ripple1r, 0))>0.00001,(1.01*floor(int(rand(100)))),ripple1y));
