PSVERSION_COMP=2
[preset00]
fDecay=0.5
mv_a=0.0
warp=0.011
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.86
fWaveAlpha=0.001
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=1.0
wavecode_0_smoothing=0.0
wave_0_init1=speed = 0;
wave_0_init2=v = 0;
wave_0_init3=xs = 0;
wave_0_init4=ys = 0;
wave_0_per_frame1=xs=0;
wave_0_per_frame2=ys=0;
wavecode_1_enabled=1.0
wavecode_1_smoothing=0.0
wave_1_init1=speed = 0;
wave_1_init2=v = 0;
wave_1_init3=xs = 0;
wave_1_init4=ys = 0;
wave_1_per_frame1=xs=floor(int(rand(100)));
wave_1_per_frame2=ys=floor(int(rand(100)));
wavecode_2_enabled=1.0
wavecode_2_smoothing=0.0
wave_2_init1=speed = 0;
wave_2_init2=v = 0;
wave_2_init3=xs = 0;
wave_2_init4=ys = 0;
wave_2_per_frame1=xs=floor(int(rand(100)));
wave_2_per_frame2=ys=floor(int(rand(100)));
wavecode_3_enabled=1.0
wavecode_3_smoothing=0.0
wave_3_init1=speed = 0;
wave_3_init2=v = 0;
wave_3_init3=xs = 0;
wave_3_init4=ys = 0;
wave_3_per_frame1=xs=floor(int(rand(100)));
wave_3_per_frame2=ys=floor(int(rand(100)));
per_frame_init_1=basstime = 0;
per_frame_init_2=xs = 0;
per_frame_init_3=bass_clip = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=x = 0;
per_frame_init_6=ys = 0;
per_frame_init_7=tx = 0;
per_frame_init_8=y = 0;
per_frame_init_9=q2 = 0;
per_frame_init_10=speed = 0;
per_frame_init_11=ty = 0;
per_frame_init_12=state=0;
per_frame_1=bass_clip=((above(bass_att, bass_clip)*2)+((1-above(bass_att, bass_clip))*(((bass_clip-1.3)*0.96)+1.3)));
per_frame_2=basstime=(basstime+(bass_att*0.09));
per_frame_3=monitor=basstime;
per_frame_4=speed=(bass*0.2);
per_frame_5=tx=(tx+(sin(basstime)*speed));
per_frame_6=ty=(ty+(sin(basstime)*speed));
per_frame_7=q1=sin((tx+equal(bass_clip, 2)));
per_frame_8=q2=sin((ty+equal(bass_clip, 2)));
per_frame_9=x=(0.5+(0.5*sin((xs*0.1))));
per_frame_10=y=(0.5+(0.5*sin((ys*0.1))));
per_frame_11=decay=(1-(bass*0.2));
per_pixel_1=zoom=1;
per_pixel_2=sx=(1-((x-q1)*0.05));
per_pixel_3=sy=(1-((y-q2)*0.05));
