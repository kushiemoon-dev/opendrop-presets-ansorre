wave_0_per_frame1=ba=(bass-0.9);
wave_0_per_frame2=tr=(treb-0.9);
wave_0_per_frame3=mi=(mid-0.9);
wave_0_per_frame4=xx=((xx+(ba*0.01))-(tr*0.001));
wave_0_per_frame5=yy=((yy+(tr*0.01))-(ba*0.001));
wave_0_per_frame6=xx=(xx+((cos((((frame*6.28)+bass)-1))*0.05)*q2));
wave_0_per_frame7=yy=(yy+((sin(((time*3.14)*q5))*0.05)*q2));
wave_0_per_frame8=xx=(if(abs(above(1, xx))>0.00001,(if(abs(below(0, xx))>0.00001,xx,1)),0));
wave_0_per_frame9=yy=(if(abs(above(1, yy))>0.00001,(if(abs(below(0, yy))>0.00001,yy,1)),0));
