per_frame_1=ff=(ff+2.7);
per_frame_2=bb=(((bb+bass)+mid)+treb);
per_frame_3=bt=floor((bb)/(ff));
per_frame_4=beat=above(bass, bt);
per_frame_5=beathard=(if(abs(beat)>0.00001,(bass-bt),0));
per_frame_6=monitor=beathard;
per_frame_7=decay=0.98;
per_frame_8=q1=beat;
