per_pixel_5=ybar=((above(cos(((dy_r*1.2)*time)), 0)*abs((4-(y*tan((4*cos((x*time))))))))+(below(cos(((dy_r*1.2)*time)), 0)*sin(((3*y)*sin((3*cos(((dy_r*x)*time))))))));
