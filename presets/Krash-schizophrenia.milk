per_frame_init_1=centerx = 0;
per_frame_init_2=centery = 0;
per_frame_init_3=newrad = 0;
per_frame_init_4=newang = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=(bass_att*0.3);
per_frame_3=wave_g=(treb_att*0.3);
per_frame_4=wave_b=(mid_att*0.3);
per_frame_5=wave_x=(0.5+(0.2*(sin((time*0.678))+sin((time*0.987)))));
per_frame_6=wave_y=(0.5-(0.2*(sin((time*0.876))+sin((time*0.789)))));
per_frame_7=zoom=((zoom+(bass_att*0.05))-0.02);
per_pixel_1=centerx=(0.5+(0.2*(sin((time*0.678))+sin((time*0.987)))));
per_pixel_2=centery=(0.5+(0.2*(sin((time*0.876))+sin((time*0.789)))));
per_pixel_3=newrad=sqrt((pow((centerx-x), 2)+pow((centery-y), 2)));
per_pixel_4=newang=atan(floor(((centerx-x))/((centery-y))));
per_pixel_5=dx=((newrad*sin((newang*10)))*0.05);
