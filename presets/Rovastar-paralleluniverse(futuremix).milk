per_frame_1=wave_r=(0.5+(0.5*sin(time)));
per_frame_2=xwave_a=0;
per_frame_3=ib_b=(0.5+(0.3*sin((time*2.314))));
per_frame_4=ib_r=(0.7+(0.3*sin((time*1.867))));
per_frame_5=q8=(if(abs(above(bass, 1.2))>0.00001,(2*bass),0.5));
per_frame_6=q7=(if(abs(above(bass_att, 1.2))>0.00001,(2*bass_att),0.5));
per_frame_7=q6=(if(abs(above((bass+bass_att), 2.3))>0.00001,(bass+bass_att),0.5));
per_frame_8=warp=0;
per_frame_9=q5=(if(abs(above((treb+treb_att), 2.8))>0.00001,1,0));
per_frame_10=monitor=q5;
per_frame_11=ob_r=q5;
per_frame_12=ib_g=q5;
per_pixel_1=myx=(x-0.5);
per_pixel_2=myy=(y-0.5);
per_pixel_3=q2=(0.2+(0*abs((0.1*sin((time*rad))))));
per_pixel_4=xdx=((myx*0.1)*myy);
per_pixel_5=q1=(0.05*sqrt(((x*x)+(y*y))));
per_pixel_6=q1=abs((0.05*(myx+myy)));
per_pixel_7=dy=(q1*abs(sin((50*bass))));
per_pixel_8=dx=(q1*abs(sin((50*bass_att))));
per_pixel_9=dy=((q2*q1)*q6);
per_pixel_10=dx=((q2*q1)*q6);
per_pixel_11=xrot=(if(abs(above(q1, 0.01))>0.00001,0,(-0.05*q6)));
per_pixel_12=zoom=((xrot*rad)+1);
