per_frame_1=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_2=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.75)+1.5)));
per_frame_3=bass_on=above(bass_thresh, 1.9);
per_frame_4=treb_on=above(treb_thresh, 1.9);
per_frame_5=swapcolour=(bass_on-treb_on);
per_frame_6=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,1,(if(abs(equal(swapcolour, 0))>0.00001,1,0))));
per_frame_7=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0.5,0.25))));
per_frame_8=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,1))));
per_frame_9=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,0.65,0.45))));
per_frame_10=green=(green+((green_aim-green)*0.5));
per_frame_11=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.45,0.65))));
per_frame_12=wave_r=(red-abs((0.1*sin(floor((time)/(1.4))))));
per_frame_13=wave_g=0;
per_frame_14=wave_b=(blue+abs((0.2*sin(floor((time)/(1.1))))));
per_frame_15=zoom=(if(abs(equal(bass_thresh, 2))>0.00001,(zoom*1.01),zoom));
per_frame_16=monitor=bass_thresh;
per_frame_17=wave_r=(bass_on+wave_r);
per_frame_18=wave_g=(bass_on+wave_g);
per_frame_19=wave_b=(bass_on+wave_b);
per_pixel_1=dx=(if(abs(above(x, 0.5))>0.00001,floor((sin((0.5-x)))/(15)),floor(((log(floor((1)/(x)))/2.302585092994046))/(45))));
per_pixel_2=xrot=(if(abs(above(rad, 0.4))>0.00001,(floor((cos(((rad*2)*x)))/(25))+floor((sin(pow(ang, 5)))/(25))),(floor((cos((1-rad)))/(25))+floor(((2*sin(-rad)))/(25)))));
per_pixel_3=rot=floor((xrot)/((1.4+(0.6*sin(time)))));
per_pixel_4=rot=(if(abs(equal(bass_thresh, 2))>0.00001,-rot,rot));
