per_frame_1=basstime=(basstime+(bass_att*0.03));
per_frame_2=q1=basstime;
per_pixel_1=fuzzy1=(pow(x, 2)*2);
per_pixel_2=fuzzy3=(-pow((x-1), 2)*2);
per_pixel_3=fuzzy2=(pow(y, 2)*2);
per_pixel_4=fuzzy4=(-pow((y-1), 2)*2);
per_pixel_5=f1=sin((q1-1.5707));
per_pixel_6=f2=sin(q1);
per_pixel_7=f3=sin((q1+1.5707));
per_pixel_8=f4=sin((q1+3.14));
per_pixel_9=f1=(f1*above(f1, 0));
per_pixel_10=f2=(f2*above(f2, 0));
per_pixel_11=f3=(f3*above(f3, 0));
per_pixel_12=f4=(f4*above(f4, 0));
per_pixel_13=sum_fuzzy=((((fuzzy1*f1)+(fuzzy2*f2))-(fuzzy3*f3))-(fuzzy4*f4));
per_pixel_14=zoom=0.8;
per_pixel_15=rot=0;
per_pixel_16=sx=(1-(sum_fuzzy*0.5));
per_pixel_17=sy=(1-(sum_fuzzy*0.5));
