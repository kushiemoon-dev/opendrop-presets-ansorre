MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
fDecay=0.976
fModWaveAlphaEnd=1.95
fModWaveAlphaStart=0.85
fWaveScale=0.054279
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
nWaveMode=6.0
ob_a=1.0
ob_size=0.005
warp=0.01
wave_b=0.4
wave_g=0.4
wave_r=0.4
fVideoEchoZoom=1.0
fWaveAlpha=1.0
nMotionVectorsX=1.0
nMotionVectorsY=48.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect2 = 0;
per_frame_init_2=bass_effect = 0;
per_frame_init_3=treb_effect = 0;
per_frame_init_4=net_effect = 0;
per_frame_init_5=rot_residual = 0;
per_frame_init_6=bass_thresh = 0;
per_frame_init_7=shift = 0;
per_frame_1=warp=0;
per_frame_2=bass_effect2=max(0, (max(bass_att, bass)-1.15));
per_frame_3=wave_g=(0.7+(0.3*sin((0.986*time))));
per_frame_4=wave_g=(if(abs(above(bass_effect2, 0))>0.00001,0,wave_g));
per_frame_5=wave_b=(0.5+(0.5*sin((1.164*time))));
per_frame_6=wave_b=(if(abs(above(bass_effect2, 0))>0.00001,0,wave_b));
per_frame_7=wave_r=(0.1+(0.4*sin((0.687*time))));
per_frame_8=wave_r=(if(abs(above(bass_effect2, 0))>0.00001,1,wave_r));
per_frame_9=bass_effect=(if(abs(above(bass_att, 1.4))>0.00001,pow(1.1, bass_att),1));
per_frame_10=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,pow(0.97, treb_att),1));
per_frame_11=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,bass_effect,treb_effect));
per_frame_12=zoom=net_effect;
per_frame_13=rot=(rot+rot_residual);
per_frame_14=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_15=shift=(tan((time*7))-0.05);
per_frame_16=shift=(if(abs(above(shift, 0))>0.00001,0,(if(abs(below(shift, -0.1))>0.00001,-0.1,shift))));
per_frame_17=rot_residual=(if(abs(equal(bass_thresh, 2))>0.00001,shift,rot_residual));
per_frame_18=mv_x=1.25;
per_pixel_1=rot=(rot+(if(abs(equal(sin(ang), 0))>0.00001,-rot,0.05)));
