per_frame_1=wave_r=(0.5+floor(((sin(floor((time)/(2)))-cos((time*0.22))))/(2)));
per_frame_2=wave_g=(0.5-floor((sin((time*0.877)))/(2)));
per_frame_3=wave_b=(0.5-floor((cos(time))/(2)));
