MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWaveScale=0.01
mv_a=0.0
mv_l=5.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
fWaveParam=-0.24
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=treble = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=(bass_att*0.33);
per_frame_3=wave_g=(treb_att*0.28);
per_frame_4=wave_b=(mid_att*0.3);
per_frame_5=zoom=((zoom+(bass_att*0.05))-0.04);
per_pixel_1=dx=(if(abs(above((bass+treble), 1.0))>0.00001,((rad*sin((-ang*10)))*0.05),((rad*sin((ang*10)))*0.05)));
per_pixel_2=sx=(floor((sin(rad))/(20))+1);
per_pixel_3=sy=(floor((sin(rad))/(18))+1);
per_pixel_4=warp=floor((rad)/(3));
