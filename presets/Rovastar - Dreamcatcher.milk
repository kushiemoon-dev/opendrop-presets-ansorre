per_frame_2=dcounter=(if(abs(equal(dcounter, 0))>0.00001,(if(abs(above(bass, 1.5))>0.00001,bass,dcounter)),(if(abs(below(dcounter, 0))>0.00001,0,(if(abs(above(bass_att, 1.35))>0.00001,(dcounter+0.14),(dcounter-0.14)))))));
