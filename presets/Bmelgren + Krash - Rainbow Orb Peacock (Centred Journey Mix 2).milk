per_frame_init_8=shift = 0;
per_frame_1=warp=floor((warp)/(bass));
per_frame_2=x_wave_x=(0.5+(0.3*sin(((bass+treb)+mid))));
per_frame_3=wave_r=(1+sin((-x_wave_x*6.28)));
per_frame_4=wave_g=abs(sin(((2*x_wave_x)*6.28)));
per_frame_5=wave_b=sin((x_wave_x*6.28));
per_frame_6=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,pow(0.99, treb_att),1));
per_frame_7=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,1,treb_effect));
per_frame_8=zoom=net_effect;
per_frame_9=rot=(rot+floor((rot_residual)/(1.5)));
per_frame_10=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_11=shift=(tan((time*7))-0.05);
per_frame_12=shift=(if(abs(above(shift, 0))>0.00001,0,(if(abs(below(shift, -0.1))>0.00001,-0.1,shift))));
per_frame_13=rot_residual=(if(abs(equal(bass_thresh, 2))>0.00001,shift,rot_residual));
per_frame_14=q1=net_effect;
per_frame_15=q2=bass_thresh;
per_pixel_1=rot=(rot+(if(abs(equal(tan(ang), q1))>0.00001,rot,floor((tan((q1-rad)))/(q2)))));
