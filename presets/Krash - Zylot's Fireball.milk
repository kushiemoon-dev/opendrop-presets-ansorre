per_frame_init_1=angval = 0;
per_frame_1=dx=(dx+(0.01*sin((time*0.2))));
per_frame_2=dy=(dy+(0.01*cos((time*0.2))));
per_frame_3=wave_g=(wave_g-floor((bass)/(6)));
per_pixel_1=angval=floor((0.2)/(sqrt(((3.14*tan((ang-(time*0.1))))+10))));
per_pixel_2=zoom=(zoom-floor(((rad*angval))/(10)));
per_pixel_3=rot=(rot-(if(abs(below((x+y), 0.15))>0.00001,floor((rad)/(0.15)),floor((rad)/((x+y))))));
