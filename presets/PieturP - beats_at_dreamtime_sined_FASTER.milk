per_frame_11=wr=(max((max(bass, bass_att)-1.2), 0)+0.5);
per_frame_12=wg=(max((max(treb, treb_att)-1.2), 0)+0.5);
per_frame_13=wb=(max((max(mid, mid_att)-1.2), 0)+0.5);
