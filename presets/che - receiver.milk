PSVERSION_COMP=2
[preset00]
bWaveThick=1.0
fDecay=0.97
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=1.0
fWaveScale=1.85396
fWaveSmoothing=0.0
ib_a=1.0
ib_size=0.1
mv_b=0.0
mv_l=1.0
nWaveMode=5.0
ob_a=1.0
ob_size=0.2
warp=0.0
wave_x=0.190001
wave_y=0.75
zoom=1.000223
fVideoEchoZoom=0.513668
fWaveAlpha=1.000416
fZoomExponent=1.000158
