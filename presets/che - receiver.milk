nMotionVectorsY=7.800001
fWaveParam=0.52
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=tb = 0;
per_frame_init_3=asnd = 0;
per_frame_init_4=wm = 0;
per_frame_init_5=etm = 0;
per_frame_init_6=ecp = 0;
per_frame_init_7=etm=time;
per_frame_1=dx=((0.3*(bass-1.7))*above(bass, 1.8));
per_frame_2=tb=(if(abs(band(above((bass_att+treb), 5), above((time-tb), 1)))>0.00001,time,tb));
per_frame_3=q1=above(time, (tb+0.15));
per_frame_4=zoom=(0.57+(0.4*q1));
per_frame_5=mv_a=(if(abs(q1)>0.00001,above(mid, 2),1));
per_frame_6=ob_size=(0.2-(0.2*q1));
per_frame_7=ib_size=(0.1-(0.1*q1));
per_frame_8=ib_r=equal((((7*time))%(3)), 0);
per_frame_9=ib_g=equal((((5*time))%(3)), 0);
per_frame_10=ib_b=equal((((6*time))%(3)), 0);
per_frame_11=asnd=(((bass_att+mid_att)+treb_att)*0.333);
per_frame_12=wave_r=((0.5+bass_att)-asnd);
per_frame_13=wave_g=((0.5+treb_att)-asnd);
per_frame_14=wave_b=((0.5+mid_att)-asnd);
per_frame_15=mv_r=wave_r;
per_frame_16=mv_g=wave_g;
per_frame_17=wm=(if(abs(above((mid+bass), 4.3))>0.00001,(if(abs(above(wm, 2))>0.00001,0,(wm+1))),wm));
per_frame_18=wave_mode=(if(abs(equal(wm, 0))>0.00001,5,(if(abs(equal(wm, 1))>0.00001,0,(if(abs(equal(wm, 2))>0.00001,5,7))))));
per_frame_19=etm=(if(abs(band(above((mid_att+treb_att), 4.7), above((time-etm), 2)))>0.00001,time,etm));
per_frame_20=ecp=(time-etm);
per_frame_21=echo_alpha=(if(abs(below(ecp, 1.75))>0.00001,min((2.7*sin((0.557*ecp))), 1),0));
per_pixel_1=dx=(if(abs(q1)>0.00001,(dx+(if(abs(band(below(x, 0.5), below(y, 0.5)))>0.00001,-0.5,(if(abs(band(above(x, 0.5), above(y, 0.5)))>0.00001,0.5,0))))),0));
per_pixel_2=dy=(if(abs(q1)>0.00001,(dy+(if(abs(band(above(x, 0.5), below(y, 0.5)))>0.00001,-0.5,(if(abs(band(below(x, 0.5), above(y, 0.5)))>0.00001,0.5,0))))),0));
