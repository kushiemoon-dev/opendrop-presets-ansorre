per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=crude=(2*abs(((12*sin((rad-(floor((1)/(12))*rad))))*(4*rad))));
per_pixel_5=arc=cos((2*cos((1-abs(tan(((2*rad)-sin((12*rad)))))))));
per_pixel_6=cinc=((above(sin(bass_att), 1)*arc)+(below(sin(bass_att), 2)*crude));
per_pixel_7=rot=(rot+(0.01*arc));
per_pixel_8=zoom=(zoom+(0.001*(crude-arc)));
per_pixel_9=dx=(dx+(dx_r*cinc));
