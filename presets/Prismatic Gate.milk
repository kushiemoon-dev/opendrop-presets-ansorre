per_frame_3=dy=(dy-0.001);
per_frame_4=wave_r=(wave_r+(0.33*sin(time)));
per_frame_5=wave_g=(wave_g+(0.33*sin((time*0.888))));
per_frame_6=wave_b=(wave_g+(0.33*sin((time*0.999))));
per_pixel_1=zoom=(zoom+((abs((x-0.5))+abs((y-0.5)))*tan(((rad*100)+(time*0.1)))));
