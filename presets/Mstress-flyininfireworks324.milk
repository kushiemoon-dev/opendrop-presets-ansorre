MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
bWaveDots=1.0
fGammaAdj=1.998
fWarpScale=2.853
fWaveScale=0.472722
fWaveSmoothing=0.027
ib_size=0.0
mv_a=0.0
nWaveMode=5.0
ob_size=0.0
warp=0.01
wave_b=0.6
wave_g=0.6
wave_r=0.77
wave_x=0.42
zoom=1.019934
bAdditiveWaves=1.0
fWaveAlpha=1.179297
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=mrad = 0;
per_frame_init_2=prova = 0;
per_frame_init_3=xpos = 0;
per_frame_init_4=yspos = 0;
per_frame_init_5=ypos = 0;
per_frame_init_6=bass_trig = 0;
per_frame_1=wave_r=min(1, max(0, (0.2*bass)));
per_frame_2=wave_g=min(1, max(0, (0.2*mid)));
per_frame_3=wave_b=min(1, max(0, (0.2*treb)));
per_frame_4=xpos=(0.01*int(rand(80)));
per_frame_5=yspos=(0.01*int(rand(80)));
per_frame_6=ypos=floor((max(0, (bass_att-0.3)))/(2));
per_frame_7=wave_x=((wave_x+xpos)-0.4);
per_frame_8=wave_y=(wave_y+min((yspos-0.4), 0.9));
per_frame_9=decay=min((decay+(0.016*floor((((treb+mid)+bass))/(3)))), 1);
per_frame_10=bass_trig=max((bass_att-1.2), 0);
per_frame_11=zoom=(zoom+(0.04*(0.3+sin(((time*0.3)+(bass_trig*6))))));
per_frame_12=dy=(dy+((sin((time*0.2))*0.9)*(0.015+(((abs(zoom)-1)*10)*0.02))));
per_frame_13=dx=(dx+((sin((time*0.5))*0.9)*(0.015+(((abs(zoom)-1)*10)*0.02))));
per_frame_14=rot=(rot+(((if(abs(above(bass_trig, 0))>0.00001,(int(rand(10))-5),0))*0.1)*0.1));
per_frame_15=monitor=rot;
per_pixel_1=mrad=(sqr((pow((x-(0.5-(sin((time*0.5))*0.5))), 2)+pow((y-(0.5-(sin((time*0.2))*0.5))), 2)))*sqr(2));
per_pixel_2=zoom=(zoom+(0.01+(mrad*0.05)));
per_pixel_3=prova=(0.13*max((bass_att-1.3), 0));
