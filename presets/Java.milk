MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
fGammaAdj=1.602
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWarpScale=1.331
fWaveScale=0.669541
fWaveSmoothing=0.63
ib_b=0.65
nWaveMode=4.0
ob_r=0.23
ob_size=0.015
warp=0.0101
wave_b=0.0
wave_g=0.0
wave_r=0.0
wave_x=0.0
wave_y=0.0
zoom=0.9995
fVideoEchoAlpha=0.5
fVideoEchoZoom=0.999609
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
fWaveParam=-1.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=bass_factor = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=madbass = 0;
per_frame_init_5=madtreb = 0;
per_frame_1=warp=0;
per_frame_2=wave_x=(0.4+(0.1*mid));
per_frame_3=wave_y=(0.4+(0.1*bass));
per_frame_4=wave_r=bass;
per_frame_5=wave_g=mid;
per_frame_6=wave_b=treb;
per_frame_7=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_8=madtreb=max((max(treb, treb_att)-1.3), 0);
per_frame_9=zoom=(zoom-(madbass*5));
per_frame_10=mv_x=(madtreb+1);
per_frame_11=mv_y=48;
per_frame_12=mv_r=(1-bass_att);
per_frame_13=mv_b=(1-treb_att);
per_frame_14=mv_g=(1-mid_att);
per_frame_15=mv_l=(madbass+2);
per_frame_16=q1=madbass;
per_frame_17=rot=(q1*0.05);
per_pixel_1=bass_effect=max((max(bass, bass_att)-0.8), 0);
per_pixel_2=bass_factor=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_pixel_3=zoom=(if(abs(below(-abs(ang), bass_factor))>0.00001,(1-((0.23*(1-x))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
per_pixel_4=cx=q1;
per_pixel_5=cy=q1;
