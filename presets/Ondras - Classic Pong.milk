per_frame_3=ddx=(ddx+((ddx*0.01)*cos(time)));
per_frame_4=ddy=(ddy+((ddy*0.01)*sin(time)));
per_frame_5=ddx=(ddx*(if(abs((above(xpos, (1-radius))*above(sign(ddx), 0)))>0.00001,-1,1)));
per_frame_6=ddx=(ddx*(if(abs((below(xpos, radius)*below(sign(ddx), 0)))>0.00001,-1,1)));
per_frame_7=ddy=(ddy*(if(abs((above(ypos, (1-radius))*above(sign(ddy), 0)))>0.00001,-1,1)));
per_frame_8=ddy=(ddy*(if(abs((below(ypos, radius)*below(sign(ddy), 0)))>0.00001,-1,1)));
per_frame_9=xpos=(xpos+ddx);
per_frame_10=ypos=(ypos+ddy);
per_frame_11=q1=xpos;
per_frame_12=q2=ypos;
per_frame_13=q3=radius;
