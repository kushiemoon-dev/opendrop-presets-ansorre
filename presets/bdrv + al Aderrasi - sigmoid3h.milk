per_pixel_31=ci=rad;
per_pixel_32=cb=0.25;
per_pixel_33=crs=2;
per_pixel_34=cr=((pow((floor((sin(((ci*6.3)-(cb*6.3))))/(2))+0.5), crs)*crx)+cr1);
per_pixel_35=cqr=(if(abs(above(ci, (0.25+cb)))>0.00001,cr,(crx+cr1)));
per_pixel_36=crr=(if(abs(below(ci, 1.5))>0.00001,cqr,(crx+cr1)));
per_pixel_37=jx1=crr;
per_pixel_38=kx1=(1-crr);
