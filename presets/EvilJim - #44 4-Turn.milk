MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.9
fGammaAdj=1.7
fWaveScale=0.499803
fWaveSmoothing=0.0
mv_a=0.0
nWaveMode=3.0
warp=0.01
wave_b=0.0
wave_g=0.0
fWaveAlpha=0.999744
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=decay=0.75;
per_frame_2=wave_r=sin(bass_att);
per_frame_3=wave_g=cos(treb);
per_frame_4=wave_b=tan((bass*mid_att));
per_frame_5=wave_x=(if(abs(above(floor((bass_att)/(bass)), 1))>0.00001,(wave_x+0.2),(wave_x-0.2)));
per_frame_6=wave_y=(if(abs(above(floor((mid_att)/(mid)), 1))>0.00001,(wave_y+0.2),(wave_y-0.2)));
per_frame_7=rot=(if(abs(above(floor((treb_att)/(treb)), 1))>0.00001,(floor((treb_att)/(treb))*0.02),(floor((treb_att)/(treb))*-0.02)));
