MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.9999
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=1.0
fWaveScale=0.301347
fWaveSmoothing=0.0
ib_a=1.0
ib_b=0.0
ib_g=0.0
ib_r=1.0
ib_size=0.015
mv_b=0.0
mv_dy=0.08
mv_l=2.5
mv_r=0.0
nWaveMode=5.0
ob_size=0.155
rot=0.08
warp=0.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
zoom=0.9611
fVideoEchoZoom=1.000499
fWaveAlpha=0.00691
fZoomExponent=1.000158
nMotionVectorsX=2.28
nMotionVectorsY=2.400007
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=vol1 = 0;
per_frame_init_2=vol2 = 0;
per_frame_1=wave_r=sin((time*1.5));
per_frame_2=wave_g=sin(time);
per_frame_3=wave_b=sin((time*2));
per_frame_4=vol1=min(1, max(0, ((bass+mid)-2)));
per_frame_5=ib_size=(vol1*0.03);
per_frame_6=ib_r=(((bass-bass_att)*2)+0.5);
per_frame_7=ib_g=(((mid-mid_att)*1.5)+0.5);
per_frame_8=ib_b=(((treb-treb_att)*2)+0.5);
per_frame_9=mv_a=(1-vol1);
per_frame_10=vol2=above(treb_att, 2.7);
per_frame_11=zoom=(if(abs(vol2)>0.00001,5,0.967));
per_frame_12=rot=(mid_att*0.1);
per_frame_13=ob_a=(if(abs(vol2)>0.00001,1,0));
per_frame_14=mv_r=above(bass, max(mid, treb));
per_frame_15=mv_g=above(mid, max(bass, treb));
per_frame_16=mv_b=above(treb, max(mid, bass));
