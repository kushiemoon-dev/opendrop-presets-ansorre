MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bDarkenCenter=1.0
bWaveThick=1.0
fDecay=0.996
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.05325
fWaveSmoothing=0.63
ib_a=1.0
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.015
mv_a=0.0
ob_a=1.0
ob_b=0.001
ob_r=0.012
ob_size=0.0105
rot=-1.0
warp=0.01
wave_b=0.5
wave_g=0.5
wave_r=0.5
zoom=0.989618
bAdditiveWaves=1.0
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.006596
nVideoEchoOrientation=1.0
fWaveAlpha=4.099998
fWaveParam=-0.16
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=setbass = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=myzoom = 0;
per_frame_init_4=mybass = 0;
per_frame_init_5=oldbass = 0;
per_frame_1=ib_g=((ib_g+0.5)+(0.5*sin((time*0.45))));
per_frame_2=ib_r=((ib_r+0.5)+(0.5*sin((time*1.45))));
per_frame_3=ib_b=((ib_b+0.5)+(0.5*sin((time*0.7))));
per_frame_4=ib_size=(ib_size+(0.01*sin((10*time))));
per_frame_5=wave_b=(wave_b-(0.5*sin((time*0.645))));
per_frame_6=wave_r=(wave_r+(0.5*sin((time*1.22))));
per_frame_7=wave_g=(wave_g+(0.5*sin((time*1.14))));
per_frame_8=myzoom=(if(abs(above(bass, 1))>0.00001,zoom,(zoom+(0.03*(bass+bass_att)))));
per_frame_9=zoom=myzoom;
per_frame_10=ob_r=(ib_g-ib_r);
per_frame_11=ob_b=(0.5+(0.5*sin((time*0.836))));
per_frame_12=ob_g=(0.5+(0.5*cos((time*1.123))));
per_frame_13=mybass=(if(abs(above(treb, 1))>0.00001,myzoom,oldbass));
per_frame_14=oldbass=mybass;
per_frame_15=wave_mystery=(wave_mystery+(3*(mybass-1)));
per_frame_16=q1=mybass;
per_pixel_1=setbass=(if(abs(above((treb+treb_att), 3))>0.00001,(0.55*(bass+bass_att)),setbass));
per_pixel_2=rot=(ang*sin((ang*setbass)));
per_pixel_3=zoom=(if(abs(above(rot, 0))>0.00001,(zoom+(0.1*rot)),(zoom-(0.06*q1))));
per_pixel_4=zoomexp=(if(abs(above(rot, 0))>0.00001,(zoomexp*rot),(zoomexp-(0.06*q1))));
