MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
dx=0.005
fDecay=0.979501
fGammaAdj=1.0
mv_a=0.0
warp=0.0
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.999799
fWaveAlpha=0.001
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=1.0
wavecode_0_smoothing=0.0
wave_0_init1=speed = 0;
wave_0_init2=v = 0;
wave_0_init3=xs = 0;
wave_0_init4=ys = 0;
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=bass_clip = 0;
per_frame_init_3=basstime = 0;
per_frame_init_4=state = 0;
per_frame_init_5=q2 = 0;
per_frame_init_6=state=0;
per_frame_1=bass_clip=((above(bass_att, bass_clip)*2)+((1-above(bass_att, bass_clip))*(((bass_clip-1.3)*0.96)+1.3)));
per_frame_2=basstime=(basstime+(bass_att*0.09));
per_frame_3=state=(state+equal(bass_clip, 2));
per_frame_4=state=(if(abs(above(state, 4))>0.00001,0,state));
per_frame_5=q1=state;
per_frame_6=q2=basstime;
per_frame_7=monitor=time;
per_pixel_1=dx=(1+(0.01*sin((bass*3))));
per_pixel_2=dy=(1+(0.01*sin((bass*4))));
per_pixel_3=zoom=(1.05-((((sin((x+bass))*sin((ang*14)))-0.45)*0.05)*bass));
per_pixel_4=rot=((equal(q1, 0)*0.01)-(equal(q1, 1)*0.01));
