per_frame_1=warp=0;
per_frame_2=xdx=(dx-0.001);
per_frame_3=xdy=(dy-0.001);
per_frame_4=wave_mystery=(0.2*time);
per_frame_5=volume=(0.3*((bass+mid)+att));
per_frame_6=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_7=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_8=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_9=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_10=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_11=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_12=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_13=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_14=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_15=beatcounter=(if(abs(above(progress, 0.01))>0.00001,(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter)),0));
per_frame_16=beatcounter=(if(abs(above(beatcounter, 101))>0.00001,0,beatcounter));
per_frame_17=wave_r=(if(abs(above(((beatcounter)%(2)), 0))>0.00001,1,0));
per_frame_18=wave_b=(if(abs(below(((beatcounter)%(2)), 1))>0.00001,1,0));
per_frame_19=wave_g=(treb_att*0.3);
per_frame_20=beateven=((beatcounter)%(4));
per_frame_21=rot=(if(abs(equal(beateven, 1))>0.00001,0.12,(if(abs(equal(beateven, 3))>0.00001,-0.1,0))));
per_frame_22=mv_g=(mv_g+(0.4*sin((time*0.578))));
per_frame_23=mv_b=(mv_b+(0.4*sin((time*0.878))));
per_frame_24=mv_r=(mv_r+(0.4*sin((time*0.678))));
