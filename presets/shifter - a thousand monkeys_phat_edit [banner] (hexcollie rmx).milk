per_frame_1=warp=0;
per_frame_2=tic=min((time-tin), 0.1);
per_frame_3=tin=time;
per_frame_4=vol=(((bass_att+treb_att)+mid_att)*0.333333);
per_frame_5=ra=(floor((1)/(tic))*0.25);
per_frame_6=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_7=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_8=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_9=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_10=tt=(tt+(tic*treb));
per_frame_11=mt=(mt+(tic*mid));
per_frame_12=bt=(bt+(tic*bass));
per_frame_13=vt=(vt+(tic*vav));
per_frame_14=q1=(tt*2);
per_frame_15=q2=(mt*2);
per_frame_16=q3=(bt*2);
per_frame_17=q4=vt;
per_frame_18=rb=(if(abs(rb)>0.00001,rb,(0.2+((floor(int(rand(1001)))*0.001)*0.6))));
per_frame_19=rc=(if(abs(rc)>0.00001,rc,(0.2+((floor(int(rand(1001)))*0.001)*0.6))));
per_frame_20=rd=(if(abs(rd)>0.00001,rd,(0.2+((floor(int(rand(1001)))*0.001)*0.6))));
per_frame_21=re=(if(abs(re)>0.00001,re,(0.2+((floor(int(rand(1001)))*0.001)*0.6))));
per_frame_22=rot=0.26;
per_frame_23=cx=((0.3+(0.1*sin((vt*re))))+(0.1*cos((vt*rc))));
per_frame_24=cy=((0.5+(0.2*sin((vt*rb))))+(0.1*cos((vt*rd))));
per_pixel_1=num=8;
per_pixel_2=pi=3.141592654;
per_pixel_3=radi=((y-0.5)*0.75);
per_pixel_4=radi=(y-0.5);
per_pixel_5=radi=pow(((radi*radi)+((x-0.5)*(x-0.5))), 0.5);
per_pixel_6=an=((ang+pi)+time);
per_pixel_7=an=(an-((pi*2)*floor(floor((an)/((pi*2))))));
per_pixel_8=mod=0.1;
per_pixel_9=seg=(ang+pi);
per_pixel_10=seg=(floor((seg)/((pi*2)))*num);
per_pixel_11=seg=floor(seg);
per_pixel_12=seg=(seg-equal(seg, num));
per_pixel_13=anga=((ang+pi)-(floor(((pi*2))/(num))*seg));
per_pixel_14=anga=(if(abs(equal(((seg)%(2)), 0))>0.00001,(floor(((pi*2))/(num))-anga),anga));
per_pixel_15=anga=(anga+floor((pi)/(4)));
per_pixel_16=ox=(0.5-(radi*sin(anga)));
per_pixel_17=oy=(0.5+(radi*cos(anga)));
per_pixel_18=dx=(equal(seg, 3)*(x-ox));
per_pixel_19=dy=(equal(seg, 3)*(y-oy));
per_pixel_20=dx=(above(seg, 0)*(x-ox));
per_pixel_21=dy=(above(seg, 0)*(y-oy));
