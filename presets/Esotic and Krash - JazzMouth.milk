per_frame_init_1=volume = 0;
per_frame_init_2=att = 0;
per_frame_init_3=beatrate = 0;
per_frame_init_4=lastbeat = 0;
per_frame_init_5=meanbass_att = 0;
per_frame_init_6=beat = 0;
per_frame_init_7=peakbass_att = 0;
per_frame_init_8=q1 = 0;
per_frame_1=volume=(0.3*((bass+mid)+att));
per_frame_2=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_3=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_4=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_5=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_6=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.5*((beatrate+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_7=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_8=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_9=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_10=q1=beat;
per_frame_11=wave_b=min(min((wave_r+treb), (wave_b*wave_g)), (zoom-zoom));
per_frame_12=cx=min(min((wave_g*treb), (wave_r-time)), (zoom-time));
per_frame_13=wave_r=(time+treb);
per_frame_14=wave_r=min((wave_r+treb), (time*wave_b));
per_frame_15=zoom=(zoom*bass);
per_frame_16=wave_b=(wave_b-wave_b);
per_frame_17=cx=min((cx*time), (wave_g*wave_g));
per_frame_18=wave_b=min((wave_b*treb), (treb*wave_r));
per_frame_19=cx=min((cx*treb), (wave_g-time));
per_frame_20=wave_g=min(min((wave_r*wave_r), (time*treb)), (wave_b*bass));
per_frame_21=cx=min(min((cx*wave_b), (wave_b+wave_g)), (time*treb));
per_frame_22=wave_r=min(min((wave_r-treb), (treb*bass)), (wave_b-treb));
per_frame_23=wave_r=min(min((wave_r+wave_b), (wave_b+treb)), (wave_r-zoom));
per_frame_24=wave_r=min((wave_r+wave_g), (wave_g*bass));
per_frame_25=wave_g=min(min((wave_g*treb), (bass*wave_r)), (wave_r+treb));
per_frame_26=wave_g=min(min((wave_g-wave_b), (wave_b*bass)), (wave_b*treb));
per_frame_27=wave_r=min(min((wave_r*bass), (treb-wave_r)), (time*treb));
per_pixel_1=dx=min((rad*ang), (ang*ang));
per_pixel_2=dx=max((dx-3), (ang*3));
per_pixel_3=dx=min((dx-rad), (rad+3));
per_pixel_4=dx=max((dx*rad), (rad+rad));
per_pixel_5=dx=min(min(max((dx+rad), (3+3)), (3*ang)), (3-rad));
per_pixel_6=dx=max(max((dx-ang), (ang-3)), (3-3));
per_pixel_7=dx=max(max((dx*3), (rad*rad)), (rad*ang));
per_pixel_8=dx=(dx+rad);
per_pixel_9=dx=min((dx*ang), (rad*rad));
per_pixel_10=dx=min((dx+rad), (ang*rad));
per_pixel_11=dx=min((dx-3), (3-rad));
per_pixel_12=dx=max(min((dx*rad), (3*rad)), (rad*rad));
