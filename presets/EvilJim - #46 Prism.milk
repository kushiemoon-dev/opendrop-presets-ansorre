per_frame_1=warp=0;
per_frame_2=decay=(if(abs(above(floor((bass_att)/(bass)), 0.9))>0.00001,1,0.5));
per_frame_3=wave_r=sin(bass_att);
per_frame_4=wave_g=cos(treb);
per_frame_5=wave_b=tan((bass*mid_att));
per_frame_6=wave_y=(floor((bass_att)/(bass))*0.5);
per_frame_7=rot=(if(abs(below(floor((mid_att)/(mid)), 1))>0.00001,(floor((bass_att)/(bass))*-0.1),0));
per_frame_8=cy=(if(abs(above(floor((treb_att)/(treb)), 1))>0.00001,1,0));
