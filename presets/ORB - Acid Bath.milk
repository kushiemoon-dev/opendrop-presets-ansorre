MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
bInvert=1.0
fDecay=1.0
ib_b=1.0
ib_g=1.0
ib_r=1.0
mv_a=0.0
ob_a=0.2
ob_b=1.0
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=1.02
fVideoEchoAlpha=0.5
fVideoEchoZoom=0.99663
fWaveAlpha=0.001
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=1.0
wave_0_init1=n = 0;
wave_0_init2=size = 0;
wave_0_init3=q2 = 0;
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=basstime = 0;
per_frame_init_2=stickybit = 0;
per_frame_init_3=volavg2 = 0;
per_frame_init_4=q1 = 0;
per_frame_init_5=sum = 0;
per_frame_init_6=diff = 0;
per_frame_init_7=edge = 0;
per_frame_init_8=rule3 = 0;
per_frame_init_9=rule2 = 0;
per_frame_init_10=volavg = 0;
per_frame_init_11=bit2 = 0;
per_frame_init_12=rule4 = 0;
per_frame_init_13=state = 0;
per_frame_init_14=vol = 0;
per_frame_init_15=rule1 = 0;
per_frame_init_16=q2 = 0;
per_frame_init_17=basssum = 0;
per_frame_init_18=sum1 = 0;
per_frame_1=basstime=(basstime+(bass_att*0.03));
per_frame_2=vol=pow(((bass+mid)+treb), 2);
per_frame_3=basssum=vol;
per_frame_4=stickybit=((time)%(2));
per_frame_5=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_6=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_7=edge=bnot(equal(bit2, stickybit));
per_frame_8=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_9=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_10=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(volavg2)),0));
per_frame_11=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(volavg)),diff));
per_frame_12=bit2=((time)%(2));
per_frame_13=q1=(diff*2);
per_frame_14=state=(state+above(diff, 0.15));
per_frame_15=state=(if(abs(above(state, 3))>0.00001,0,state));
per_frame_16=echo_orient=state;
per_frame_17=ob_r=(0.5+(0.5*sin((basstime*4.5))));
per_frame_18=ob_g=(0.5+(0.5*sin((basstime*5))));
per_frame_19=ob_b=(0.5+(0.5*sin((basstime*3.8))));
per_frame_20=q2=basstime;
per_frame_21=monitor=diff;
per_pixel_1=rule1=((x*x)*floor(int(rand(5))));
per_pixel_2=rule2=((y*y)*floor(int(rand(10))));
per_pixel_3=rule3=((ang*ang)*floor(int(rand(1))));
per_pixel_4=rule4=((rad*rad)*floor(int(rand(5))));
per_pixel_5=sum=((((cos(q2)*rule1)+(cos((q2+1.78))*rule3))+(cos((q2+3.14))*rule2))+(cos((q2+4.92))*rule4));
per_pixel_6=sum1=cos(sum);
per_pixel_7=rot=((((1*q1)*sum)*0.1)+(sum1*0.1));
per_pixel_8=zoom=(1-q1);
per_pixel_9=sx=(1-(q1*0.6));
per_pixel_10=sy=(1-(q1*0.6));
per_pixel_11=cx=(0.5+(0.3*sin((q2*0.5))));
per_pixel_12=cy=(0.5+(0.3*sin(((q2*0.7)+(q2*0.2)))));
per_pixel_13=zoom=(1-q1);
