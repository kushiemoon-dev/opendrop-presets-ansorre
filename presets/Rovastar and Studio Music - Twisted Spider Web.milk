MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
bDarkenCenter=1.0
bModWaveAlphaByVolume=1.0
bWaveDots=1.0
dx=0.5
dy=0.5
fDecay=0.99
fWarpScale=10.784599
fWaveScale=0.995868
fWaveSmoothing=0.837
ib_a=0.95
ib_b=0.5
ib_g=0.5
ib_r=0.5
nWaveMode=5.0
ob_a=0.95
ob_b=0.5
ob_g=0.5
ob_r=0.5
sx=0.9999
wave_b=0.5
wave_g=0.4999
wave_r=0.5
zoom=1.009989
bAdditiveWaves=1.0
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.001799
nVideoEchoOrientation=1.0
fWaveAlpha=0.995648
fZoomExponent=1.0017
bMotionVectorsOn=0.0
nMotionVectorsX=64.0
nMotionVectorsY=1.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=treb_effect = 0;
per_frame_1=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_2=treb_effect=max((max(treb, treb_att)-1.2), 0);
per_frame_3=warp=(0.25+(bass_att*1.25));
per_frame_4=ib_r=(ib_r-(0.5*sin((time*0.391))));
per_frame_5=ib_g=(ib_g+(0.5*sin((time*1.527))));
per_frame_6=ib_b=(ib_b-(0.5*sin((time*1.843))));
per_frame_7=ob_r=(1-ib_r);
per_frame_8=ob_g=(1-ib_g);
per_frame_9=ob_b=(1-ib_b);
per_frame_10=ob_size=(if(abs(above(bass_effect, 0))>0.00001,(0.001+(0.0065*bass_effect)),0.001));
per_frame_11=ib_size=(if(abs(above(treb_effect, 0))>0.00001,(0.001+(0.0065*treb_effect)),0.001));
per_frame_12=zoom=(1.35+(0.2*sin(time)));
per_pixel_1=rot=((rot+1)+log((sqrt(2)-rad)));
per_pixel_2=zoom=((zoom-(0.5*rad))+(0.1*sin(rad)));
