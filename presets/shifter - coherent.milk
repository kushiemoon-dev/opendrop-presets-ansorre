per_frame_24=q8=((0.5+(((0.35*sin((bt*0.132)))+(0.35*sin((bt*0.632))))*st))*sw);
per_pixel_1=vol=(((mid+bass)+treb)*0.33333);
per_pixel_2=st=0.25;
per_pixel_3=xd=(q1-x);
per_pixel_4=yd=(q2-y);
per_pixel_5=dis=pow(((xd*xd)+(yd*yd)), 0.5);
per_pixel_6=an=acos(floor((abs(yd))/(dis)));
per_pixel_7=dx=((((sign(xd)*vol)*st)*cos(an))*(1.414-dis));
