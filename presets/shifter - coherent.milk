per_pixel_9=xd=(q3-x);
per_pixel_10=yd=(q4-y);
per_pixel_11=dis=pow(((xd*xd)+(yd*yd)), 0.5);
per_pixel_12=an=acos(floor((abs(yd))/(dis)));
