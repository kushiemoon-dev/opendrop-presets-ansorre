per_pixel_26=dy=(dy+((((sign(yd)*bass)*st)*sin(an))*(1.414-dis)));
per_pixel_27=dx=(dx*(1-equal((((((((q1+q2)+q3)+q4)+q5)+q6)+q7)+q8), 0)));
