per_frame_init_1=meanbass_att = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=lastbeat = 0;
per_frame_init_4=beatrate = 0;
per_frame_init_5=peakbass_att = 0;
per_frame_init_6=att = 0;
per_frame_init_7=volume = 0;
per_frame_init_8=beat = 0;
per_frame_init_9=q3 = 0;
per_frame_1=volume=(0.3*((bass+mid)+att));
per_frame_2=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_3=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_4=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_5=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_6=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.5*((beatrate+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_7=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_8=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_9=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_10=q1=beat;
per_pixel_1=rot=(if(abs(above(bnot((1*bass)), bnot((1*treb))))>0.00001,(rot*sin((rad*sin(time)))),(-rot*sin((rad*cos(time))))));
per_pixel_2=warp=(peakbass_att*ang);
per_pixel_3=zoomexp=(0.88871884*sqr((-0.67485964*sign((ang-ang)))));
per_pixel_4=cy=(0.34421277*pow((y*q1), (x*q3)));
per_pixel_5=cx=bor((x*rot), (q1*x));
per_pixel_6=zoomexp=(if(abs(below(zoomexp, 0.01))>0.00001,0.01,zoomexp));
per_pixel_7=zoomexp=(if(abs(above(zoomexp, 100.0))>0.00001,100.0,zoomexp));
per_pixel_8=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_9=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_10=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_pixel_11=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_pixel_12=cx=(if(abs(below(cx, -1.0))>0.00001,-1.0,cx));
per_pixel_13=cx=(if(abs(above(cx, 2.0))>0.00001,2.0,cx));
per_pixel_14=cy=(if(abs(below(cy, -1.0))>0.00001,-1.0,cy));
per_pixel_15=cy=(if(abs(above(cy, 2.0))>0.00001,2.0,cy));
