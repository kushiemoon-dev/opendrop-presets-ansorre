per_frame_1=wv_x=((wv_x+sin((time*(if(abs(above(bass_att, 0))>0.00001,bass_att,-bass_att)))))+0.67);
per_frame_2=wv_y=((wv_y+cos((time*(if(abs(above(bass_att, 0))>0.00001,bass_att,-bass_att)))))+0.87);
