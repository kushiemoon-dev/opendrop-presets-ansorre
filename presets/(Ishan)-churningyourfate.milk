per_frame_8=rot=(rot+(if(abs(above(sin(time), 0))>0.00001,0.1,-0.1)));
per_pixel_1=rot=(rot+((rad+bass_att)*0.1));
per_pixel_2=rot=(sqrt((rad-rot))+rot);
per_pixel_3=rot=sqr(((rot+1)-(1+rad)));
