MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWaveScale=1.028415
fWaveSmoothing=0.72
wave_b=0.5
wave_g=0.5
wave_r=0.5
fWaveAlpha=1.315701
bMotionVectorsOn=0.0
fWaveParam=-0.2
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=unknown = 0;
per_frame_1=dx=(dx-0.001);
per_frame_2=dy=(dy-0.001);
per_frame_3=warp=0;
per_frame_4=wave_r=0;
per_frame_5=wave_b=wave_b;
per_frame_6=wave_g=(wave_g+(0.1*sin(time)));
per_pixel_1=unknown=(rad+floor(((rad-(rad*0.4)))/(((x-0.5)*(y-0.5)))));
per_pixel_2=dx=(if(abs(below(y, 0.5))>0.00001,(dx-(unknown*0.001)),((dx-0.045)+(0.01*int(rand(10))))));
per_pixel_3=dy=(if(abs(above(y, 0.5))>0.00001,(dy+0.01),dy));
per_pixel_4=sx=(if(abs(above(y, 0.5))>0.00001,(sx+(y*0.05)),sx));
