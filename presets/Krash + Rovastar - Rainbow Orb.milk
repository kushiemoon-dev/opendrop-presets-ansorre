per_frame_3=dy=-0.0005;
per_frame_4=wave_x=(0.5+(0.3*sin(((bass+treb)+mid))));
per_frame_5=wave_r=(1+sin((-wave_x*6.28)));
per_frame_6=wave_g=abs(sin(((2*wave_x)*6.28)));
per_frame_7=wave_b=sin((wave_x*6.28));
per_frame_8=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,pow(0.99, treb_att),1));
per_frame_9=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,1,treb_effect));
per_frame_10=zoom=(net_effect*1.065);
per_frame_11=rot=(rot+rot_residual);
per_frame_12=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_13=shift=(tan((time*7))-0.05);
per_frame_14=shift=(if(abs(above(shift, 0))>0.00001,0,(if(abs(below(shift, -0.1))>0.00001,-0.1,shift))));
per_frame_15=rot_residual=(if(abs(equal(bass_thresh, 2))>0.00001,shift,rot_residual));
per_pixel_1=rot=(rot+(if(abs(equal(sin(ang), 0))>0.00001,rot,floor((sin((1-rad)))/(2)))));
