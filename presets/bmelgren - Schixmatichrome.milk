MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
fGammaAdj=2.4
fWaveScale=0.5
fWaveSmoothing=0.3
nWaveMode=5.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.0
nVideoEchoOrientation=2.0
fWaveAlpha=25.0
bMotionVectorsOn=0.0
fWaveParam=-0.48
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=wave_x=(wave_x+(0.3*((0.6*sin((2*time)))+(0.4*sin((1.6*time))))));
per_frame_2=wave_y=(wave_y+(0.4*((0.6*sin((1.7*time)))+(0.4*sin((2.3*time))))));
per_frame_3=wave_r=min(1, max(0, (0.4*bass)));
per_frame_4=wave_g=min(1, max(0, (0.4*mid)));
per_frame_5=wave_b=min(1, max(0, (0.4*treb)));
per_frame_6=rot=(rot+(0.01*((0.5*sin((0.4*time)))+(0.4*sin((0.6*time))))));
per_frame_7=zoomexp=(zoomexp+(mid_att*40));
per_frame_8=decay=(decay-(0.01*equal(((frame)%(80)), 0)));
per_pixel_1=cx=tan((ang+(mid_att*0.8)));
per_pixel_2=cy=tan((ang+(mid_att*0.8)));
