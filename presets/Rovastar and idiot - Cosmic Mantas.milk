per_frame_init_24=swapcolour = 0;
per_frame_init_25=green_aim = 0;
per_frame_1=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_2=treb_thresh=((above(treb_att, treb_thresh)*2)+((1-above(treb_att, treb_thresh))*(((treb_thresh-1.5)*0.75)+1.5)));
per_frame_3=mid_thrsh=((above(mid_att, mid_thresh)*2)+((1-above(mid_att, mid_thresh))*(((mid_thresh-1.5)*0.75)+1.5)));
per_frame_4=bass_on=above(bass_thresh, 1.8);
per_frame_5=treb_on=above(treb_thresh, 1.9);
per_frame_6=beat_on=above(beat, 1);
per_frame_7=swapcolour=((beat_on-treb_on)-(0.2*q1));
per_frame_8=red_aim=(if(abs(equal(swapcolour, 1))>0.00001,1,(if(abs(equal(swapcolour, 0))>0.00001,1,0))));
per_frame_9=green_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0.5,0.25))));
per_frame_10=blue_aim=(if(abs(equal(swapcolour, 1))>0.00001,0,(if(abs(equal(swapcolour, 0))>0.00001,0,1))));
per_frame_11=red=(red+((red_aim-red)*(if(abs(equal(swapcolour, 1))>0.00001,0.65,0.45))));
per_frame_12=green=(green+((green_aim-green)*0.5));
per_frame_13=blue=(blue+((blue_aim-blue)*(if(abs(equal(swapcolour, 1))>0.00001,0.45,0.65))));
per_frame_14=wave_r=red;
per_frame_15=wave_g=green;
per_frame_16=wave_b=blue;
per_frame_17=volume=(0.3*((bass+mid)+bass_att));
per_frame_18=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_19=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_20=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_21=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_22=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.5*((beatrate+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_23=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_24=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_25=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_26=q1=beat;
per_frame_27=q2=bass_thresh;
per_frame_28=q3=mid_thresh;
per_frame_29=q4=treb_thresh;
per_pixel_1=my2=(floor((((frame)%(50)))/(50))*0.4);
per_pixel_2=dx=((0.01*q2)*bass);
per_pixel_3=dx=((if(abs(below(y, (-0.3+my2)))>0.00001,-dx,dx))*rad);
per_pixel_4=dx=(if(abs(below(y, (-0.1+my2)))>0.00001,-dx,dx));
per_pixel_5=dx=(if(abs(below(y, (0.1+my2)))>0.00001,-dx,dx));
per_pixel_6=dx=(if(abs(below(y, (0.3+my2)))>0.00001,-dx,dx));
per_pixel_7=dx=(if(abs(below(y, (0.5+my2)))>0.00001,-dx,dx));
per_pixel_8=dx=(if(abs(below(y, (0.7+my2)))>0.00001,-dx,dx));
per_pixel_9=dx=(if(abs(below(y, (0.9+my2)))>0.00001,-dx,dx));
per_pixel_10=dx=(if(abs(below(y, (1.1+my2)))>0.00001,-dx,dx));
per_pixel_11=dx=(if(abs(below(y, (1.3+my2)))>0.00001,-dx,dx));
per_pixel_12=dx=-0.02;
per_pixel_13=dy=((0.01*q2)*bass);
per_pixel_14=dy=((if(abs(below(x, (-0.3+my2)))>0.00001,-dy,dy))*rad);
per_pixel_15=dy=(if(abs(below(x, (-0.1+my2)))>0.00001,-dy,dy));
per_pixel_16=dy=(if(abs(below(x, (0.1+my2)))>0.00001,-dy,dy));
per_pixel_17=dy=(if(abs(below(x, (0.3+my2)))>0.00001,-dy,dy));
per_pixel_18=dy=(if(abs(below(x, (0.5+my2)))>0.00001,-dy,dy));
per_pixel_19=dy=(if(abs(below(x, (0.7+my2)))>0.00001,-dy,dy));
per_pixel_20=dy=(if(abs(below(x, (0.9+my2)))>0.00001,-dy,dy));
per_pixel_21=dy=(if(abs(below(x, (1.1+my2)))>0.00001,-dy,dy));
per_pixel_22=dy=(if(abs(below(x, (1.3+my2)))>0.00001,-dy,dy));
