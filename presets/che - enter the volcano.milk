per_frame_init_1=border = 0;
per_frame_init_2=q1 = 0;
per_frame_init_3=mvrot = 0;
per_frame_init_4=tcr = 0;
per_frame_1=mvrot=(if(abs(above((bass+treb), 4))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0,(mvrot+1))),mvrot));
per_frame_2=ib_r=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.039,(if(abs(equal(mvrot, 3))>0.00001,0.137,0.835)))),(if(abs(above(mvrot, 1))>0.00001,0.651,(if(abs(equal(mvrot, 0))>0.00001,1,0.773))))));
per_frame_3=ib_g=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.267,(if(abs(equal(mvrot, 3))>0.00001,0.886,0.176)))),(if(abs(above(mvrot, 1))>0.00001,0.804,(if(abs(equal(mvrot, 0))>0.00001,1,0.38))))));
per_frame_4=ib_b=(if(abs(above(mvrot, 2))>0.00001,(if(abs(above(mvrot, 4))>0.00001,0.694,(if(abs(equal(mvrot, 3))>0.00001,0.776,0.851)))),(if(abs(above(mvrot, 1))>0.00001,0.114,(if(abs(equal(mvrot, 0))>0.00001,1,0.145))))));
per_frame_5=tcr=(tcr+sqr(bass));
per_frame_6=q1=mvrot;
per_frame_7=ib_r=min(1, max(0, (ib_r+sin((0.15*tcr)))));
per_frame_8=ib_g=min((ib_r-0.1), max(0, (ib_g+sin((0.16*tcr)))));
per_frame_9=ib_b=min((ib_r-0.2), max(0, (ib_b+sin((0.17*tcr)))));
per_frame_10=wave_r=(0.8+(0.2*sin(time)));
per_frame_11=zoom=(zoom+(0.1*(bass_att+treb_att)));
per_pixel_1=border=bor(below(x, 0.05), above(x, 0.95));
per_pixel_2=zoom=(if(abs(border)>0.00001,1.01,zoom));
per_pixel_3=rot=(if(abs(border)>0.00001,0,(((-2*rot)*ang)+q1)));
per_pixel_4=dx=(if(abs(border)>0.00001,0,dx));
per_pixel_5=dy=(if(abs(border)>0.00001,0,dy));
