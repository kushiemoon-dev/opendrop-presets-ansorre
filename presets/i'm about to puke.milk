per_frame_1=bscale=(0.95+(treb_att*0.05));
per_frame_2=tscale=(0.95+(bass_att*0.05));
per_frame_3=mscale=(0.95+(bass_att*0.05));
per_frame_4=beatb=above(bass, (bass_att*bscale));
per_frame_5=beatbhard=(if(abs(beatb)>0.00001,(bass-(bass_att*bscale)),beatbhard));
per_frame_6=beatm=above(mid, (mid_att*mscale));
per_frame_7=beatmhard=(if(abs(beatm)>0.00001,(mid-(mid_att*mscale)),beatmhard));
per_frame_8=beatt=above(treb, (treb_att*tscale));
per_frame_9=beatthard=(if(abs(beatt)>0.00001,(treb-(treb_att*tscale)),beatthard));
per_frame_10=vol=((bass+mid)+treb);
per_frame_11=vol_att=((bass_att+mid_att)+treb_att);
per_frame_12=q1=beatb;
per_frame_13=q2=beatbhard;
per_frame_14=q3=beatm;
per_frame_15=q4=beatmhard;
per_frame_16=q5=beatt;
per_frame_17=q6=beatthard;
per_frame_18=decay=(0.999+(q1*0.001));
per_frame_19=worp=0;
per_frame_20=ob_r=((q1*0.5)+(q3*0.5));
per_frame_21=ob_g=((q6*q5)+(q4*q3));
per_frame_22=ob_b=(0.3-(q1*q2));
per_pixel_1=bbc=(bbc+((q1*0.1)*q2));
per_pixel_2=tbc=(tbc+((q5*0.1)*q6));
per_pixel_3=cx=((sin((bbc*3.14))*0.5)+0.5);
per_pixel_4=cy=((sin((tbc*3.14))*0.5)+0.5);
per_pixel_5=rot=(((q3*q4)*0.1)+((above(rad, 0.5)*q6)*0.1));
per_pixel_6=zoom=((1+((1-(rad*2))*0.1))+((below(rad, 0.5)*(q2*0.1))*rad));
