per_frame_init_1=re = 0;
per_frame_init_2=birth = 0;
per_frame_init_3=q2 = 0;
per_frame_init_4=vol_now = 0;
per_frame_init_5=vol_mean = 0;
per_frame_init_6=beat = 0;
per_frame_init_7=slowtime = 0;
per_frame_init_8=sumneg = 0;
per_frame_init_9=warp=0;
per_frame_1=rot=1;
per_frame_2=zoom=1;
per_frame_3=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_4=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_5=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
per_frame_6=slowtime=(slowtime+(beat*time));
per_frame_7=ob_r=0.6;
per_frame_8=ob_g=(0.1*sin(time));
per_frame_9=ob_b=(cos(time)*sign(cos(time)));
per_frame_10=sumneg=((below(ob_r, 0)+below(ob_g, 0))+below(ob_b, 0));
per_frame_11=mv_r=cos(time);
per_frame_12=mv_b=(0.5*(sin(time)+abs(sin(time))));
per_frame_13=mv_g=((-0.8*sign(sin(time)))*abs(sin(time)));
per_frame_14=wave_r=(if(abs(above(ob_r, 1))>0.00001,1,(if(abs(above(ob_r, 0))>0.00001,ob_r,(1+ob_r)))));
per_frame_15=wave_g=(if(abs(above(ob_g, 1))>0.00001,1,(if(abs(above(ob_g, 0))>0.00001,ob_g,(1+ob_g)))));
per_frame_16=wave_b=(if(abs(above(ob_b, 1))>0.00001,1,(if(abs(above(ob_b, 0))>0.00001,ob_b,(1+ob_b)))));
per_frame_17=wave_r=(if(abs(above(sumneg, 1))>0.00001,1,wave_r));
per_frame_18=wave_r=(if(abs(equal(sumneg, 1))>0.00001,1,wave_r));
per_frame_19=wave_g=(if(abs(above(sumneg, 2))>0.00001,1,wave_g));
per_frame_20=dx=((0.3*sin(time))+0.1);
per_frame_21=dy=(0.3*cos((time+(0.3*cos(slowtime)))));
per_pixel_1=re=(1.75*tan((rad-0.7)));
per_pixel_2=rot=(if(abs(above(re, 0.5))>0.00001,(1*(ang+ang)),rot));
per_pixel_3=zoom=(if(abs(below(re, -0.4))>0.00001,(x*2),zoom));
per_pixel_4=birth=asin(((ang*0.3)*q2));
per_pixel_5=cx=(if(abs(above(birth, 0.5))>0.00001,(4*sin((q2+ang))),cx));
