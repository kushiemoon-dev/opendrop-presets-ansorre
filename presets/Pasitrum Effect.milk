MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
wave_b=0.5
wave_g=0.5
wave_r=0.5
bMotionVectorsOn=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=dx=(dx-0.001);
per_frame_2=dy=(dy-0.001);
per_frame_3=warp=0;
per_frame_4=wave_r=(wave_r+(0.3*sin(time)));
per_frame_5=wave_g=(wave_g+(0.3*sin((time*0.777))));
per_frame_6=wave_b=(wave_b+(0.3*cos((time*1.22))));
per_frame_7=ob_a=(bass_att*0.1);
per_frame_8=ob_size=(treb_att*0.05);
per_frame_9=ob_r=wave_r;
per_frame_10=ob_g=wave_g;
per_frame_11=ob_b=wave_b;
per_pixel_1=dx=((sqrt(pow(y, 3))*sin((((((ang*rad)*tan((ang+(1*time))))+tan((ang+(1*time))))+tan((rad-1)))+time)))*0.01);
per_pixel_2=dy=(-dx+(0.001*sin(time)));
per_pixel_3=zoom=(zoom+((dy+dx)*10));
per_pixel_4=rot=(0.01*sin((zoom+time)));
per_pixel_5=zoom=(zoom+(pow((rad*1.2), 100)*0.1));
