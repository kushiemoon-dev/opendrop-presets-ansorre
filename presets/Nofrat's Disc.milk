MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
fDecay=0.975
fModWaveAlphaEnd=1.95
fModWaveAlphaStart=0.85
fWaveScale=0.054279
ib_a=1.0
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.005
nWaveMode=6.0
ob_size=0.355
wave_b=0.4
wave_g=0.4
wave_r=0.4
fVideoEchoZoom=0.535239
nVideoEchoOrientation=1.0
fWaveAlpha=1.0
bMotionVectorsOn=0.0
nMotionVectorsY=7.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=treb_effect = 0;
per_frame_init_3=net_effect = 0;
per_frame_1=warp=0;
per_frame_2=dx=-0.0005;
per_frame_3=dy=-0.0005;
per_frame_4=wave_r=(wave_r+(0.35*((0.6*sin((0.784*time)))+(0.4*sin((0.986*time))))));
per_frame_5=wave_g=(wave_g+(0.35*((0.6*sin((0.671*time)))+(0.4*sin((1.164*time))))));
per_frame_6=wave_b=(wave_b+(0.35*((0.6*sin((1.423*time)))+(0.4*sin((0.687*time))))));
per_frame_7=bass_effect=(if(abs(above(bass_att, 1.4))>0.00001,pow(1.1, bass_att),1));
per_frame_8=treb_effect=(if(abs(above(treb_att, 1.4))>0.00001,pow(0.97, treb_att),1));
per_frame_9=net_effect=(if(abs(above(bass_att, (0.8*treb_att)))>0.00001,bass_effect,treb_effect));
per_frame_10=zoom=net_effect;
per_frame_11=ib_a=(bass_att*0.3);
per_frame_12=ib_r=wave_g;
per_frame_13=ib_g=wave_b;
per_frame_14=ib_b=wave_r;
per_frame_15=ob_size=(treb_att*0.3);
per_pixel_1=rot=(rot+(if(abs(equal(sin(ang), 0))>0.00001,-rot,0.05)));
