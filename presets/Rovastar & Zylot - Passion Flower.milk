MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bInvert=1.0
bSolarize=1.0
bWaveThick=1.0
fDecay=0.97
fWaveScale=2.063784
fWaveSmoothing=0.72
mv_a=0.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
