shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=wave_r=((-1)&(bass));
per_frame_3=wave_g=((-1)&(treb));
per_frame_4=wave_b=(if(abs(below(wave_r, 1))>0.00001,(if(abs(below(wave_g, 1))>0.00001,1,0)),0));
per_frame_5=dx=-0.0003;
per_frame_6=dy=0.0003;
per_pixel_1=zoom=(if(abs(above(rad, 0.13))>0.00001,((rad*0.1)+0.98),1.01));
per_pixel_2=cx=((((10)&(((x*15)-0.5)))*floor((1)/(15)))+0.05);
per_pixel_3=cy=((((10)&(((y*15)-0.5)))*floor((1)/(15)))+0.05);
per_pixel_4=rot=(0-(if(abs(above(rad, 0.3))>0.00001,((rad*0.1)+0.05),0)));
