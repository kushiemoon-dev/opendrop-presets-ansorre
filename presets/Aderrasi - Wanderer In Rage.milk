per_frame_init_1=wabe_b = 0;
per_frame_1=wave_x=(wave_x+floor((floor(int(rand(time))))/(55000)));
per_frame_2=wave_y=(wave_y+floor((floor(int(rand(time))))/(55000)));
per_frame_3=wave_r=(wave_r+(pow(bass, treb)*tan((1.1*time))));
per_frame_4=wave_b=(wave_b+(pow(treb, mid)*tan((1.3*time))));
per_frame_5=wave_g=(wave_g+(pow(mid, bass)*tan((1.5*time))));
per_frame_6=wave_g=(wave_g+(if(abs(above(wave_x, 0.6))>0.00001,-8,pow(mid, bass))));
per_frame_7=wave_b=(wabe_b+(if(abs(above(wave_x, 0.6))>0.00001,-8,pow(treb, mid))));
per_frame_8=wave_x=(wave_x+((0.2*cos((0.5*time)))*sin((0.2573*time))));
per_frame_9=wave_y=(wave_y+((0.2*cos((0.5*time)))*sin((0.7326*time))));
per_frame_10=rot=(rot-floor((sqrt(bass))/(20)));
per_frame_11=zoom=(zoom+floor(((log(floor((floor((bass)/(treb)))/(mid)))/2.302585092994046))/(10)));
per_frame_12=cy=(cy+(0.25*sin((0.01*bass))));
per_frame_13=cx=(cx+(0.25*sin((0.01*bass))));
per_frame_14=warp=(warp+sigmoid(bass, time));
per_frame_15=warp=(warp+(0.5*sin(time)));
per_frame_16=zoom=(zoom-(0.005*sin((0.01*time))));
per_frame_17=warp=(wrap+(0.1*tan((5*time))));
