per_frame_1=decay=0.975;
per_frame_2=vola=(bass_att*0.3);
per_frame_3=volb=(treb_att*0.3);
per_frame_4=h=((sin((time*0.8))*0.45)+0.45);
per_frame_5=s=min(volb, 1);
per_frame_6=l=min(vola, 1);
per_frame_7=monitor=l;
per_frame_8=cc=(((6*h))%(6));
per_frame_9=f=((6*h)-cc);
per_frame_10=m=l;
per_frame_11=p=(l*(1-s));
per_frame_12=q=(l*(1-(s*f)));
per_frame_13=t=(l*(1-(s*(1-f))));
per_frame_14=rr=(if(abs(equal(cc, 0))>0.00001,m,(if(abs(equal(cc, 1))>0.00001,q,(if(abs(equal(cc, 2))>0.00001,p,(if(abs(equal(cc, 3))>0.00001,p,(if(abs(equal(cc, 4))>0.00001,t,m))))))))));
per_frame_15=gg=(if(abs(equal(cc, 0))>0.00001,t,(if(abs(equal(cc, 1))>0.00001,m,(if(abs(equal(cc, 2))>0.00001,m,(if(abs(equal(cc, 3))>0.00001,q,(if(abs(equal(cc, 4))>0.00001,p,p))))))))));
per_frame_16=bb=(if(abs(equal(cc, 0))>0.00001,p,(if(abs(equal(cc, 1))>0.00001,p,(if(abs(equal(cc, 2))>0.00001,t,(if(abs(equal(cc, 3))>0.00001,m,(if(abs(equal(cc, 4))>0.00001,m,q))))))))));
per_frame_17=wave_r=rr;
per_frame_18=wave_g=gg;
per_frame_19=wave_b=bb;
