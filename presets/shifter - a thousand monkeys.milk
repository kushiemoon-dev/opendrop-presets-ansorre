per_frame_1=warp=0;
per_frame_2=tic=min((time-tin), 0.1);
per_frame_3=tin=time;
per_frame_4=ra=10;
per_frame_5=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_6=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_7=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_8=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_9=tt=(tt+(tic*treb_avg));
per_frame_10=mt=(mt+(tic*mid_avg));
per_frame_11=bt=(bt+(tic*bass_avg));
per_frame_12=vt=(vt+(tic*vav));
per_frame_13=sp=(abs((vav-slide))*0.1);
per_frame_14=slide=(if(abs(above(slide, vav))>0.00001,(slide-(tic*sp)),(slide+(tic*sp))));
per_frame_15=sw=above(tim, 0.1);
per_frame_16=tim=(if(abs(sw)>0.00001,(tim-0.1),tim));
per_frame_17=tim=(tim+(tic*vav));
per_frame_18=asw=1;
per_frame_19=q1=sw;
per_frame_20=rv=((floor(int(rand(1001)))*0.001)-(floor(int(rand(1001)))*0.001));
per_frame_21=rv=(treb_avg-mid_avg);
per_frame_22=rot=((rv*sw)*0.5);
per_frame_23=ra=((floor(int(rand(1001)))*0.001)+(floor(int(rand(1001)))*0.001));
per_frame_24=ra=(bass_avg*0.5);
per_frame_25=zoom=(1-((ra*0.3)*sw));
per_frame_26=sx=(1+((ra*0.05)*sw));
per_frame_27=sy=(1+((ra*0.05)*sw));
