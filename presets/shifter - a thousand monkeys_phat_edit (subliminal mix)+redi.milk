per_frame_15=avgvol=((avgvol*0.999)+(vol*0.01));
per_frame_16=mtime=((mtime+min((treb_att*0.01), 0.25))-(beatbhard*0.01));
per_frame_17=mtime2=((mtime2+min((avgdb*0.01), 0.25))+(beatbhard*0.01));
per_frame_18=zoom=(0.95+bass);
