per_frame_2=state=(if(abs(above(bass_att, 1.3))>0.00001,(2+bass),(if(abs(above(treb_att, 1.3))>0.00001,2,1))));
per_frame_3=wave_b=(if(abs(above(state, 2.7))>0.00001,(0.2+(0.2*sin(time))),(if(abs(equal(state, 3))>0.00001,(0.9+(0.1*sin(time))),(0.6+(0.08*sin(time)))))));
per_frame_4=wave_g=(if(abs(above(state, 2.9))>0.00001,0,(if(abs(equal(state, 3))>0.00001,0,0.29))));
per_frame_5=wave_r=(if(abs(above(state, 3))>0.00001,(0.75+(0.1*sin((time*0.55)))),0));
per_frame_6=zoom=(if(abs(above((bass_att+treb), 2))>0.00001,(1+floor((cos((state*1.3)))/(10))),(1-floor((sin((state*1.5)))/(10)))));
per_frame_7=q1=state;
per_frame_8=wave_mystery=(floor((time)/(3))+floor((bass)/(10)));
per_pixel_1=myval=(q1+floor((sin(floor((time)/(3))))/(10)));
per_pixel_2=zoom=(2+(if(abs(above(myval, 3))>0.00001,floor((sin(pow(-rad, 5)))/(10)),sin(-rad))));
