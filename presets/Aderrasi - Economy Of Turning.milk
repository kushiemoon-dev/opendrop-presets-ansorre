per_frame_init_1=vox = 0;
per_frame_1=vox=floor((((bass+treb)+mid))/(3));
per_frame_2=decay=(if(abs(below(vox, 1.25))>0.00001,1,0.95));
per_frame_3=wave_mystery=(wave_mystery+((1*sin((10*bass)))*0.3));
per_frame_4=wave_b=(-1+floor(int(rand(5))));
per_frame_5=wave_r=(-1+floor(int(rand(5))));
per_frame_6=wave_g=(-1+floor(int(rand(5))));
per_pixel_1=dy=(dy+(if(abs(above(rad, 0.5))>0.00001,(0.01*sin(bass)),(-0.01*cos(bass)))));
per_pixel_2=dx=(dx+(if(abs(above(rad, 0.5))>0.00001,(0.01*sin(bass)),(-0.01*cos(bass)))));
per_pixel_3=rot=(rot+min((floor((floor(((0.6*rad))/(bass)))/(treb))*0.9), ((2*bass)*0.08)));
