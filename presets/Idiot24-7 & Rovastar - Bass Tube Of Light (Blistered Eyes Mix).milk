per_frame_init_1=bass_effect = 0;
per_frame_1=wave_r=((bass*treb)*0.5);
per_frame_2=wave_g=((mid*treb)*0.5);
per_frame_3=wave_b=((mid*bass)*0.2);
per_pixel_1=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_pixel_2=zoom=(if(abs(above(ang, 0.05))>0.00001,(if(abs(above(ang, 0.15))>0.00001,(1+(ang*0.1)),(1+(ang*2)))),(1+(ang*0.1))));
per_pixel_3=zoom=(zoom+(0.1*bass_effect));
