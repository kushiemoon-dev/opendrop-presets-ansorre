MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.91
fGammaAdj=1.994
fWarpScale=1.331
fWaveScale=1.151736
fWaveSmoothing=0.1
nWaveMode=5.0
warp=0.012485
wave_b=0.65
wave_g=0.65
wave_r=0.65
bAdditiveWaves=1.0
bMotionVectorsOn=0.0
fWaveParam=-0.5
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=wave_r=((wave_r+(0.400*sin((time*0.555))))+(bass*0.100));
per_frame_2=wave_g=((wave_g+(0.400*sin((time*0.222))))+(treb*0.100));
per_frame_3=wave_b=((wave_b+(0.400*sin((time*0.777))))+rot);
per_pixel_1=rot=(0.400*(rot+(0.110*sin((rad*10)))));
per_pixel_2=zoom=(if(abs(above(rad, 0.500))>0.00001,zoom,(1+((bass+treb)*0.100))));
