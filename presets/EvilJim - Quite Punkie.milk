MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
fDecay=0.9
fGammaAdj=2.001001
fWaveScale=100.0
mv_a=0.0
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
fWaveAlpha=0.999743
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_1=wave_r=(bass*0.5);
per_frame_2=wave_g=(treb*1.23);
per_frame_3=wave_b=(mid*1.5);
per_frame_4=q1=floor((bass_att)/(bass));
per_frame_5=decay=(if(abs(above(q1, 3))>0.00001,1,0.9));
per_pixel_1=zoom=(if(abs(below(q1, 1))>0.00001,(1+(rad*0.2)),(1-(rad*0.2))));
