MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarkenCenter=1.0
nWaveMode=2.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
bMotionVectorsOn=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.001);
per_frame_3=dy=(dy-0.001);
per_frame_4=wave_r=((wave_r+(0.1*sin((time*0.333))))+(bass*0.3));
per_frame_5=wave_g=((wave_g+(0.1*sin((time*0.444))))+(treb*0.3));
per_frame_6=wave_b=((wave_b+(0.1*sin((time*0.222))))+(mid*0.3));
per_pixel_1=rot=(rot+atan((floor(((2*sin((rad*10))))/(2))*sin(time))));
per_pixel_2=zoom=(zoom+(bass*0.05));
per_pixel_3=zoom=(zoom-(treb*0.05));
per_pixel_4=zoom=(zoom-(rad-0.7));
