per_frame_init_9=vol_mean = 0;
per_frame_1=warp=0;
per_frame_2=slowtime=(slowtime+(beat*time));
per_frame_3=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_4=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_5=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
per_frame_6=ib_r=cos(slowtime);
per_frame_7=ib_g=sin(time);
per_frame_8=ib_b=(cos(slowtime)*sign(cos(slowtime)));
per_frame_9=redneg=(if(abs(below(ib_r, 0))>0.00001,1,0));
per_frame_10=greenneg=(if(abs(below(ib_g, 0))>0.00001,1,0));
per_frame_11=blueneg=(if(abs(below(ib_b, 0))>0.00001,1,0));
per_frame_12=wave_r=(if(abs(redneg)>0.00001,(if(abs(bor(greenneg, blueneg))>0.00001,1,(1+ib_r))),ib_r));
per_frame_13=wave_g=(if(abs(greenneg)>0.00001,(if(abs(equal((greenneg+blueneg), 2))>0.00001,1,(1+ib_g))),ib_g));
per_frame_14=wave_b=(if(abs(blueneg)>0.00001,(1+ib_b),ib_b));
per_frame_15=ib_size=(0.2*abs(sin(vol_mean)));
per_frame_16=q2=slowtime;
per_pixel_1=a=pow(1.02, pow(1, ((rad*2)-1)));
per_pixel_2=dx=((((x-0.5)*a)+0.5)-x);
per_pixel_3=dy=((((y-0.5)*a)+0.5)-y);
per_pixel_4=zoom=(zoom-(abs(sin(q2))*0.35));
per_pixel_5=rot=(rot+((sin(x)*sin(y))*0.5));
per_pixel_6=sy=((sy*a)+0.2);
per_pixel_7=sx=((sy+(0.1*x))+(0.2*rad));
