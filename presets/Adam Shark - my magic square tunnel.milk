per_frame_1=basstime=(basstime+(bass*0.03));
per_frame_2=q1=(basstime*4);
per_frame_3=basstime=(if(abs(below(basstime, 1000))>0.00001,1000,basstime));
per_frame_4=basstime=(basstime+(bass_att*0.03));
per_frame_5=vol=pow(((bass+mid)+treb), 2);
per_frame_6=basssum=vol;
per_frame_7=stickybit=((time)%(2));
per_frame_8=volavg=(volavg+(vol*equal(stickybit, 1)));
per_frame_9=sample1=(sample1+equal(stickybit, 1));
per_frame_10=volavg2=(volavg2+(vol*equal(stickybit, 0)));
per_frame_11=sample2=(sample2+equal(stickybit, 0));
per_frame_12=edge=bnot(equal(bit2, stickybit));
per_frame_13=volavg=(volavg-((volavg*edge)*stickybit));
per_frame_14=volavg2=(volavg2-((volavg2*edge)*equal(stickybit, 0)));
per_frame_15=sample1=(sample1-((sample1*edge)*stickybit));
per_frame_16=sample2=(sample2-((sample2*edge)*equal(stickybit, 0)));
per_frame_17=diff=(if(abs(equal(stickybit, 1))>0.00001,floor((basssum)/(floor((volavg2)/(sample2)))),0));
per_frame_18=diff=(if(abs(equal(stickybit, 0))>0.00001,floor((basssum)/(floor((volavg)/(sample1)))),diff));
per_frame_19=q3=diff;
per_frame_20=bit2=((time)%(2));
per_frame_21=difftime=(difftime+(diff*0.03));
per_frame_22=q2=difftime;
per_frame_23=difftime=(if(abs(above(difftime, 2000))>0.00001,0,difftime));
per_frame_24=monitor=(abs(cos(time))*3.14);
per_frame_25=mv_a=above(diff, 10);
per_pixel_1=zoom=(1+((0.05*q3)*rad));
per_pixel_2=decay_r=((((0.2*rad)*sin((q2*0.35)))+0.85)+(0.1*sin(q2)));
per_pixel_3=decay_g=((((0.2*rad)*sin((q2*0.5)))+0.85)+(0.1*sin((0.7*q2))));
per_pixel_4=decay_b=((((0.2*rad)*sin((q2*0.4)))+0.85)+(0.1*sin((0.8*q2))));
per_pixel_5=rot=0;
