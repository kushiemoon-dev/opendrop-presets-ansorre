per_frame_init_1=wave_beat = 0;
per_frame_init_2=wave_b1 = 0;
per_frame_init_3=gamma = 0;
per_frame_1=wave_b1=(wave_b1+(if(abs(above(bass_att, 0))>0.00001,bass_att,-bass_att)));
per_frame_2=wave_thick=1;
per_frame_3=wave_r=(wave_r+((sin((time+bass_att))*wave_b1)*0.1));
per_frame_4=wave_g=(wave_g+((cos((time+bass_att))*wave_b1)*0.1));
per_frame_5=wave_b=(wave_b+(((1-abs((wave_r+wave_g)))+wave_r)-((sin((time+bass_att))*wave_b1)*0.1)));
per_frame_6=decay=(decay-(0.01*equal(((frame)%(50)), 0)));
per_frame_7=ob_r=sin((wave_r+time));
per_frame_8=ob_g=cos((wave_g+time));
per_frame_9=ob_b=sin((wave_b-time));
per_frame_10=gamma=2;
per_pixel_1=zoom=(sin((zoom*1.4))-0.1);
per_pixel_2=zoom=(zoom*1.2);
per_pixel_3=wave_beat=(bass_att-mid_att);
per_pixel_4=dx=(sin((zoom-(x+wave_beat)))*0.1);
per_pixel_5=dy=(sin((zoom-(y+wave_beat)))*0.1);
