per_frame_1=zoom=1.01;
per_frame_2=warp=0.155;
per_frame_3=decay=0.95;
per_frame_4=tic=min((time-tin), 0.1);
per_frame_5=tin=time;
per_frame_6=ra=10;
per_frame_7=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_8=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_9=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_10=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_11=tt=(tt+(tic*treb_avg));
per_frame_12=mt=(mt+(tic*mid_avg));
per_frame_13=bt=(bt+(tic*bass_avg));
per_frame_14=vt=(vt+(tic*vav));
per_frame_15=sp=(abs((vav-slide))*0.1);
per_frame_16=slide=(if(abs(above(slide, vav))>0.00001,(slide-(tic*sp)),(slide+(tic*sp))));
per_frame_17=q1=(vt*0.9);
per_frame_18=q2=(tt*0.1);
per_frame_19=q3=(mt*0.1);
per_frame_20=q4=(bt*0.1);
per_frame_21=q5=slide;
