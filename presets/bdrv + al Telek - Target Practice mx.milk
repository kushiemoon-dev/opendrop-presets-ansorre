per_frame_10=wave_b=((sin((time*0.215))*0.5)+0.5);
per_frame_11=xx=((sin((xx*62.82))*0.5)+0.5);
per_frame_12=wave_r=(xx+((1-xx)*wave_r));
per_frame_13=wave_g=(xx+((1-xx)*wave_g));
per_frame_14=wave_b=(xx+((1-xx)*wave_b));
per_frame_15=monitor=xx;
