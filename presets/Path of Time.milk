bMotionVectorsOn=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=unknown = 0;
per_frame_1=dx=(dx-0.001);
per_frame_2=dy=(dy-0.001);
per_frame_3=warp=0;
per_frame_4=wave_r=(wave_r+(0.35*sin(time)));
per_frame_5=wave_b=(wave_b+(0.35*sin((time*2))));
per_frame_6=wave_g=(wave_g+(0.35*sin((time*3))));
per_frame_7=wave_mystery=(0.5*time);
per_frame_8=ib_a=(ib_a-(mid_att*0.5));
per_frame_9=ib_r=wave_b;
per_frame_10=ib_g=wave_r;
per_frame_11=ib_b=wave_g;
per_pixel_1=unknown=(rad+((x+y)*(ang*0.01)));
per_pixel_2=zoom=(zoom+(0.1*sin(((unknown*time)*10))));
per_pixel_3=zoom=(zoom+(0.1*atan(floor((unknown)/(time)))));
per_pixel_4=zoom=(zoom+(pow(rad, 2)*0.1));
