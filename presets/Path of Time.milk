PSVERSION_COMP=2
[preset00]
fWaveScale=1.028415
fWaveSmoothing=0.72
ib_a=1.0
ib_b=0.5
ib_g=0.5
ib_r=0.5
nWaveMode=6.0
ob_size=0.5
wave_b=0.5
wave_g=0.5
wave_r=0.5
