MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bDarken=1.0
dx=-0.012
fDecay=0.999
fGammaAdj=1.0
fModWaveAlphaEnd=2.0
fModWaveAlphaStart=2.0
fWaveScale=0.10049
fWaveSmoothing=0.9
warp=0.01
wave_b=0.0
wave_r=0.0
wave_x=0.9
fVideoEchoZoom=0.999609
fWaveAlpha=100.0
nMotionVectorsX=64.0
nMotionVectorsY=3.984009
fWaveParam=-0.484
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=meanbass_att = 0;
per_frame_init_2=rozzorrate = 0;
per_frame_init_3=lastbeat = 0;
per_frame_init_4=beatrate = 0;
per_frame_init_5=peakbass_att = 0;
per_frame_init_6=initframe = 0;
per_frame_init_7=volume = 0;
per_frame_init_8=beat = 0;
per_frame_init_9=beatcount = 0;
per_frame_init_10=basseffect = 0;
per_frame_1=volume=(0.3*((bass+mid)+bass_att));
per_frame_2=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_3=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_4=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_5=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_6=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_7=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_8=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_9=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_10=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_11=warp=0;
per_frame_12=dx=(dx-0.0005);
per_frame_13=dy=(dy-0.0005);
per_frame_14=basseffect=max((max(bass, bass_att)-1), 0);
per_frame_15=mv_y=(4-min((((bass_att+bass)-2)*0.25), 0.9));
per_frame_16=mv_r=(basseffect*4);
per_frame_17=mv_b=(basseffect*3);
per_frame_18=mv_g=(basseffect*3.5);
per_frame_19=wave_y=(if(abs(beat)>0.00001,0.5,0.4));
per_frame_20=beatcount=(beatcount+beat);
per_frame_21=initframe=(if(abs(below(beatcount, 1))>0.00001,frame,initframe));
per_frame_22=rozzorrate=floor(((frame-initframe))/(beatcount));
per_frame_23=monitor=rozzorrate;
