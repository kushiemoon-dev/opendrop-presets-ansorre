MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.99
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.26
mv_a=0.0
nWaveMode=7.0
ob_a=0.052
ob_b=1.0
ob_r=0.01
ob_size=0.03
rot=1.0
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
wave_y=0.0999
zoom=1.019603
bAdditiveWaves=1.0
fVideoEchoZoom=1.006596
nVideoEchoOrientation=3.0
fWaveAlpha=4.099998
fZoomExponent=0.0457
nMotionVectorsX=64.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=new_mid = 0;
per_frame_init_2=treb_effect = 0;
per_frame_init_3=q1 = 0;
per_frame_init_4=vol_att = 0;
per_frame_init_5=bass_effect = 0;
per_frame_init_6=new_treb = 0;
per_frame_init_7=q4 = 0;
per_frame_init_8=vol_effect = 0;
per_frame_init_9=vol = 0;
per_frame_init_10=new_bass = 0;
per_frame_init_11=q2 = 0;
per_frame_init_12=new_vol = 0;
per_frame_init_13=q3 = 0;
per_frame_init_14=mid_effect = 0;
per_frame_1=treb_effect=above(treb, treb_att);
per_frame_2=bass_effect=above(bass, bass_att);
per_frame_3=mid_effect=above(mid, mid_att);
per_frame_4=vol_effect=((bass_effect+treb_effect)+mid_effect);
per_frame_5=vol=((bass+treb)+mid);
per_frame_6=vol_att=((bass_att+treb_att)+mid_att);
per_frame_7=new_bass=(if(abs(above(bass, bass_effect))>0.00001,(bass+bass_att),bass_effect));
per_frame_8=new_treb=(if(abs(above(treb, treb_effect))>0.00001,(treb+treb_att),treb_effect));
per_frame_9=new_mid=(if(abs(above(mid, mid_effect))>0.00001,(mid+mid_att),mid_effect));
per_frame_10=new_vol=((new_bass+new_treb)+new_mid);
per_frame_11=q1=new_bass;
per_frame_12=q2=new_treb;
per_frame_13=q3=new_mid;
per_frame_14=q4=new_vol;
per_frame_15=zoom=(if(abs(above(new_bass, treb))>0.00001,zoom,1));
per_frame_16=wave_r=(wave_r+(0.2*sin((time*0.20))));
per_frame_17=wave_g=(wave_g+(0.5*sin(time)));
per_frame_18=wave_b=(wave_b+(0.1*sin(bass)));
per_frame_19=ob_r=(ob_r+(0.2*cos((time*0.20))));
per_frame_20=ob_g=(ob_g+(0.5*cos(time)));
per_frame_21=ob_b=(ob_b*sin(bass));
per_pixel_1=rot=(if(abs(above(q3, q2))>0.00001,(rot*sin((rad+time))),(-rot*sin((rad+time)))));
