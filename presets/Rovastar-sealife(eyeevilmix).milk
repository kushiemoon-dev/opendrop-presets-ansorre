per_frame_10=volume=(0.15*(((bass_att+bass)+mid)+mid_att));
per_frame_11=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_12=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_13=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_14=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_15=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_16=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_17=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_18=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_19=beatcounter=(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter));
per_frame_20=beatcounter=(if(abs(above(beatcounter, 7))>0.00001,0,beatcounter));
per_frame_21=beateven=((beatcounter)%(2));
per_frame_22=ob_a=beat;
per_pixel_1=cx=(if(abs(above(rad, 0.3))>0.00001,0.5,0.3));
per_pixel_2=rot=(if(abs(above(rad, 0.3))>0.00001,((bass_att+bass)*0.03),(0.6*(1-rad))));
