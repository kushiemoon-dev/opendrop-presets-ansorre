per_frame_init_1=onetwo = 0;
per_frame_1=wave_g=((wave_g+(0.25*cos(bass)))+(0.25*sin(treb)));
per_frame_2=wave_b=((wave_b-(0.25*sin(bass)))+(0.25*cos(mid)));
per_frame_3=wave_r=((wave_r+(0.25*sin(mid)))+(0.25*cos(treb)));
per_frame_4=onetwo=(1*sin(time));
per_frame_5=rot=(rot+(if(abs(below(onetwo, 0))>0.00001,(0.05*sin((0.5*bass))),(-0.025*sin((0.5*bass))))));
per_frame_6=cx=(cx+(0.25*sin(treb)));
per_frame_7=cy=(cy+(0.25*cos(mid)));
per_pixel_1=warp=(warp+(if(abs(below(rad, 0.5))>0.00001,(if(abs(above(rad, 0.2))>0.00001,(3-(5*bass)),0)),1)));
per_pixel_2=zoom=(zoom+(if(abs(above(rad, (rad*sin((bass*sin(time))))))>0.00001,0.02,-0.02)));
