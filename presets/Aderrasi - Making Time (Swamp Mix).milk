per_frame_1=bass_tick=((above(bass_att, bass_tick)*2)+((1-above(bass_att, bass_tick))*(((bass_tick-1.3)*0.96)+1.3)));
per_frame_2=treb_tick=((above(treb_att, treb_tick)*2)+((1-above(treb_att, treb_tick))*(((treb_tick-1.3)*0.96)+1.3)));
