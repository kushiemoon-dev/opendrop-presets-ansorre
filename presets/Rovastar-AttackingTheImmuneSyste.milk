per_frame_1=warp=0;
per_frame_2=dcounter=(if(abs(equal(dcounter, 0))>0.00001,(if(abs(above(bass, 1.5))>0.00001,bass,dcounter)),(if(abs(below(dcounter, 0))>0.00001,0,(if(abs(above(bass_att, 1.35))>0.00001,(dcounter+0.14),(dcounter-0.14)))))));
per_frame_3=tcounter=(if(abs(equal(dcounter, 0))>0.00001,(if(abs(above(treb, 1.5))>0.00001,(treb*0.5),tcounter)),(if(abs(below(tcounter, 0))>0.00001,0,(if(abs(above(treb_att, 1.35))>0.00001,(tcounter+0.2),(tcounter-0.2)))))));
per_frame_4=q1=min(dcounter, 2);
per_frame_5=q2=min(tcounter, 1.7);
per_frame_6=frametest=((frame)%(2));
per_frame_7=wave_r=((0.2+(0.2*sin(time)))+((0.4*bass)*frametest));
per_frame_8=wave_g=((0.2+(0.2*sin((time*0.222))))+((0.4*treb)*frametest));
per_frame_9=wave_b=((0.2+(0.2*sin((time*0.555))))+((0.4*mid)*frametest));
per_frame_10=q3=min(max(q2, 2), 0.5);
