per_frame_24=mv_dy=(0.02*sin((time*0.314)));
per_pixel_1=q4=(if(abs(above(x, ((q1-q2)+0.25)))>0.00001,-1,1));
per_pixel_2=q5=(12+floor((3*((sqrt(2)*0.5)-rad))));
per_pixel_3=cx=((((0)&(((x*q5)-0.5)))*floor((1)/(q5)))+0.05);
per_pixel_4=cy=((((0)&(((y*q5)-0.5)))*floor((1)/(q5)))+0.05);
per_pixel_5=rot=((0.4*((-rad+0.5)+(0.2*q4)))-(0.1*(y-1)));
