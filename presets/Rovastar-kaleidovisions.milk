PSVERSION_COMP=2
[preset00]
bDarkenCenter=1.0
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.5
mv_a=0.06
mv_b=0.5
mv_g=0.59
mv_l=2.0
mv_r=0.6
nWaveMode=7.0
ob_r=0.01
ob_size=0.05
rot=0.002
warp=0.01
wave_b=0.65
wave_g=0.65
wave_r=0.65
wave_y=0.12
bAdditiveWaves=1.0
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.006596
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
nMotionVectorsX=6.399999
nMotionVectorsY=18.599998
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=beateven = 0;
per_frame_init_2=meanbass_att = 0;
per_frame_init_3=lastbeat = 0;
per_frame_init_4=beatrate = 0;
per_frame_init_5=peakbass_att = 0;
per_frame_init_6=bass_effect = 0;
per_frame_init_7=beatcounter = 0;
per_frame_init_8=volume = 0;
per_frame_init_9=beat = 0;
per_frame_init_10=decay=1.1;
per_frame_init_11=beatcounter=0;
per_frame_1=warp=0;
per_frame_2=wave_g=(0.5+(0.3*sin((time*0.325))));
per_frame_3=wave_b=(0.5+(0.38*sin((time*0.984))));
per_frame_4=mv_x=64;
per_frame_5=mv_y=48;
per_frame_6=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_7=volume=(0.3*(bass+mid));
per_frame_8=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_9=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_10=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_11=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_12=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_13=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_14=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_15=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_16=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_17=beatcounter=(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter));
per_frame_18=beatcounter=(if(abs(above(beatcounter, 8))>0.00001,0,beatcounter));
per_frame_19=beateven=((beatcounter)%(2));
per_frame_20=rot=(0.003+(if(abs(beat)>0.00001,(0.8+bass_effect),0)));
per_frame_21=zoom=(1.16+(if(abs(beat)>0.00001,bass_effect,0)));
per_frame_22=wave_r=(if(abs(beateven)>0.00001,1,0));
per_frame_23=wave_mystery=floor((time)/(8));
per_pixel_1=sy=(1.0+(0.05*(1-rad)));
per_pixel_2=sx=(1.0+(0.05*(1-rad)));
