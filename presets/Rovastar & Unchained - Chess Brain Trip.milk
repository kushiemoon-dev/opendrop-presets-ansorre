per_frame_3=wave_b=(if(abs(equal(state, 2))>0.00001,(0.2+(0.2*sin(time))),(if(abs(equal(state, 3))>0.00001,(0.9+(0.1*sin(time))),(0.6+(0.08*sin(time)))))));
