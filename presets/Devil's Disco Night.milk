per_frame_init_1=gamma = 0;
per_frame_init_2=q1 = 0;
per_frame_1=gamma=(0.5+bass_att);
per_frame_2=q1=(q1+treb_att);
per_frame_3=wave_r=(wave_r+sin((time+gamma)));
per_frame_4=wave_g=(wave_g+cos((time-gamma)));
per_frame_5=wave_b=(1-(wave_r+wave_g));
per_pixel_1=zoom=(zoom+0.1);
per_pixel_2=rot=((rot+(sin((zoom-bass_att))*2))*0.1);
per_pixel_3=rot=(rot+(sin(((rot-(ang*5))+(rad*5)))*0.3));
per_pixel_4=rot=sqr(rot);
