per_pixel_1=zoom=(zoom+(if(abs(above(rad, 0.1))>0.00001,(if(abs(below(x, 0.42))>0.00001,(if(abs(below(y, 0.4))>0.00001,-0.05,0)),0)),0)));
per_pixel_2=zoom=(zoom+(if(abs(above(rad, 0.1))>0.00001,(if(abs(above(x, 0.58))>0.00001,(if(abs(below(y, 0.4))>0.00001,-0.05,0)),0)),0)));
