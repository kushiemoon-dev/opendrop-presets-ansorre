MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
bWaveThick=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.01
fWaveSmoothing=0.9
ib_a=1.0
ib_b=1.0
ib_g=1.0
ib_r=1.0
mv_a=0.0
mv_l=1.0
ob_a=1.0
ob_size=0.5
warp=0.01
bAdditiveWaves=1.0
fVideoEchoZoom=1.0
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
fZoomExponent=100.0
nMotionVectorsX=0.0
nMotionVectorsY=0.0
fWaveParam=-0.3
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=tac = 0;
per_frame_1=ob_size=(ob_size-(0.2*tan((6*bass))));
per_frame_2=wave_mystery=(wave_mystery+(0.2*tan((6*bass))));
per_frame_3=ib_r=(if(abs(above(bass, 1.25))>0.00001,0,1));
per_frame_4=ib_g=(if(abs(above(bass, 1.25))>0.00001,0,1));
per_frame_5=ib_b=1;
per_frame_6=sy=(sy+(0.01*tan(bass)));
per_frame_7=sx=(sx+(0.01*tan(bass)));
per_pixel_1=dy=(dy+(if(abs(above(y, 0.5))>0.00001,(if(abs(above(bass, 1))>0.00001,(if(abs(above(tac, 1))>0.00001,(0.02*bass),0)),0)),0)));
per_pixel_2=dy=(dy+(if(abs(below(y, 0.5))>0.00001,(if(abs(above(bass, 1))>0.00001,(if(abs(above(tac, 1))>0.00001,(-0.02*bass),0)),0)),0)));
per_pixel_3=tac=(2*sin((bass*time)));
per_pixel_4=zoom=(zoom-floor((tac)/(100)));
per_pixel_5=zoom=(zoom-(floor(((0.05*atan(abs(bass))))/(rad))*0.15));
