per_frame_3=tic=min((time-tin), 0.1);
per_frame_4=tin=time;
per_frame_5=ra=10;
per_frame_6=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_7=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_8=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_9=vav=(tic*((vav*(floor((1)/(tic))-ra))+((ra*((bass+treb)+mid))*0.33333)));
per_frame_10=tt=(tt+(tic*treb_avg));
per_frame_11=mt=(mt+(tic*mid_avg));
per_frame_12=bt=(bt+(tic*bass_avg));
per_frame_13=vt=(vt+(tic*vav));
per_frame_14=sp=(abs((vav-slide))*0.1);
per_frame_15=slide=(if(abs(above(slide, vav))>0.00001,(slide-(tic*sp)),((slide+(tic*sp))+((equal(toc, 0)*vav)*0.75))));
per_frame_16=toc=1;
per_frame_17=q1=(vt*0.9);
per_frame_18=q2=(tt*0.1);
per_frame_19=q3=(mt*0.1);
