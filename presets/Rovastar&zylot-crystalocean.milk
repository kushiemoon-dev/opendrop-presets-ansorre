per_frame_init_1=bass_effect = 0;
per_frame_1=bass_effect=max(0, (max(bass_att, bass)-1));
per_frame_2=zoom=((zoom+0.05)+(0.05*sin((time*0.222))));
per_frame_3=wave_r=(wave_r+(0.175*sin((time*0.111))));
per_frame_4=wave_r=(if(abs(above(bass_effect, 0))>0.00001,0.2,wave_r));
per_frame_5=wave_g=(wave_g+(0.175*sin((time*0.222))));
per_frame_6=wave_g=(if(abs(above(bass_effect, 0))>0.00001,0.2,wave_g));
per_frame_7=wave_b=(wave_b+(0.1*sin((time*0.333))));
per_frame_8=wave_y=(wave_y+floor((sin((time*0.3)))/(20)));
per_frame_9=wave_y=(if(abs(above(bass_effect, 0))>0.00001,0.3,wave_y));
per_pixel_1=zoom=(zoom+(0.05*sin(((ang*rad)+(0.1*sin(time))))));
per_pixel_2=rot=(rot+(0.1*sin(((floor((sqrt(2))/(2))-rad)+(0.1*sin((time*2.1)))))));
per_pixel_3=dx=(0.1*sin(floor((zoom)/(rot))));
per_pixel_4=sy=(1+floor((sin(y))/(20)));
