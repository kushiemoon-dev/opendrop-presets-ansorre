per_frame_init_1=q1 = 0;
per_frame_init_2=madbass = 0;
per_frame_init_3=bass_effect = 0;
per_frame_1=wave_mystery=(-0.4+(0.1*sin(treb)));
per_frame_2=wave_x=(0.3+(0.2*mid));
per_frame_3=wave_y=(0.3+(0.2*bass));
per_frame_4=wave_r=bass;
per_frame_5=wave_g=mid;
per_frame_6=wave_b=treb;
per_frame_7=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_8=zoom=((zoom-(1.4*madbass))+0.02);
per_frame_9=ib_a=(if(abs(above(bass, 1.2))>0.00001,0.7,0));
per_frame_10=ob_r=(if(abs(above(treb, 1.2))>0.00001,0.3,0.1));
per_frame_11=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_12=q1=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_pixel_1=rot=(if(abs(below(rad, q1))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_2=zoom=(if(abs(below(rad, q1))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
