MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bModWaveAlphaByVolume=1.0
bWaveDots=1.0
bWaveThick=1.0
fWaveScale=1.817
mv_a=0.0
nWaveMode=2.0
ob_a=0.1
ob_size=0.0
rot=0.02
zoom=0.9901
fVideoEchoAlpha=0.4
fVideoEchoZoom=1.648
fZoomExponent=1.00815
fWaveParam=1.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=0.0
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=cross = 0;
per_frame_init_2=rect = 0;
per_frame_init_3=ring = 0;
per_frame_init_4=box = 0;
per_frame_init_5=q1 = 0;
per_frame_init_6=q2 = 0;
per_frame_init_7=q3 = 0;
per_frame_init_8=q1=(int(rand(2))-1);
per_frame_init_9=q2=(int(rand(2))-1);
per_frame_init_10=q3=(int(rand(2))-1);
per_frame_1=warp=0;
per_frame_2=wave_r=(0.5+(0.5*sin((0.66*time))));
per_frame_3=wave_g=(0.5+(0.5*sin((0.33*time))));
per_frame_4=wave_b=((0.5*0.5)*sin(time));
per_pixel_1=cross=((above(x, 0.45)*below(x, 0.55))+(above(y, 0.45)*below(y, 0.55)));
per_pixel_2=rect=(((above(x, 0.3)*below(x, 0.7))*below(y, 0.7))*above(y, 0.3));
per_pixel_3=ring=(above(0.3, rad)*below(0.15, rad));
per_pixel_4=box=(((-cross*q1)-(rect*q2))+(ring*q3));
per_pixel_5=sx=(1+(0.025*box));
per_pixel_6=sy=(1+(0.025*box));
