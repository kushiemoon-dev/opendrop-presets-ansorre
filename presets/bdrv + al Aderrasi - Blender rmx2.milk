per_frame_1=wave_x=(wave_x+(0.15*sin(time)));
per_frame_2=wave_y=(wave_y+(0.15*cos(time)));
per_frame_3=wave_r=(wave_r+0.9);
per_frame_4=wave_g=(0.9-(0.5*bass));
per_frame_5=wave_b=(0.9-(0.5*bass));
per_pixel_1=rot=(0.3*tan(((0.1*sin(((pow(rad, 4)*20)+time)))+(sin((time*0.222))*0.1))));
per_pixel_2=zoom=(zoom+(0.1*sin(((ang*q2)+time))));
per_pixel_3=cen_x=q1;
per_pixel_4=cen_y=q2;
per_pixel_5=radxy=((sin((time*0.1))*0.2)+0.3);
per_pixel_6=dist_x=floor(((x-cen_x))/((radxy*(((sin(((time*0.2)*0))*0.3)+(cos(((((cen_x-x)+(cen_y-y))*10)+(time*2)))*0.3))+1))));
per_pixel_7=dist_y=floor(((y-cen_y))/((radxy*(((sin(((time*0.2)*0))*0.3)+(sin(((((cen_x-x)+(cen_y-y))*10)+(time*2)))*0.3))+1))));
per_pixel_8=in=(below(abs(dist_x), 1)*below(abs(dist_y), 1));
per_pixel_9=out=bnot(in);
per_pixel_10=inx=((cen_x-q1)+((0.1*sign(dist_x))*(1-abs(dist_x))));
per_pixel_11=iny=((cen_y-q2)+((0.1*sign(dist_y))*(1-abs(dist_y))));
per_pixel_12=vang=(time*0.1);
per_pixel_13=vx=((((x-0.5)*cos(vang))-((y-0.5)*sin(vang)))+0.5);
per_pixel_14=vy=((((x-0.5)*sin(vang))+((y-0.5)*cos(vang)))+0.5);
per_pixel_15=dvx=(0.01*sin((time+((vy*80)*radxy))));
per_pixel_16=dvy=(0.01*cos((time+((vx*80)*radxy))));
per_pixel_17=outx=((dvx*cos(vang))-(dvy*sin(vang)));
per_pixel_18=outy=((-dvx*sin(vang))-(dvy*cos(vang)));
per_pixel_19=dx=((in*inx)+(out*outx));
per_pixel_20=dy=((in*iny)+(out*outy));
