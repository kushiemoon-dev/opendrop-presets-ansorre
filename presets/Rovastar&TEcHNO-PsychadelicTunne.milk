per_frame_init_1=bass_effect = 0;
per_frame_1=cx=(cx+((sin((0.874*time))*(if(abs(above(sin(time), 0))>0.00001,(-1+bass),1.3)))*0.05));
per_frame_2=cy=(cy+((cos((1.123*time))*(if(abs(below(sin(time), 0))>0.00001,(-1+bass),1.3)))*0.05));
per_frame_3=wave_r=(1-bass);
per_frame_4=wave_g=(wave_g+(sin((time*0.74))*0.3));
per_frame_5=wave_b=(wave_b+(sin((time*0.83))*0.2));
per_frame_6=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_7=rot=((sin(time)*0.01)+(0.01*cos((time*0.674))));
