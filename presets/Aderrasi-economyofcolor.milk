MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveDots=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.53524
fWaveSmoothing=0.5
ib_size=0.0
mv_a=0.0
mv_l=1.0
nWaveMode=2.0
ob_a=0.02
ob_b=1.0
ob_size=0.005
warp=0.01
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.0
nVideoEchoOrientation=1.0
fWaveAlpha=100.0
nMotionVectorsX=0.0
nMotionVectorsY=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=vox = 0;
per_frame_1=vox=floor((((bass+treb)+mid))/(3));
per_frame_2=decay=(if(abs(below(vox, 1.25))>0.00001,1,0.95));
per_frame_3=wave_mystery=(wave_mystery+((1*sin((10*bass)))*0.3));
per_frame_4=wave_b=(-1+int(rand(5)));
per_frame_5=wave_r=(-1+int(rand(5)));
per_frame_6=wave_g=(-1+int(rand(5)));
per_frame_7=rot=(rot+0.1);
per_frame_8=zoom=(zoom+0.01);
per_frame_9=dx=(dx+(if(abs(above(sin(time), 0))>0.00001,(0.05*sin(time)),0)));
per_pixel_1=dy=(dy+(if(abs(equal(rad, (0.5+(0.5*sin(time)))))>0.00001,(0.01*sin(bass)),(-0.01*sin(bass)))));
per_pixel_2=dx=(dx+(if(abs(equal(rad, (0.5+(0.5*cos(time)))))>0.00001,(0.01*sin(bass)),(-0.01*sin(bass)))));
