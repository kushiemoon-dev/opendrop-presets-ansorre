MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fWaveScale=1.1843
nWaveMode=4.0
wave_b=0.5
wave_g=0.5
wave_r=0.5
bMotionVectorsOn=0.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=dx=(dx-0.001);
per_frame_3=dy=(dy-0.001);
per_frame_4=wave_mystery=(0.3*sin(time));
per_frame_5=wave_r=(wave_r+(0.25*sin((time*0.666))));
per_frame_6=wave_g=(wave_g-wave_mystery);
per_pixel_1=rot=(rot+(0.1*sin(((x*50)+(time*5)))));
per_pixel_2=zoom=(zoom+pow(abs(rot), 0.8));
per_pixel_3=dx=zoom;
