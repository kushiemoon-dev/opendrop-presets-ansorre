per_frame_init_14=c = 0;
per_frame_1=pi3=floor(((3.1415*2))/(3));
per_frame_2=c=0.2;
per_frame_3=n=(pow(bass, 5)*0.01);
per_frame_4=ib_r=(0.5+(sin(((n+(c*time))+pi3))*0.5));
per_frame_5=ib_g=(0.5+(sin(((n+(c*time))-pi3))*0.5));
per_frame_6=ib_b=(0.5+(sin((n+(c*time)))*0.5));
per_frame_7=ob_size=(if(abs(above(n, 0.5))>0.00001,0,0.5));
per_frame_8=wave_r=(1-ib_r);
per_frame_9=wave_g=(1-ib_g);
per_frame_10=wave_b=(1-ib_b);
per_pixel_1=vx=(0.5+(cos((time*0.2))*1));
per_pixel_2=vy=(0.5+(sin((time*0.2))*1));
per_pixel_3=vz=0;
per_pixel_4=z=(0-vz);
per_pixel_5=x=(x-vx);
per_pixel_6=y=(y-vy);
per_pixel_7=d=((time*0.3)-(((treb*treb)*treb)*0.001));
per_pixel_8=xx=((sin(d)*x)+(cos(d)*y));
per_pixel_9=yy=((cos(d)*x)-(sin(d)*y));
per_pixel_10=x=xx;
per_pixel_11=y=yy;
per_pixel_12=x=(x+mx);
per_pixel_13=y=(y+my);
per_pixel_14=z=(z+vz);
per_pixel_15=cx=0;
per_pixel_16=cy=0;
per_pixel_17=cz=(0.5+(treb*0.0));
per_pixel_18=vx=0;
per_pixel_19=vy=0;
per_pixel_20=vz=0;
per_pixel_21=zoom=(0.4-(((bass*bass)*bass)*0.001));
per_pixel_22=w=(floor((1)/(zoom))*(1+sqrt(((sqr((z-cz))+sqr((x-cx)))+sqr((y-cy))))));
per_pixel_23=dx=(-(x-mx)*w);
per_pixel_24=dy=(-(y-my)*w);
