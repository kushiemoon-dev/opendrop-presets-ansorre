per_frame_9=rot=(rot+(0.020*((0.60*sin((0.381*time)))+(0.40*sin((0.579*time))))));
per_frame_10=decay=(decay-(0.01*below(((frame)%(5)), 1)));
per_frame_11=ok_to_change=(if(abs(above(time, (beat_time+6)))>0.00001,1,0));
per_frame_12=bass_effect=(max(bass, bass_att)-1);
per_frame_13=beat_time=(if(abs(above(bass_effect, 0.5))>0.00001,(if(abs(ok_to_change)>0.00001,time,beat_time)),beat_time));
per_frame_14=effect=(if(abs(equal(time, beat_time))>0.00001,((effect+floor(int(rand(5))))+1),effect));
per_frame_15=effect=(if(abs(above(effect, 5))>0.00001,(effect-6),effect));
per_frame_16=q1=(effect+2);
per_frame_17=monitor=q1;
per_pixel_1=zoom=(zoom+(0.04*sin(((ang*floor(q1))+(time*2.6)))));
