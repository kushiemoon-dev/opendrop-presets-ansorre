per_frame_1=warp=0;
per_frame_2=bass_effect=min(max((max(bass, bass_att)-1.3), 0), 1);
per_frame_3=treb_effect=min(max((max(treb, treb_att)-1.3), 0), 1);
per_frame_4=mid_effect=min(max((max(mid, mid_att)-1.3), 0), 1);
per_frame_5=wave_r=(wave_r+(0.45*((0.6*sin((1.517*time)))+(0.4*mid_effect))));
per_frame_6=wave_b=(wave_b+(0.45*((0.6*sin((1.088*time)))+(0.4*bass_effect))));
per_frame_7=wave_g=(wave_g+(0.45*((0.6*sin((1.037*time)))+(0.4*treb_effect))));
