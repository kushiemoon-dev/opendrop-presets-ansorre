per_pixel_6=cx=(0.5+q4);
per_pixel_7=cy=(0.5-q5);
per_pixel_8=zoom=((0.99*zooma)+(0.99*(1-zooma)));
per_pixel_9=rot=((0.3*zooma)*rd);
