per_frame_13=zoom=(if(abs(equal(bass_thresh, 2))>0.00001,(zoom+0.2),zoom));
per_frame_14=monitor=bass_thresh;
per_pixel_1=rot=(if(abs(above(rad, 0.1))>0.00001,-0.9,1));
per_pixel_2=rot=(if(abs(above(rad, 0.2))>0.00001,0.8,rot));
