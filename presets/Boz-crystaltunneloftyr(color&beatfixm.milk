per_frame_init_1=bass_thresh = 0;
per_frame_1=wave_r=(0.6+(0.3*sin(floor((time)/(3)))));
per_frame_2=wave_b=(0.5+(0.4*sin(floor((time)/(3.2)))));
per_frame_3=wave_g=(0.4+(0.4*sin(floor((time)/(3.5)))));
per_frame_4=mv_a=0;
per_frame_5=wave_mystery=(-0.31+(0.01*sin((time*bass))));
per_frame_6=wave_a=bass_att;
per_frame_7=cx=((0.5+(0.02*sin(time)))+(0.01*sin(floor((time)/(2)))));
per_frame_8=cy=((0.5+(0.02*sin(time)))+(0.01*sin(floor((time)/(1.5)))));
per_frame_9=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.4)*0.85)+1.4)));
per_frame_10=wave_r=(if(abs(equal(bass_thresh, 2))>0.00001,(wave_r+0.3),wave_r));
per_frame_11=wave_g=(if(abs(equal(bass_thresh, 2))>0.00001,(wave_g+0.3),wave_g));
