per_pixel_7=box_effect=(if(abs(above(y, y_pos))>0.00001,(if(abs(below(y, (y_pos+height)))>0.00001,(if(abs(above(x, x_pos))>0.00001,(if(abs(below(x, (x_pos+width)))>0.00001,effect1,effect2)),effect2)),effect2)),effect2));
