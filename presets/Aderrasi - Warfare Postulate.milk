shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=progress = 0;
per_frame_1=wave_x=(wave_x+(if(abs(above(bass, 1))>0.00001,0.6,0)));
per_frame_2=wave_y=(wave_y+(if(abs(above(bass, 1))>0.00001,-0.6,0)));
per_frame_3=wave_x=(wave_x+(if(abs(above(treb, 1))>0.00001,(if(abs(below(bass, 1))>0.00001,0.3,0)),0)));
per_frame_4=wave_y=(wave_y+(if(abs(above(treb, 1))>0.00001,(if(abs(below(bass, 1))>0.00001,-0.3,0)),0)));
per_frame_5=wave_r=(-1+int(rand(3)));
per_frame_6=wave_b=(-1+int(rand(3)));
per_frame_7=wave_g=(-1+int(rand(3)));
per_pixel_1=dx=(dx+(if(abs(below(y, 0.45))>0.00001,(if(abs(below(x, 0.7))>0.00001,(0.005+(0.02*sin((8*bass)))),(0.005+(0.005*sin((8*bass)))))),0)));
per_pixel_2=dx=(dx+(if(abs(above(y, 0.55))>0.00001,(if(abs(above(x, 0.3))>0.00001,(-0.005-(0.02*sin((8*mid)))),(-0.005-(0.005*sin((8*mid)))))),0)));
per_pixel_3=dx=(dx+(if(abs(below(y, 0.6))>0.00001,(if(abs(above(y, 0.5))>0.00001,(0.02*cos((8*treb))),0)),0)));
per_pixel_4=dx=(dx+(if(abs(below(y, 0.5))>0.00001,(if(abs(above(y, 0.3))>0.00001,(-0.02*cos((8*treb))),0)),0)));
per_pixel_5=rot=(rot+(if(abs(below(rad, 0.3))>0.00001,(if(abs(above(progress, 0.0))>0.00001,0.1,0.1)),0)));
per_pixel_6=rot=(rot+((1-rad)*0.25));
