MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
bWaveThick=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=5.427003
fWaveSmoothing=0.5
ib_size=0.25
mv_a=0.0
mv_l=1.0
ob_a=1.0
ob_size=0.005
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
