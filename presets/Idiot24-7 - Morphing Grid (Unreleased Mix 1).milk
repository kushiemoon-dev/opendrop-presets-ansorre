MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.94
fWaveScale=0.01
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
mv_a=0.0
nWaveMode=7.0
ob_size=0.0
rot=-0.0001
warp=0.01
wave_b=0.7
wave_g=0.4
wave_r=0.7
fVideoEchoZoom=1.0
fWaveAlpha=1.0
fWaveParam=-0.38
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=wave_x=(if(abs(above(bass, bass_att))>0.00001,0.300,(wave_x*sin(time))));
per_frame_2=wave_y=(if(abs(above(treb, treb_att))>0.00001,0.600,(wave_y*sin(time))));
per_frame_3=wave_r=(wave_r*sin(bass));
per_frame_4=wave_b=(wave_b*sin(treb));
per_frame_5=wave_g=(wave_g*sin(mid));
per_frame_6=wave_mystery=floor(int(rand(5)));
per_pixel_1=zoom=((zoom*sin((bass+rad)))+(0.10*sin((bass_att*rad))));
