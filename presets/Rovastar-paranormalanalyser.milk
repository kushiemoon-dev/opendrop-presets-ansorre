PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
bDarkenCenter=1.0
fDecay=0.985
fWarpScale=0.2247
fWaveScale=0.017776
mv_a=0.0
mv_l=5.0
nWaveMode=7.0
ob_a=1.0
ob_size=0.02
sx=0.8443
sy=0.9052
warp=1.22019
wave_b=0.5
wave_g=0.5
wave_r=0.5
wave_y=0.0
zoom=1.1046
fVideoEchoZoom=0.950146
fZoomExponent=0.4845
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=bass_effect = 0;
per_frame_init_2=treb_effect = 0;
per_frame_init_3=sp = 0;
per_frame_init_4=sp2 = 0;
per_frame_1=warp=0;
per_frame_2=wave_r=(wave_r+(0.4*sin((2.111*time))));
per_frame_3=wave_g=(wave_g+(0.4*sin((0.974*time))));
per_frame_4=wave_b=(wave_b+(0.4*sin((0.888*time))));
per_frame_5=wave_y=(wave_y+(0.28*bass));
per_pixel_1=bass_effect=max((max(bass, bass_att)-1.25), 0);
per_pixel_2=treb_effect=max((max(treb, treb_att)-1.275), 0);
per_pixel_3=sp=pow(((((4*bass_effect)*y))%(2)), 10);
per_pixel_4=sp2=pow(((((4*treb_att)*x))%(2)), 10);
per_pixel_5=dx=(if(abs(above(x, 0.5))>0.00001,(0.1*(dx-(sp-0.5))),(0.1*(dx+(sp-0.5)))));
per_pixel_6=dy=(if(abs(above(y, 0.5))>0.00001,(0.1*(dy-(sp2-0.5))),(0.1*(dy+(sp2-0.5)))));
