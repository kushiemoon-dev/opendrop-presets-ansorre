per_frame_init_3=rotdir = 0;
per_frame_1=wave_r=(if(abs(above(bass, 1.8))>0.00001,1,1));
per_frame_2=wave_g=(if(abs(above(bass, 1.8))>0.00001,1,0));
per_frame_3=wave_b=(if(abs(above(bass, 1.8))>0.00001,0,0));
per_frame_4=wave_r=(if(abs(above(treb, 1.8))>0.00001,0,wave_r));
per_frame_5=wave_g=(if(abs(above(treb, 1.8))>0.00001,0,wave_g));
per_frame_6=wave_b=(if(abs(above(treb, 1.8))>0.00001,1,wave_b));
per_frame_7=x=sin(time);
per_frame_8=y=cos(time);
per_frame_9=cx=sqrt(sqr((x+y)));
per_frame_10=cy=cx;
per_frame_11=sy=6.28;
per_frame_12=wave_r=(if(abs(above(mid, 1.5))>0.00001,0,wave_r));
per_frame_13=wave_g=(if(abs(above(mid, 1.5))>0.00001,1,wave_g));
per_frame_14=wave_b=(if(abs(above(mid, 1.5))>0.00001,0,wave_b));
per_frame_15=wave_r=(if(abs(equal(((time)%(5)), 0))>0.00001,(0.5+(0.5*sin(time))),wave_r));
per_frame_16=wave_g=(if(abs(equal(((time)%(5)), 0))>0.00001,(0.5+(0.5*sin((time*0.933)))),wave_g));
per_frame_17=wave_b=(if(abs(equal(((time)%(5)), 0))>0.00001,(0.5+(0.5*sin((time*0.900)))),wave_b));
per_frame_18=rotdir=(if(abs(equal(rotdir, 0))>0.00001,1,rotdir));
per_frame_19=rotdir=(if(abs(equal(rotdir, 1))>0.00001,-1,1));
per_frame_20=rot=(if(abs(equal(((time)%(8)), 0))>0.00001,(rotdir*0.5),0));
