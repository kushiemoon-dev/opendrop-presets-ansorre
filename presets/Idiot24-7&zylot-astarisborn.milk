MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.96
fWaveScale=0.224776
fWaveSmoothing=0.0
mv_a=0.0
nWaveMode=2.0
rot=0.2
wave_b=0.5
wave_g=0.5
wave_r=0.5
fWaveAlpha=3.558724
fZoomExponent=0.0258
fWaveParam=-0.6
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=warp=0;
per_frame_2=wave_r=(if(abs(above(bass, bass_att))>0.00001,(wave_r+0.2),(wave_r-0.2)));
per_frame_3=wave_b=(if(abs(above(treb, treb_att))>0.00001,(wave_b-0.3),(wave_b*sin(time))));
per_frame_4=wave_g=(if(abs(above(mid, mid_att))>0.00001,(wave_g*sin(time)),(wave_g+(0.2*sin(time)))));
per_pixel_1=zoom=(zoom+(sin(((ang*10)+time))*((0.5)&((bass-1)))));
per_pixel_2=zoom=(if(abs(below(zoom, 1))>0.00001,1,zoom));
per_pixel_3=rot=(if(abs(above(mid, bass_att))>0.00001,(rot*sin((rad*above(bass, bass_att)))),(-rot*sin((rad*above(treb, treb_att))))));
