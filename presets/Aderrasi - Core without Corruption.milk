per_frame_11=ib_b=(if(abs(above(truecolors, 0))>0.00001,0,0.5));
per_pixel_1=caps=floor(((2-rad))/(2));
per_pixel_2=rot=(rot+((((0.1*sqr(caps))*sin(bass_att))*3)*sin(time)));
per_pixel_3=zoom=(zoom+(0.025*floor((caps)/(bass_att))));
per_pixel_4=warp=0;
