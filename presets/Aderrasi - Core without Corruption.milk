per_frame_4=ib_size=(ib_size+(0.08*sin(treb_att)));
per_frame_5=truecolors=(2*sin((0.75*time)));
per_frame_6=ob_r=(if(abs(above(truecolors, 0))>0.00001,1,0.1));
per_frame_7=ob_g=(if(abs(above(truecolors, 0))>0.00001,0.2,0.2));
per_frame_8=ob_b=(if(abs(above(truecolors, 0))>0.00001,0,0.9));
