per_frame_14=mv_dy=-0.1;
per_frame_15=mv_r=(0.7+(0.148*(ib_r+ib_b)));
per_frame_16=mv_b=(1-(0.2*(ib_r+ib_b)));
per_frame_17=mv_g=(0.6+(0.19*(ib_g+ib_r)));
per_frame_18=zoom=(zoom-(0.02*thresh));
per_frame_19=wave_r=ib_r;
per_frame_20=wave_b=ib_b;
per_frame_21=wave_g=ib_g;
per_pixel_1=q1=below(sqrt((rad-1)), 0.3);
per_pixel_2=zoom=(if(abs(q1)>0.00001,(zoom-0.9),zoom));
per_pixel_3=rot=(if(abs(q1)>0.00001,rot,((rot*rot)*rad)));
per_pixel_4=cx=(if(abs(q1)>0.00001,2,0.5));
