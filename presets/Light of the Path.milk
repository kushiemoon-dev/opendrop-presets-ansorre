per_frame_5=wave_g=((wave_g+(0.2*sin(time)))+(treb*0.3));
per_frame_6=wave_b=((wave_b+(0.2*sin((time*0.988))))+(mid*0.3));
per_pixel_1=zoomlv=((0.1*sin(((ang*1000)+time)))+0.05);
per_pixel_2=zoom=(zoom+zoomlv);
