MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bBrighten=1.0
fDecay=0.9
fGammaAdj=1.0
fWaveScale=0.01
fWaveSmoothing=0.54
mv_a=0.0
sy=0.999998
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
fVideoEchoZoom=0.999608
fWaveParam=-0.32
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=dx_residual = 0;
per_frame_init_2=dy_residual = 0;
per_frame_init_3=bass_thresh = 0;
per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0005);
per_frame_3=dx=(dx-(0.001*sin((time*0.324))));
per_frame_4=dy=(dy-(0.001*sin((time*0.321))));
per_frame_5=wave_r=(bass*2);
per_frame_6=wave_g=(mid*4);
per_frame_7=wave_b=(treb*0.6);
per_frame_8=wave_mystery=(if(abs(above(bass, 1.1))>0.00001,(-0.3+(0.01*bass)),-0.31));
per_frame_9=dx=(dx+dx_residual);
per_frame_10=dy=(dy+dy_residual);
per_frame_11=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_12=dx_residual=(((equal(bass_thresh, 2)*0.0096)*sin((time*17)))+((0.6*(1-equal(bass_thresh, 2)))*dx_residual));
per_frame_13=dy_residual=(((equal(bass_thresh, 2)*0.0072)*sin((time*19)))+((0.6*(1-equal(bass_thresh, 2)))*dy_residual));
per_pixel_1=zoom=(if(abs(above(rad, 0.15))>0.00001,(1+(rad*0.2)),(1-(rad*0.2))));
per_pixel_2=zoom=(zoom+(0.01*rad));
