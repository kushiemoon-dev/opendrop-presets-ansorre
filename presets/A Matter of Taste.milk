sx=1.06152
sy=1.06152
wave_b=0.5
wave_g=0.5
wave_r=0.5
bAdditiveWaves=1.0
fVideoEchoAlpha=0.5
fVideoEchoZoom=1.006587
fWaveAlpha=1.264366
fShader=0.3
