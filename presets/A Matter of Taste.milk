per_frame_init_1=anti_rad = 0;
per_frame_init_2=throttle = 0;
per_frame_init_3=breathing_time = 0;
per_frame_init_4=curvature = 0;
per_frame_init_5=full_curve = 0;
per_frame_init_6=color_cycle_speed = 0;
per_frame_init_7=color_shift = 0;
per_frame_1=warp=0;
per_frame_2=color_cycle_speed=floor((mid_att)/(2));
per_frame_3=color_shift=(if(abs(above(abs(color_shift), 10000))>0.00001,-100,(color_shift+color_cycle_speed)));
per_frame_4=wave_r=(wave_r+(0.5*sin(((color_shift*0.999)*color_cycle_speed))));
per_frame_5=wave_g=(wave_g+(0.5*sin(((color_shift*0.998)*color_cycle_speed))));
per_frame_6=wave_b=(wave_b+(0.5*sin(((color_shift*0.997)*color_cycle_speed))));
per_frame_7=wave_mystery=(sin((time*1.444))*0.4);
per_frame_8=zoom=(zoom+(0.07*sin((time*0.822))));
per_pixel_1=anti_rad=(1-rad);
per_pixel_2=throttle=0.06;
per_pixel_3=breathing_time=sin((time*0.8));
per_pixel_4=curvature=cos(((((anti_rad*10)*sin((time*0.75)))-((x*10)*sin((time*0.5))))+((y*10)*sin((time*0.25)))));
per_pixel_5=full_curve=(((anti_rad*throttle)*curvature)*breathing_time);
per_pixel_6=dx=(if(abs(below(sin(time), 0.5))>0.00001,full_curve,dx));
per_pixel_7=dy=(if(abs(above(sin(time), -0.5))>0.00001,full_curve,dy));
per_pixel_8=rot=(if(abs(below(abs((dx-dy)), abs(sin(time))))>0.00001,(-0.1*sin(floor((time)/(2)))),0));
per_pixel_9=zoom=(zoom-full_curve);
