MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fDecay=0.955
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpScale=1.331
fWaveScale=0.01
fWaveSmoothing=0.63
ib_size=0.26
mv_g=0.7
mv_l=5.0
mv_r=0.5
ob_r=0.01
ob_size=0.5
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.4
bAdditiveWaves=1.0
fVideoEchoZoom=1.006596
nVideoEchoOrientation=3.0
fWaveAlpha=4.099998
nMotionVectorsX=64.0
nMotionVectorsY=2.016
fWaveParam=-0.2
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=avebass = 0;
per_frame_init_2=bassbox = 0;
per_frame_init_3=ok_to_change = 0;
per_frame_init_4=beat_time = 0;
per_frame_init_5=bass_effect = 0;
per_frame_init_6=effect = 0;
per_frame_1=dx=(dx-0.0005);
per_frame_2=dy=(dy-0.0005);
per_frame_3=wave_r=(0.8+(0.2*sin((time*1.24))));
per_frame_4=wave_g=(0.3+(0.1*sin((time*0.54))));
per_frame_5=wave_b=(0.25+(0.1*sin((time*0.677))));
per_frame_6=mv_r=(0.5+(0.5*sin((time*2.71))));
per_frame_7=mv_g=(0.6+(0.3*sin((time*1.324))));
per_frame_8=mv_b=(0.6+(0.3*sin((time*0.879))));
per_frame_9=mv_y=2;
per_frame_10=ok_to_change=(if(abs(above(time, (beat_time+5)))>0.00001,1,0));
per_frame_11=bass_effect=(max(bass, bass_att)-1);
per_frame_12=beat_time=(if(abs(above(bass_effect, 0.5))>0.00001,(if(abs(ok_to_change)>0.00001,time,beat_time)),beat_time));
per_frame_13=effect=(if(abs(equal(time, beat_time))>0.00001,abs((effect-1)),effect));
per_frame_14=mv_y=(if(abs(above(effect, 0))>0.00001,48,2));
per_frame_15=mv_x=(if(abs(above(effect, 0))>0.00001,2,64));
per_pixel_1=avebass=((0.5*(bass+bass_att))+0.05);
per_pixel_2=bassbox=max(min(avebass, 1.3), 0.7);
per_pixel_3=rot=(if(abs(above(rad, 1))>0.00001,0,(rot+((1-bassbox)*sin((1-rad))))));
