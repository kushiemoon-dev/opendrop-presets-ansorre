per_frame_init_3=v1 = 0;
per_frame_init_4=v2 = 0;
per_frame_init_5=bass_effect = 0;
per_frame_init_6=treb_effect = 0;
per_frame_init_7=mid_effect = 0;
per_frame_init_8=v21 = 0;
per_frame_1=v1=((1+(0.5*sin(treb_att)))+(0.5*cos(bass)));
per_frame_2=v2=((1-(0.5*sin(mid_att)))-(0.5*cos(treb)));
per_frame_3=cx=(if(abs(above(v1, v2))>0.00001,(cx+0.200),(cx-0.200)));
per_frame_4=cy=(if(abs(above(v2, v1))>0.00001,(cy-0.300),(cy+0.400)));
per_frame_5=bass_effect=((above(bass, bass_att)-treb_effect)-mid_effect);
per_frame_6=treb_effect=((above(treb, treb_att)-bass_effect)-mid_effect);
per_frame_7=mid_effect=((above(mid, mid_att)-bass_effect)-treb_effect);
per_frame_8=wave_r=(wave_r*(if(abs(above(above(bass, bass_att), above(treb, treb_att)))>0.00001,(wave_r*sin(bass_effect)),(wave_r*sin(treb_effect)))));
per_frame_9=wave_b=(wave_b*(if(abs(above(above(mid, mid_att), above(bass, bass_att)))>0.00001,(wave_b*sin(mid_effect)),(wave_b*sin(bass_effect)))));
per_frame_10=wave_g=(wave_g*(if(abs(above(above(treb, treb_att), above(mid, mid_att)))>0.00001,(wave_g*sin(treb_effect)),(wave_g*sin(mid_effect)))));
per_frame_11=ob_r=(if(abs(above(v1, v2))>0.00001,(ob_r*sin(time)),(ob_r*sin(v1))));
per_frame_12=ob_b=(if(abs(above(v1, v2))>0.00001,(ob_b*cos(bass)),(ob_r*sin(time))));
per_frame_13=ob_g=(if(abs(above(v1, v2))>0.00001,(ob_g*tan(mid)),(ob_g*sin(v2))));
per_frame_14=ob_a=(if(abs(above((bass*v1), (treb*v1)))>0.00001,ob_a,0));
per_frame_15=ib_a=(if(abs(above((mid*v1), (v1*v2)))>0.00001,ib_a,0));
per_frame_16=ob_size=(ob_size+(0.03*sin((v1*time))));
per_frame_17=dy=(dy*sin(above((time*mid), ((time*bass)+treb))));
per_frame_18=dx=(dx*sin(above((time*bass), (treb*time))));
per_frame_19=wave_mode=(if(abs(above((bass+treb), (bass_att+treb_att)))>0.00001,(wave_mode+((7*sin(time))*sin(above(bass, bass_att)))),(wave_mode+((7*sin(time))*sin(above(treb, treb_att))))));
per_frame_20=wave_a=(if(abs(above((v1*bass), (v2*bass)))>0.00001,wave_a,0));
per_frame_21=mv_a=((0.7*sin(above((v1+1), v21)))*sin((bass*time)));
per_frame_22=mv_r=(above(v1, v2)*sin(time));
per_frame_23=mv_b=(above((v1+1), (v2+1))-(0.2*sin(time)));
per_frame_24=mv_g=(above(v1, v2)*sin(((bass*treb)*time)));
per_pixel_1=timevar=(0+(2*sin((bass+((treb_att*time)*rad)))));
per_pixel_2=timevar2=(0+(5*sin((mid+(time*rad)))));
per_pixel_3=rot=(if(abs(above(timevar, 1.5))>0.00001,(rot+(0.05*sin(((((rad*12)+time)+rad)+20)))),(rot-(0.05*cos((((rad+10)+time)+5))))));
