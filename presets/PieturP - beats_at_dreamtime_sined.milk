per_frame_init_1=q1 = 0;
per_frame_init_2=ddoe1 = 0;
per_frame_init_3=ddoe2 = 0;
per_frame_init_4=doen = 0;
per_frame_1=ddoe1=((1-below(treb_att, 1.4))*0.9);
per_frame_2=ddoe2=((1-below(bass_att, 1.4))*0.7);
per_frame_3=doen=below(bass_att, 1.45);
per_frame_4=decay=1;
per_frame_5=monitor=decay;
per_frame_6=q1=ddoe2;
per_frame_7=rot=(rot+(sin(time)*(ddoe1+0.1)));
per_frame_8=dx=(ddoe1*(bass*0.9));
per_frame_9=dy=(ddoe2*(bass*0.9));
per_frame_10=wave_r=(max((max(bass, bass_att)-1.2), 0)+0.5);
per_frame_11=wave_g=(max((max(treb, treb_att)-1.2), 0)+0.5);
per_frame_12=wave_b=(max((max(mid, mid_att)-1.2), 0)+0.5);
per_frame_13=ob_r=wave_r;
per_frame_14=ob_g=wave_g;
per_frame_15=ob_b=wave_b;
per_frame_16=ob_size=((1-doen)*(treb*0.2));
per_pixel_1=zoom=(zoom+((1-((ang*sin(time))*0.9))*q1));
per_pixel_2=dx=(1+(above(1.8, bass_att)*sin((rad+(bass*2)))));
