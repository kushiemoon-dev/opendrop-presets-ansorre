per_frame_2=q8=(oldq8+(0.0003*floor((pow(((((((1+(1.2*bass))+(0.4*bass_att))+(0.1*treb))+(0.1*treb_att))+(0.1*mid))+(0.1*mid_att)), 6))/(fps))));
