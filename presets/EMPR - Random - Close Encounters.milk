MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=q1 = 0;
per_frame_init_2=q2 = 0;
per_frame_init_3=q3 = 0;
per_frame_init_4=q4 = 0;
per_frame_init_5=b = 0;
per_frame_1=wave_r=(wave_r+(0.250*((0.60*sin((2.137*time)))+(0.40*sin((1.770*time))))));
per_frame_2=wave_g=(wave_g+(0.300*((0.60*sin((1.944*time)))+(0.40*sin((1.541*time))))));
per_frame_3=wave_b=(wave_b+(0.250*((0.60*sin((1.251*time)))+(0.40*sin((1.655*time))))));
per_frame_4=q1=(cx+(0.410*((0.60*sin((0.374*time)))+(0.40*sin((0.294*time))))));
per_frame_5=q2=(cy+(0.410*((0.60*sin((0.393*time)))+(0.40*sin((0.223*time))))));
per_frame_6=q3=(dx+(0.010*((0.60*sin((0.234*time)))+(0.40*sin((0.277*time))))));
per_frame_7=q4=(dy+(0.010*((0.60*sin((0.284*time)))+(0.40*sin((0.247*time))))));
per_frame_8=decay=(decay-(0.01*equal(((frame)%(6)), 0)));
per_frame_9=wave_g=(time+time);
per_frame_10=wave_r=(bass*wave_b);
per_frame_11=wave_r=(if(abs(below(wave_r, 0.0))>0.00001,0.0,wave_r));
per_frame_12=wave_r=(if(abs(above(wave_r, 1.0))>0.00001,1.0,wave_r));
per_frame_13=wave_g=(if(abs(below(wave_g, 0.0))>0.00001,0.0,wave_g));
per_frame_14=wave_g=(if(abs(above(wave_g, 1.0))>0.00001,1.0,wave_g));
per_frame_15=wave_r=(if(abs(below(wave_r, 0.0))>0.00001,0.0,wave_r));
per_frame_16=wave_r=(if(abs(above(wave_r, 1.0))>0.00001,1.0,wave_r));
per_frame_17=wave_g=(if(abs(below(wave_g, 0.0))>0.00001,0.0,wave_g));
per_frame_18=wave_g=(if(abs(above(wave_g, 1.0))>0.00001,1.0,wave_g));
per_pixel_1=cx=(if(abs(above(sin((time*1.321)), 0))>0.00001,q1,cx));
per_pixel_2=cy=(if(abs(above(sin((time*1.432)), 0))>0.00001,q2,cx));
per_pixel_3=dx=(if(abs(above(sin((time*1.543)), 0))>0.00001,q3,dx));
per_pixel_4=dy=(if(abs(above(sin((time*1.654)), 0))>0.00001,q4,dy));
per_pixel_5=rot=(if(abs(above(sin((time*3.888)), 0))>0.00001,(rot-(0.2*cos(((x*2)-1)))),(0.2*sin((time*4.216)))));
per_pixel_6=zoom=(zoom-((0.043*cos(((x*2)-1)))*sin((time*1.21))));
per_pixel_7=dy=(q1*b);
per_pixel_8=warp=(b*rot);
per_pixel_9=rot=(ang-y);
per_pixel_10=zoomexp=(rot*ang);
per_pixel_11=zoomexp=(if(abs(below(zoomexp, 0.01))>0.00001,0.01,zoomexp));
per_pixel_12=zoomexp=(if(abs(above(zoomexp, 100.0))>0.00001,100.0,zoomexp));
per_pixel_13=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_14=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_15=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_pixel_16=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_pixel_17=dy=(if(abs(below(dy, -1))>0.00001,-1,dy));
per_pixel_18=dy=(if(abs(above(dy, 1.0))>0.00001,1.0,dy));
