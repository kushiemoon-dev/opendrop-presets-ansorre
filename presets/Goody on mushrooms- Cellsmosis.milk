MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bDarken=1.0
bModWaveAlphaByVolume=1.0
bSolarize=1.0
fDecay=1.0
fGammaAdj=3.24
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpAnimSpeed=2.599
fWarpScale=0.01
fWaveScale=0.46
fWaveSmoothing=0.9
ib_b=0.0
ib_g=0.0
ib_r=0.0
ib_size=0.0
mv_a=0.0
mv_b=0.35
mv_g=0.35
mv_l=0.5
mv_r=0.35
nWaveMode=3.0
ob_b=1.0
ob_g=1.0
ob_r=1.0
ob_size=0.0
sy=1.0017
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
zoom=0.99979
fVideoEchoAlpha=0.5
fVideoEchoZoom=0.997
nVideoEchoOrientation=3.0
fWaveAlpha=1.008
fZoomExponent=0.9999
nMotionVectorsX=64.0
nMotionVectorsY=48.0
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
wavecode_0_enabled=0.0
wavecode_1_enabled=0.0
wavecode_2_enabled=0.0
wavecode_3_enabled=0.0
per_frame_init_1=vol = 0;
per_frame_init_2=redsine = 0;
per_frame_init_3=greensine = 0;
per_frame_init_4=bluesine = 0;
per_frame_init_5=redif = 0;
per_frame_init_6=greenif = 0;
per_frame_init_7=blueif = 0;
per_frame_init_8=decay=0.1;
per_frame_1=sx=1;
per_frame_2=sy=1;
per_frame_3=vol=(((bass+mid)+treb_att)*0.3333);
per_frame_4=redsine=(0.5+((0.15*bass)*sin((time*3))));
per_frame_5=greensine=(0.5+((0.15*mid)*sin((time*2))));
per_frame_6=bluesine=(0.5+((0.15*treb)*sin(time)));
per_frame_7=redif=(if(abs(above(bass, 1.2))>0.00001,redsine,(if(abs(above(redif, 0.95))>0.00001,0,(redif*0.85)))));
per_frame_8=greenif=(if(abs(above(mid, 1.2))>0.00001,greensine,(if(abs(above(greenif, 0.95))>0.00001,0,(greenif*0.85)))));
per_frame_9=blueif=(if(abs(above(treb, 1.2))>0.00001,bluesine,(if(abs(above(blueif, 0.95))>0.00001,0,(blueif*0.85)))));
per_frame_10=ib_r=redif;
per_frame_11=ib_g=greenif;
per_frame_12=ib_b=blueif;
per_frame_13=wave_r=(redif*abs(sin(redif)));
per_frame_14=wave_g=(greenif*abs(sin(greenif)));
per_frame_15=wave_b=(blueif*abs(sin(blueif)));
per_frame_16=zoom=(zoom+(0.01*treb_att));
per_pixel_1=rot=(rot+(0.01*sin((rad*time))));
per_pixel_2=cx=(cx+(0.1*sin((time*0.9))));
per_pixel_3=cy=(cy+(0.1*sin((time*0.9))));
