per_frame_1=db=((bass-lbass)*fps);
per_frame_2=lbass=bass;
per_frame_3=avgdb=((avgdb*0.99)+(abs(db)*0.01));
per_frame_4=rawbeatb=above(abs(db), avgdb);
per_frame_5=beatb=(rawbeatb*above((time-lbbtime), (avgbbeatrate*0.5)));
per_frame_6=beatb2=(beatb*above(abs(db), (avgdb*3)));
per_frame_7=beatbhard=(beatb*(abs(db)-avgdb));
per_frame_8=avgbbeatrate=((beatb*((avgbbeatrate*0.9)+((time-lbbtime)*0.1)))+((1-beatb)*(avgbbeatrate+((3-avgbbeatrate)*0.00001))));
per_frame_9=lbbtime2=((time*beatb2)+((1-beatb2)*lbbtime2));
per_frame_10=lbbtime=((time*beatb)+((1-beatb)*lbbtime));
per_frame_11=ph=(((time-lbbtime2)*floor((60)/(avgbbeatrate)))*const);
per_frame_12=phase=max(min(ph, 1), 0);
per_frame_13=const=((const*(1-beatb2))+(beatb2*(const+(0.0001*bool))));
per_frame_14=bool=((below(phase, 0.98)*(0.99-ph))-(above(phase, 0.98)*(ph*0.5)));
per_frame_15=bc=(bc+beatb);
per_frame_16=vol=((rawbeatb*abs(db))*0.001);
per_frame_17=avgvol=((avgvol*0.999)+(vol*0.01));
per_frame_18=mtime=(mtime+((min((treb_att*0.01), 0.25)-(beatbhard*0.01))*floor((1)/(fps))));
per_frame_19=mtime2=(mtime2+((min((avgdb*0.01), 0.25)+(beatbhard*0.01))*floor((1)/(fps))));
per_frame_20=warp=0;
per_frame_21=zoom=1;
per_frame_22=gamma=((1+abs((db*0.01)))+beatbhard);
per_frame_23=invert=(above(db, (avgdb*4))*beatb);
per_frame_24=q1=rawbeatb;
per_frame_25=q2=beatbhard;
per_frame_26=q3=floor((60)/(avgbbeatrate));
per_frame_27=q4=phase;
per_frame_28=q5=avgdb;
