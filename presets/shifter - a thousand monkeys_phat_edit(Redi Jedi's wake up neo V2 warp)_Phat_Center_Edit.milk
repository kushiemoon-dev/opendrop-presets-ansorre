per_frame_31=q7=mtime;
per_frame_32=q8=mtime2;
per_frame_33=monitor=bool;
per_frame_34=dy=(0.00003*q3);
per_frame_35=tdy=(tdy+(dy*floor((50)/(fps))));
per_frame_36=q6=(1-above(tdy, 0.06));
per_frame_37=tdy=(if(abs((1-q6))>0.00001,0,tdy));
per_frame_38=warp=((above(db, (avgdb*4))*beatb)*bass_att);
