per_frame_2=color_const=abs(sin(time));
per_frame_3=wave_r=(1+sin((-color_const*3.1415)));
per_frame_4=wave_g=abs(sin(((2*color_const)*3.1415)));
per_frame_5=wave_b=sin((color_const*3.1415));
