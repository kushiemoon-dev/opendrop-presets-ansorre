per_frame_7=ob_r=wave_r;
per_frame_8=ob_b=wave_b;
per_frame_9=dx=(0.3*sin(time));
per_frame_10=dy=(0.3*cos((3*time)));
per_frame_11=monitor=(((wave_b+wave)+g)+wave_r);
per_pixel_1=rot=(rot+(8*sin(rad)));
per_pixel_2=zoom=(zoom+(0.001*rad));
