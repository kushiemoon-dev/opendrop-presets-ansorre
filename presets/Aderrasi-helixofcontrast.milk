MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
bWaveThick=1.0
dx=1e-05
dy=1e-05
fDecay=1.0
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWaveScale=0.499722
fWaveSmoothing=0.9
ib_size=0.25
mv_a=0.0
mv_l=1.0
ob_a=1.0
ob_size=0.005
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
fVideoEchoZoom=0.248317
nVideoEchoOrientation=3.0
fWaveAlpha=100.0
nMotionVectorsX=0.0
nMotionVectorsY=0.0
fWaveParam=-0.494
bTexWrap=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=progress = 0;
per_frame_init_2=xl = 0;
per_frame_init_3=xr = 0;
per_frame_1=wave_x=(wave_x+(0.4*sin((0.9*time))));
per_frame_2=wave_b=(wave_b+(if(abs(below(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,-2,-2)),0)));
per_frame_3=wave_g=(wave_g+(if(abs(below(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,-2,2)),0)));
per_frame_4=wave_r=(wave_r+(if(abs(below(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,2,-2)),0)));
per_frame_5=xl=(wave_x-0.5);
per_frame_6=xr=(wave_x+0.5);
per_frame_7=wave_y=(wave_y+(if(abs(above(sin((50*time)), 0))>0.00001,(-0.2*sin((3*time))),0)));
per_frame_8=dy=(dy+(0.005*sin(time)));
per_frame_9=zoom=((zoom-0.007)-(0.005*sin(time)));
per_frame_10=rot=(rot+0.005);
per_frame_11=wave_b=(wave_b+(if(abs(below(progress, 0.66))>0.00001,(if(abs(above(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,2,-2)),0)),0)));
per_frame_12=wave_g=(wave_g+(if(abs(below(progress, 0.66))>0.00001,(if(abs(above(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,-2,2)),0)),0)));
per_frame_13=wave_r=(wave_r+(if(abs(below(progress, 0.66))>0.00001,(if(abs(above(progress, 0.33))>0.00001,(if(abs(below(bass, 1))>0.00001,2,2)),0)),0)));
per_frame_14=wave_b=(wave_b+(if(abs(above(progress, 0.66))>0.00001,(if(abs(below(bass, 1))>0.00001,2,0)),0)));
per_frame_15=wave_g=(wave_g+(if(abs(above(progress, 0.66))>0.00001,(if(abs(below(bass, 1))>0.00001,0,0.5)),0)));
per_frame_16=wave_r=(wave_r+(if(abs(above(progress, 0.66))>0.00001,(if(abs(below(bass, 1))>0.00001,0,1)),0)));
