per_frame_init_1=skopywopydopymopy = 0;
per_frame_init_2=swdm = 0;
per_frame_1=wave_r=(wave_r-((0.20*sin(time))*(if(abs(above(wave_b, wave_g))>0.00001,1,0))));
per_frame_2=wave_b=(wave_b+((0.10*sin(time))*(if(abs(above(wave_r, wave_g))>0.00001,1,0))));
per_frame_3=wave_g=(wave_g-((0.20*sin(time))*(if(abs(above(wave_r, wave_b))>0.00001,1,0))));
per_frame_4=wave_y=(wave_y-(0.20*sin(bass)));
per_frame_5=wave_mystery=(wave_mystery+(0.10*sin(time)));
per_pixel_1=zoom=(zoom+((((0.10*sin(bass))*(if(abs(below(ang, (rad*ang)))>0.00001,1,3)))*rad)*sin(bass)));
per_pixel_2=skopywopydopymopy=(pow(1, 2)*rad);
per_pixel_3=swdm=skopywopydopymopy;
per_pixel_4=dx=(((dx*swdm)*(if(abs(above(dy, 0))>0.00001,1.2,0)))*sin(time));
per_pixel_5=dy=(((dy*swdm)*(if(abs(below(dx, 0))>0.00001,1.2,0)))*sin(time));
per_pixel_6=rot=(((rot*rad)*2)*sin(time));
