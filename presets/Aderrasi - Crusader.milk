per_frame_init_1=rad = 0;
per_frame_1=wave_r=(wave_r+(0.4*sin((8*bass))));
per_frame_2=wave_g=(wave_g+(0.4*sin((8*treb))));
per_frame_3=wave_b=(wave_b+(0.4*sin((8*mid))));
per_frame_4=zoom=(zoom+(if(abs(above(rad, (0.5-(0.2*sin((1.5*bass))))))>0.00001,(0.1*bass),0)));
per_frame_5=zoom=(zoom+(if(abs(below(warp, 1))>0.00001,0.03,0)));
per_frame_6=rot=(rot+(if(abs(below(warp, 0))>0.00001,(0.025*bass),(-0.025*bass))));
per_frame_7=warp=(warp+(if(abs(above(bass, 1.1))>0.00001,2,0)));
per_pixel_1=dx=((dx+(floor(((0.005*treb))/(bass))*cos(time)))+(0.01*sin(((0.5*ang)*(2*bass)))));
per_pixel_2=dy=((dy+(floor(((0.005*treb))/(bass))*sin(time)))+(0.01*cos(((0.5*ang)*(2*bass)))));
