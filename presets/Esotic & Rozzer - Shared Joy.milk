per_frame_16=q1=((floor(slowtime))%(2));
per_frame_17=slowtime=(slowtime+(beat*time));
per_frame_18=vol_now=((0.4*bass)+(0.1*((bass_att+treb)+mid)));
per_frame_19=vol_mean=(if(abs(equal(((frame)%(50)), 0))>0.00001,(vol_mean-(0.5*(vol_mean-vol_now))),(0.1*((vol_mean*9)+vol_now))));
per_frame_20=beat=(if(abs(above(vol_now, (1.5*vol_mean)))>0.00001,1,0));
per_frame_21=beatcount=(beatcount+beat);
per_frame_22=q2=sin(slowtime);
per_frame_23=wave_b=(cos(slowtime)+abs(cos(slowtime)));
per_frame_24=wave_g=abs(sin(slowtime));
per_frame_25=wave_r=(((-1*cos(slowtime))+abs((-1*cos(slowtime))))+(0.2*(cos(sin(slowtime))+(abs(cos(sin(slowtime)))+cos(sin(slowtime))))));
per_frame_26=ib_g=(if(abs(above(wave_g, 1))>0.00001,1,(if(abs(above(wave_g, 0))>0.00001,abs(wave_g),0))));
per_frame_27=ib_b=(if(abs(above(wave_b, 1))>0.00001,1,(if(abs(above(wave_b, 0))>0.00001,abs(wave_b),0))));
