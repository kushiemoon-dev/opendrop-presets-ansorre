per_frame_1=wave_r=(wave_r+(0.35*sin((1.047*time))));
per_frame_2=wave_g=(wave_g-(0.35*(0.60*sin((0.835*time)))));
per_frame_3=wave_b=(wave_b+(0.3*cos((1.011*time))));
per_frame_4=rot=(rot+(0.030*((0.60*sin((0.381*time)))+(0.40*sin((0.479*time))))));
per_frame_5=cx=(cx+(0.110*((0.60*sin((0.374*time)))+(0.40*sin((0.294*time))))));
per_frame_6=cy=(cy+(0.110*((0.60*sin((0.393*time)))+(0.40*sin((0.223*time))))));
per_frame_7=zoom=((zoom+0.05)+(0.05*sin((time*0.133))));
per_frame_8=decay=(decay-(0.01*((frame)%(2))));
per_frame_9=wave_x=(0.5+(0.1*sin(time)));
per_frame_10=wave_y=(0.5-floor((cos(time))/(7.5)));
per_frame_11=dx=(dx+dx_residual);
per_frame_12=dy=(dy+dy_residual);
per_frame_13=bass_thresh=((above(bass_att, bass_thresh)*2)+((1-above(bass_att, bass_thresh))*(((bass_thresh-1.3)*0.96)+1.3)));
per_frame_14=dx_residual=(((equal(bass_thresh, 2)*0.016)*sin((time*7)))+((1-equal(bass_thresh, 2))*dx_residual));
per_frame_15=dy_residual=(((equal(bass_thresh, 2)*0.012)*sin((time*9)))+((1-equal(bass_thresh, 2))*dy_residual));
per_pixel_1=zoom=(zoom+floor((log((sqrt(2)-rad)))/(10)));
