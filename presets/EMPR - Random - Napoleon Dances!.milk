per_frame_init_1=q1 = 0;
per_frame_init_2=b = 0;
per_frame_init_3=madbass = 0;
per_frame_init_4=bass_effect = 0;
per_frame_1=wave_mystery=(-0.4+(0.1*sin(treb)));
per_frame_2=wave_x=(0.3+(0.2*mid));
per_frame_3=wave_y=(0.3+(0.2*bass));
per_frame_4=wave_r=bass;
per_frame_5=wave_g=mid;
per_frame_6=wave_b=treb;
per_frame_7=madbass=max((max(bass, bass_att)-1.3), 0);
per_frame_8=zoom=((zoom-(1.4*madbass))+0.02);
per_frame_9=ib_a=(if(abs(above(bass, 1.2))>0.00001,0.7,0));
per_frame_10=ob_r=(if(abs(above(treb, 1.2))>0.00001,0.3,0.1));
per_frame_11=bass_effect=max((max(bass, bass_att)-1.2), 0);
per_frame_12=q1=(if(abs(above(bass_effect, 0))>0.00001,(0.45+bass_effect),0));
per_frame_13=wave_b=(bass*mid);
per_frame_14=mv_g=(wave_g+wave_g);
per_frame_15=ob_g=(bass*bass);
per_frame_16=wave_x=(mid-bass_att);
per_frame_17=decay=(mid+bass);
per_frame_18=decay=(if(abs(below(decay, 0.0))>0.00001,0.0,decay));
per_frame_19=decay=(if(abs(above(decay, 5.0))>0.00001,5.0,decay));
per_frame_20=wave_b=(if(abs(below(wave_b, 0.0))>0.00001,0.0,wave_b));
per_frame_21=wave_b=(if(abs(above(wave_b, 1.0))>0.00001,1.0,wave_b));
per_frame_22=wave_x=(if(abs(below(wave_x, 0.0))>0.00001,0.0,wave_x));
per_frame_23=wave_x=(if(abs(above(wave_x, 1.0))>0.00001,1.0,wave_x));
per_frame_24=ob_g=(if(abs(below(ob_g, 0.0))>0.00001,0.0,ob_g));
per_frame_25=ob_g=(if(abs(above(ob_g, 1.0))>0.00001,1.0,ob_g));
per_frame_26=mv_g=(if(abs(below(mv_g, 0.0))>0.00001,0.0,mv_g));
per_frame_27=mv_g=(if(abs(above(mv_g, 1.0))>0.00001,1.0,mv_g));
per_frame_28=wave_b=(if(abs(below(wave_b, 0.0))>0.00001,0.0,wave_b));
per_frame_29=wave_b=(if(abs(above(wave_b, 1.0))>0.00001,1.0,wave_b));
per_frame_30=ob_g=(if(abs(below(ob_g, 0.0))>0.00001,0.0,ob_g));
per_frame_31=ob_g=(if(abs(above(ob_g, 1.0))>0.00001,1.0,ob_g));
