per_frame_33=wave_x=(if(abs(above(wave_x, 1.0))>0.00001,1.0,wave_x));
per_frame_34=wave_b=(if(abs(below(wave_b, 0.0))>0.00001,0.0,wave_b));
per_frame_35=wave_b=(if(abs(above(wave_b, 1.0))>0.00001,1.0,wave_b));
per_frame_36=ob_g=(if(abs(below(ob_g, 0.0))>0.00001,0.0,ob_g));
per_frame_37=ob_g=(if(abs(above(ob_g, 1.0))>0.00001,1.0,ob_g));
per_frame_38=mv_g=(if(abs(below(mv_g, 0.0))>0.00001,0.0,mv_g));
per_frame_39=mv_g=(if(abs(above(mv_g, 1.0))>0.00001,1.0,mv_g));
per_pixel_1=rot=(if(abs(below(rad, q1))>0.00001,(sin((((time*0.3)+(ang*8))+(rad*7.5)))*0.063),rot));
per_pixel_2=zoom=(if(abs(below(rad, q1))>0.00001,(1-((0.23*(1-rad))*sin((((time*0.3)+(ang*8))+(rad*7.5))))),zoom));
per_pixel_3=dy=(rot+sy);
per_pixel_4=zoom=(zoomexp*zoomexp);
per_pixel_5=sx=(x*zoom);
per_pixel_6=dx=(b+rot);
per_pixel_7=rot=(zoom*y);
per_pixel_8=warp=(zoom+ang);
per_pixel_9=dy=(dy*bass_att);
per_pixel_10=cx=(rad+time);
per_pixel_11=dy=(dy*b);
per_pixel_12=warp=(warp+bass_att);
per_pixel_13=zoomexp=(zoomexp+sx);
per_pixel_14=dy=(dy*y);
per_pixel_15=rot=(rot*warp);
per_pixel_16=cy=(x*sx);
per_pixel_17=zoom=(zoom+sx);
per_pixel_18=warp=(warp*warp);
per_pixel_19=dy=(dy*q1);
per_pixel_20=sy=(sx+warp);
per_pixel_21=dx=(dx-sy);
per_pixel_22=zoom=(if(abs(below(zoom, 0.01))>0.00001,0.01,zoom));
per_pixel_23=zoom=(if(abs(above(zoom, 100))>0.00001,100,zoom));
per_pixel_24=zoomexp=(if(abs(below(zoomexp, 0.01))>0.00001,0.01,zoomexp));
per_pixel_25=zoomexp=(if(abs(above(zoomexp, 100.0))>0.00001,100.0,zoomexp));
per_pixel_26=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_27=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_28=warp=(if(abs(below(warp, 0.01))>0.00001,0.01,warp));
per_pixel_29=warp=(if(abs(above(warp, 100.0))>0.00001,100.0,warp));
per_pixel_30=cx=(if(abs(below(cx, -1.0))>0.00001,-1.0,cx));
per_pixel_31=cx=(if(abs(above(cx, 2.0))>0.00001,2.0,cx));
per_pixel_32=cy=(if(abs(below(cy, -1.0))>0.00001,-1.0,cy));
per_pixel_33=cy=(if(abs(above(cy, 2.0))>0.00001,2.0,cy));
per_pixel_34=dx=(if(abs(below(dx, -1))>0.00001,-1,dx));
per_pixel_35=dx=(if(abs(above(dx, 1.0))>0.00001,1.0,dx));
per_pixel_36=dy=(if(abs(below(dy, -1))>0.00001,-1,dy));
per_pixel_37=dy=(if(abs(above(dy, 1.0))>0.00001,1.0,dy));
per_pixel_38=sx=(if(abs(below(sx, 0.01))>0.00001,0.01,sx));
per_pixel_39=sx=(if(abs(above(sx, 100.0))>0.00001,100.0,sx));
per_pixel_40=sy=(if(abs(below(sy, 0.01))>0.00001,0.01,sy));
per_pixel_41=sy=(if(abs(above(sy, 100.0))>0.00001,100.0,sy));
