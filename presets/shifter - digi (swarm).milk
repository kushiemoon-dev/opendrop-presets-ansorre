per_frame_2=tic=min((time-tin), 1);
per_frame_3=tin=time;
per_frame_4=ra=10;
per_frame_5=treb_avg=(tic*((treb_avg*(floor((1)/(tic))-ra))+(ra*treb)));
per_frame_6=mid_avg=(tic*((mid_avg*(floor((1)/(tic))-ra))+(ra*mid)));
per_frame_7=bass_avg=(tic*((bass_avg*(floor((1)/(tic))-ra))+(ra*bass)));
per_frame_8=rb=1;
per_frame_9=vav=(tic*((vav*(floor((1)/(tic))-rb))+((rb*((bass+treb)+mid))*0.33333)));
per_frame_10=q1=treb_avg;
per_frame_11=q2=mid_avg;
per_frame_12=q3=bass_avg;
per_frame_13=db=(bass-bass_avg);
per_frame_14=it=((it+tic)*below(it, 1));
per_frame_15=rb=(0.5*floor((1)/(tic)));
per_frame_16=bvb=(tic*((bass*rb)+((floor((1)/(tic))-rb)*bvb)));
per_frame_17=bd=(bass-bvb);
per_frame_18=vm=((vm-tic)+swi);
per_frame_19=swi=above((bd-vm), 0);
per_frame_20=q4=(1-swi);
per_frame_21=cm=(if(abs((above(iter, 30)+equal(time, 0)))>0.00001,(floor(int(rand(3)))+1),cm));
per_frame_22=iter=((iter+tic)*(1-above(iter, 30)));
per_frame_23=q5=(if(abs(equal(cm, 0))>0.00001,3,cm));
per_frame_24=cma=(if(abs((above(itar, 5)+equal(time, 0)))>0.00001,floor((vav*5)),cma));
per_frame_25=itar=((itar+tic)*(1-above(itar, 5)));
per_frame_26=q6=floor((vav*5));
per_frame_27=monitor=q6;
per_frame_28=decay=1;
