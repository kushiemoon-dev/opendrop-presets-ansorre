per_frame_3=wave_r=floor((bass)/(5));
per_frame_4=wave_g=floor((treb)/(5));
per_frame_5=wave_b=(time*sin((floor((bass)/(treb))*10)));
per_frame_6=mv_r=treb;
per_frame_7=mv_g=bass;
per_frame_8=mv_b=mid;
per_frame_9=cx=(cx+(0.225*((0.60*sin((0.350*time)))+(0.40*sin((0.350*time))))));
per_frame_10=cy=(cy+(0.225*((0.60*sin((0.350*time)))+(0.40*sin((0.350*time))))));
per_frame_11=volume=((bass+mid)+att);
per_frame_12=beatrate=(if(abs(equal(beatrate, 0))>0.00001,1,(if(abs(below(volume, 0.01))>0.00001,1,beatrate))));
per_frame_13=lastbeat=(if(abs(equal(lastbeat, 0))>0.00001,time,lastbeat));
per_frame_14=meanbass_att=(0.1*((meanbass_att*9)+bass_att));
per_frame_15=peakbass_att=(if(abs(above(bass_att, peakbass_att))>0.00001,bass_att,peakbass_att));
per_frame_16=beat=(if(abs(above(volume, 0.8))>0.00001,(if(abs(below((peakbass_att-bass_att), (0.05*peakbass_att)))>0.00001,(if(abs(above((time-lastbeat), (0.1+(0.5*(beatrate-0.1)))))>0.00001,1,0)),0)),0));
per_frame_17=beatrate=max((if(abs(beat)>0.00001,(if(abs(below((time-lastbeat), (2*beatrate)))>0.00001,(0.1*(((beatrate*9)+time)-lastbeat)),beatrate)),beatrate)), 0.1);
per_frame_18=peakbass_att=(if(abs(equal(beat, 0))>0.00001,(if(abs(above((time-lastbeat), (2*beatrate)))>0.00001,(peakbass_att*0.95),(peakbass_att*0.995))),bass_att));
per_frame_19=lastbeat=(if(abs(beat)>0.00001,time,lastbeat));
per_frame_20=peakbass_att=max((if(abs(beat)>0.00001,bass_att,peakbass_att)), (1.1*meanbass_att));
per_frame_21=beatcounter=(if(abs(above(progress, 0.01))>0.00001,(if(abs(above(beat, 0))>0.00001,(beatcounter+1),beatcounter)),0));
per_frame_22=beatcounter=(if(abs(above(beatcounter, 101))>0.00001,0,beatcounter));
per_frame_23=beateven=((beatcounter)%(2));
per_frame_24=warp=0;
per_frame_25=beatcount=(beatcount+beat);
per_frame_26=initframe=(if(abs(below(beatcount, 1))>0.00001,frame,initframe));
per_frame_27=rozzorrate=floor(((frame-initframe))/(beatcount));
per_frame_28=monitor=rozzorrate;
per_frame_29=basseffect=max((max(bass, bass_att)-1), 0);
