shapecode_3_enabled=0.0
per_frame_init_1=vol = 0;
per_frame_init_2=newvol = 0;
per_frame_init_3=vol_att = 0;
per_frame_init_4=newvol_att = 0;
per_frame_1=vol=((bass+mid)+treb);
per_frame_2=newvol=(vol*0.2);
per_frame_3=vol_att=((bass_att+treb_att)+mid_att);
per_frame_4=newvol_att=(vol_att*0.2);
per_frame_5=warp=(warp*sin(vol));
per_frame_6=rot=(if(abs(above(vol, vol_att))>0.00001,1,0));
per_frame_7=dx=(dx+((floor((0.05)/(2))*sin(vol_att))*sin(time)));
per_frame_8=dy=(dy+((floor((0.05)/(2))*sin(vol_att))*sin(time)));
per_frame_9=zoom=(zoom+(0.10*sin(((vol*vol_att)*0.1))));
per_frame_10=ob_r=(ob_r*sin(newvol));
per_frame_11=ob_b=(ob_b*sin(newvol));
per_frame_12=echo_alpha=(1*sin(time));
per_frame_13=echo_orient=(0+(3*sin(time)));
per_frame_14=echo_zoom=(echo_zoom-(0.3*sin(time)));
per_frame_15=wave_mode=(7-(1*(if(abs(below(wave_mystery, -wave_mystery))>0.00001,1,0))));
per_frame_16=wave_mystery=(wave_mystery+(5*(if(abs(above(wave_mystery, bass))>0.00001,0,1))));
per_frame_17=sx=((sx-(0.20*sin(vol)))+(floor(int(rand(1.5)))*sin(time)));
per_frame_18=sy=((sy+(0.20*sin(vol_att)))+(floor(int(rand(1.5)))*sin((time*0.53))));
per_frame_19=wave_r=((wave_r*floor(int(rand(2))))*sin((vol*vol_att)));
per_frame_20=wave_g=((wave_g*floor(int(rand(5))))*sin(vol_att));
per_frame_21=wave_b=((wave_b*floor(int(rand(4))))*sin(vol));
per_frame_22=ib_r=(floor(int(rand(2)))+(floor(int(rand(2)))*sin(time)));
per_frame_23=ib_b=(floor(int(rand(4)))+(ob_b*sin(time)));
per_frame_24=ib_g=(floor(int(rand(6)))+(0.2*sin(time)));
