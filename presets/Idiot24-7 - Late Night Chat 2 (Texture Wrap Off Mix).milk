PSVERSION_COMP=2
[preset00]
dx=0.002
dy=-0.01
fDecay=0.925
fGammaAdj=1.0
fModWaveAlphaEnd=1.3
fModWaveAlphaStart=0.71
fWarpAnimSpeed=0.9999
fWarpScale=100.0
fWaveScale=0.01
fWaveSmoothing=0.63
ib_a=0.5
ib_b=1.0
ib_r=1.0
mv_a=0.0
ob_a=1.0
ob_b=1.0
ob_g=0.8
ob_r=1.0
ob_size=0.0
