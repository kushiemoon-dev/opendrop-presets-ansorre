per_frame_init_1=xdx = 0;
per_frame_init_2=xdy = 0;
per_frame_init_3=bass_effect = 0;
per_frame_1=xdx=(dx-0.0005);
per_frame_2=xdy=(dy-0.0005);
per_frame_3=mv_l=(1500+(1000*bass));
per_frame_4=mv_r=(bass*0.343);
per_frame_5=mv_b=(mid*0.865);
per_frame_6=mv_g=(treb*0.434);
per_frame_7=bass_effect=max((max(bass, bass_att)-1.3), 0);
per_frame_8=decay=(if(abs(above(bass_effect, 0))>0.00001,(0.99-(0.1*bass_effect)),0.998));
per_frame_9=wave_r=(wave_r-(0.6*sin(time)));
per_frame_10=wave_b=(0.1+abs(floor((cos(time))/(4))));
per_frame_11=wave_g=(wave_g+floor((atan((2*time)))/(6)));
