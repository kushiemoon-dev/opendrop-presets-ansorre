per_frame_1=wave_r=(wave_r+(0.5*sin((time*1.13))));
per_frame_2=wave_g=(wave_g+(0.5*sin((time*1.23))));
per_frame_3=wave_b=(wave_b+(0.5*sin((time*1.33))));
per_pixel_1=thresh=((above(bass_att, thresh)*2)+((1-above(bass_att, thresh))*(((thresh-1.3)*0.96)+1.3)));
per_pixel_2=dx_r=(((equal(thresh, 2)*0.015)*sin((5*time)))+((1-equal(thresh, 2))*dx_r));
per_pixel_3=dy_r=(((equal(thresh, 2)*0.015)*sin((6*time)))+((1-equal(thresh, 2))*dy_r));
per_pixel_4=zoom=(zoom+(0.05*((sin((12*ang))+(sin(sin((((time*2)*sin(time))*rad)))*0.3))-(cos(rad)*0.1))));
per_pixel_5=rot=(rot+(0.08*sin((0.5-rad))));
per_pixel_6=sx=(sx+(((0.02*((0.99*1)-rad))*sin((0.733*time)))*below(sin(time), 0)));
per_pixel_7=sy=(sy+(((0.02*((0.99*1)-rad))*cos((0.953*time)))*above(sin(time), 0)));
per_pixel_8=zoom=(zoom-(0.01*(1-rad)));
per_pixel_9=dx=(sin(sqrt((sqr((x*15))*15)))*0.01);
per_pixel_10=dy=(sin(sqrt((sqr((y*15))*15)))*0.01);
per_pixel_11=num=8;
per_pixel_12=pi=3.141592654;
per_pixel_13=radi=((y-0.5)*0.75);
per_pixel_14=radi=(y-0.5);
per_pixel_15=radi=pow(((radi*radi)+((x-0.5)*(x-0.5))), 0.5);
per_pixel_16=an=((ang+pi)+time);
per_pixel_17=an=(an-((pi*2)*floor(floor((an)/((pi*2))))));
per_pixel_18=mod=0.1;
per_pixel_19=seg=(ang+pi);
per_pixel_20=seg=(floor((seg)/((pi*2)))*num);
per_pixel_21=seg=floor(seg);
per_pixel_22=seg=(seg-equal(seg, num));
per_pixel_23=anga=((ang+pi)-(floor(((pi*2))/(num))*seg));
per_pixel_24=anga=(if(abs(equal(((seg)%(2)), 0))>0.00001,(floor(((pi*2))/(num))-anga),anga));
per_pixel_25=anga=(anga+floor((pi)/(4)));
per_pixel_26=ox=(0.5-(radi*sin(anga)));
per_pixel_27=oy=(0.5+(radi*cos(anga)));
per_pixel_28=dx=(equal(seg, 3)*(x-ox));
per_pixel_29=dy=(equal(seg, 3)*(y-oy));
per_pixel_30=dx=(above(seg, 0)*(x-ox));
per_pixel_31=dy=(above(seg, 0)*(y-oy));
