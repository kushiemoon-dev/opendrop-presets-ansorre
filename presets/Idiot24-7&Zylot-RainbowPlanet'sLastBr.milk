per_frame_4=wave_b=(0.3+(0.2*sin((time*1.222))));
per_pixel_1=zoom=(zoom+(sin(((ang*10)+time))*((0.5)&((bass-1)))));
per_pixel_2=zoom=(if(abs(below(zoom, 1))>0.00001,1,zoom));
per_pixel_3=rot=(if(abs(above(mid, bass_att))>0.00001,(rot*sin((rad*above(bass, bass_att)))),(-rot*sin((rad*above(treb, treb_att))))));
