per_frame_1=zmena=(-below(x, 0)+above(x, 1));
per_frame_2=smer=(((1-abs(zmena))*smer)-zmena);
per_frame_3=x=((x+(above(smer, 0)*speed_tam))-(below(smer, 0)*speed_zpet));
per_frame_4=y=(((start_y+(((1-delka)-start_y)*sin((x*3.1416))))*equal(smer, 1))+(equal(smer, -1)*2));
