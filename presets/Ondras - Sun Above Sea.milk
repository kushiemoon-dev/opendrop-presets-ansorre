per_frame_14=cx=((q1*below(y, 1.5))+(0.5*above(y, 1.5)));
per_frame_15=cy=(q2*below(y, 1.5));
per_pixel_1=action=below((sqr((x-q1))+sqr((y-q2))), sqr(q3));
per_pixel_2=sx=(1-(0.4*action));
per_pixel_3=sy=sx;
per_pixel_4=warp=above(y, (1-q4));
per_pixel_5=zoom=(1+(above(y, (1-q4))*0.1));
