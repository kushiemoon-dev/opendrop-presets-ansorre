MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
dx=1e-05
dy=1e-05
fDecay=0.97
fGammaAdj=1.0
fModWaveAlphaEnd=1.0
fModWaveAlphaStart=0.5
fWarpScale=100.0
fWaveScale=0.800075
fWaveSmoothing=0.0
ib_size=0.25
mv_a=0.0
mv_l=1.0
nWaveMode=1.0
ob_a=1.0
ob_size=0.0
warp=0.01
wave_b=0.0
wave_g=0.0
wave_r=0.0
fVideoEchoAlpha=0.2
fVideoEchoZoom=1.049963
fWaveAlpha=100.0
fZoomExponent=0.022801
nMotionVectorsX=0.0
nMotionVectorsY=0.0
fWaveParam=-0.4
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_1=wave_b=(wave_b+(0.7*sin(bass)));
per_frame_2=wave_r=(wave_r-(0.8*sin(treb)));
per_frame_3=wave_g=(wave_g+(0.8*sin(mid)));
per_frame_4=zoom=(zoom+0.008);
per_frame_5=ob_size=(ob_size+(0.00*sin((8900*time))));
per_frame_6=zoomexp=(zoomexp+(if(abs(above(bass, 1))>0.00001,0.025,0.099)));
per_frame_7=rot=(rot+(if(abs(above(bass, 1))>0.00001,0.01,-0.01)));
per_frame_8=warp=(warp+(if(abs(above(treb, 1))>0.00001,0.5,-0.5)));
per_frame_9=dy=(dy+(if(abs(above(mid, 1.5))>0.00001,0.01,-0.0025)));
