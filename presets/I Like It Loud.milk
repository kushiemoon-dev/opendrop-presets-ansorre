per_frame_1=warp=0;
per_frame_2=cycle_speed=(max(max(mid_att, bass_att), treb_att)*0.1);
per_frame_3=shift=(if(abs(above(abs(shift), 1000))>0.00001,-1000,(shift+cycle_speed)));
per_frame_4=t1=sin((shift*cycle_speed));
per_frame_5=t2=sin(((shift*0.95)*cycle_speed));
per_frame_6=t3=sin(((shift*0.975)*cycle_speed));
per_frame_7=wave_r=(wave_r+(0.5*t1));
per_frame_8=wave_g=(wave_g+(0.5*t2));
per_frame_9=wave_b=(wave_b+(0.5*t3));
per_frame_10=wave_mystery=t2;
