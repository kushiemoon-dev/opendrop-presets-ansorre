per_frame_12=ob_r=((cos(time)*0.5)+0.5);
per_frame_13=ob_b=0.5;
per_pixel_1=zoom=(if(abs(below(rad, (0.4+q1)))>0.00001,((-rad+0.5)*0.1),zoom));
per_pixel_2=rot=(rot+q1);
per_pixel_3=rot=(if(abs(below(rot, -1.0))>0.00001,-1.0,rot));
per_pixel_4=rot=(if(abs(above(rot, 1.0))>0.00001,1.0,rot));
per_pixel_5=ti=(time*-0.6);
per_pixel_6=rot=(sin(((rad+ti)*6.2832))*0.01);
per_pixel_7=sz=0.4;
per_pixel_8=xsec=(above(x, sz)*below(x, (1-sz)));
per_pixel_9=ysec=(above(y, sz)*below(y, (1-sz)));
per_pixel_10=zoom=(if(abs((xsec+ysec))>0.00001,zoom,0.75));
per_pixel_11=dx=(if(abs((xsec+ysec))>0.00001,dx,0.5));
per_pixel_12=dy=(if(abs((xsec+ysec))>0.00001,dy,0.5));
per_pixel_13=sx=(if(abs((xsec+ysec))>0.00001,(0.9+q3),1));
per_pixel_14=rot=(if(abs((xsec+ysec))>0.00001,rot,(q4*(1-(2*above(x, 0.5))))));
per_pixel_15=zoom=((zoom+0.5)+(0.1*sin(floor((time)/(10)))));
