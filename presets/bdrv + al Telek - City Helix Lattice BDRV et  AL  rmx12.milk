per_frame_1=wave_b=(if(abs(below(treb, 2))>0.00001,1,0));
per_frame_2=decay=(if(abs(equal(((frame)%(20)), 0))>0.00001,0.99,1));
per_frame_3=dx=(if(abs(equal(((frame)%(100)), 0))>0.00001,0.001,0));
per_frame_4=rot=(0.05*cos((time*0.4)));
per_frame_5=wave_x=(((wave_x-0.45)*sin((time*0.4)))+wave_x);
per_frame_6=wave_y=(((wave_y-0.45)*sin((time*0.4)))+wave_y);
per_frame_7=zoom=(1-(cos((time*0.4))*0.05));
