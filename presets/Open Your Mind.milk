MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
ib_a=1.0
ib_b=0.0
ib_g=1.0
ib_r=0.0
ib_size=0.5
ob_a=1.0
ob_g=1.0
ob_r=1.0
ob_size=0.5
wave_g=0.0
wave_r=0.0
bMotionVectorsOn=0.0
shapecode_0_enabled=0.0
shapecode_1_enabled=0.0
shapecode_2_enabled=0.0
shapecode_3_enabled=0.0
per_frame_init_1=progress = 0;
per_frame_1=dx=(dx-0.001);
per_frame_2=dy=(dy-0.001);
per_frame_3=ib_size=(if(abs(below(progress, 0.5))>0.00001,(ib_size-progress),0));
per_frame_4=ob_size=(if(abs(above(progress, 0.5))>0.00001,(ob_size-(progress-0.5)),0.5));
per_frame_5=ib_r=(ib_r+(progress*2));
per_frame_6=ib_g=(ib_g-(progress*2));
per_frame_7=ob_r=(ob_size*2);
per_frame_8=ob_g=(ob_g-(ob_size*2));
