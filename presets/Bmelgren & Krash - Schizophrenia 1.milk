per_pixel_1=centerx=(1+(0.2*(sin((time*0.678))+sin((time*0.987)))));
per_pixel_2=centery=(1+(0.2*(sin((time*0.876))+sin((time*0.789)))));
per_pixel_3=newrad=sqrt((pow((centerx-x), 1)+pow((centery-y), 1)));
per_pixel_4=newang=atan(floor(((centerx-x))/((centery-y))));
per_pixel_5=dy=((newrad*sin((newang*10)))*0.05);
